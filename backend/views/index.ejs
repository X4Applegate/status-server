.maintenance-summary-kicker{font-size:10px;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--orange)}
.maintenance-summary.in-progress .maintenance-summary-kicker{color:var(--blue)}
.maintenance-summary-title{margin-top:3px;color:var(--text-white);font-size:15px;font-weight:700;line-height:1.35}
.maintenance-summary-notes{margin-top:4px;color:var(--text);font-size:12px;line-height:1.5;white-space:pre-wrap}
.maintenance-summary-meta{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:9px;color:var(--text-2);font-size:11px}
.maintenance-summary-link{align-self:center;white-space:nowrap;color:var(--text-hi);font-size:11px;font-weight:700;text-decoration:none;padding:7px 10px;border:1px solid var(--border-hi);border-radius:7px;background:var(--surface)}
.maintenance-summary-link:hover{border-color:var(--orange);color:var(--orange)}

/* Active incident and visitor resource panels keep operational communication
   visible without competing with the primary health summary. */
.incident-summary{
  display:none;
  grid-template-columns:auto minmax(0,1fr) auto;
  align-items:start;
  gap:14px;
  margin:-12px 0 30px;
  padding:17px 18px;
  border:1px solid color-mix(in srgb,var(--red) 34%,var(--border));
  border-left:4px solid var(--red);
  border-radius:10px;
  background:color-mix(in srgb,var(--surface) 92%,var(--red) 8%);
}
.incident-summary.visible{display:grid}
.incident-summary-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;color:var(--red);background:var(--red-soft)}
.incident-summary-kicker{font-size:10px;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--red)}
.incident-summary-title{margin-top:3px;color:var(--text-white);font-size:15px;font-weight:700;line-height:1.35}
.incident-summary-meta{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:8px;color:var(--text-2);font-size:11px}
.incident-summary-link{align-self:center;white-space:nowrap;color:var(--text-hi);font-size:11px;font-weight:700;text-decoration:none;padding:7px 10px;border:1px solid var(--border-hi);border-radius:7px;background:var(--surface)}
.incident-summary-link:hover{border-color:var(--red);color:var(--red)}

.public-resource-center{margin-top:30px;padding:22px;border:1px solid var(--border);border-radius:12px;background:var(--surface);box-shadow:var(--card-shadow)}
.public-resource-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}
.public-resource-title{color:var(--text-white);font-size:16px;font-weight:700;letter-spacing:-.02em}
.public-resource-description{margin-top:4px;color:var(--text-2);font-size:11px;line-height:1.5}
.public-resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.public-resource-link{display:flex;align-items:center;gap:10px;min-height:58px;padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text-hi);font:600 11px var(--sans);text-align:left;text-decoration:none;cursor:pointer}
.public-resource-link:hover{background:var(--surface2);border-color:var(--border-hi)}
.public-resource-link svg{width:17px;height:17px;flex:none;color:var(--blue)}
.public-resource-copy{display:block;min-width:0}.public-resource-name,.public-resource-note{display:block}.public-resource-name{font-weight:700}.public-resource-note{margin-top:2px;color:var(--text-2);font-size:9px;font-weight:500;line-height:1.35}
.enterprise-footer{max-width:1240px;margin:0 auto;padding:24px 30px 30px;border-top:1px solid var(--border);color:var(--text-2);font-size:11px}
.enterprise-footer-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.enterprise-footer-links{display:flex;align-items:center;gap:7px 16px;flex-wrap:wrap}.enterprise-footer a{color:var(--text-2);text-decoration:none}.enterprise-footer a:hover{color:var(--text-hi)}

/* Directory controls use familiar enterprise form patterns. */
.sidebar-header{padding:0 0 15px}
.sidebar-title{font-size:19px;letter-spacing:-.02em}
.sidebar-caption{font-size:11px}
.status-legend{padding:0 0 16px;border-bottom:1px solid var(--border);margin-bottom:20px}
.server-search input{height:38px;border-radius:7px;background:var(--surface);box-shadow:none}
.server-search input:focus{background:var(--surface);box-shadow:0 0 0 3px var(--blue-soft)}
.server-filters{padding:2px;border-radius:7px;background:var(--surface)}
.server-filter{height:32px;border-radius:5px}
.server-filter.active{background:var(--surface2);box-shadow:none}
.server-filter-empty{border-radius:10px;background:var(--surface)}

/* Service areas are flat, clearly labelled component panels. */
.srv-group{
  margin-bottom:18px;
  padding:0;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:12px;
  background:var(--surface)!important;
  box-shadow:var(--card-shadow)!important;
}
.srv-group-head{min-height:48px;padding:12px 16px;border-radius:0;border-bottom:1px solid var(--border)}
.srv-group.collapsed .srv-group-head{border-bottom:0}
.srv-group-head:hover{background:var(--surface2)}
.srv-group-name{font-size:11px;letter-spacing:.075em;color:var(--text-hi)}
.srv-group-count{background:var(--surface2);border-color:var(--border)}
.area-health{border-radius:6px;background:var(--surface2)}
.srv-group-body{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:12px;padding:12px}
.srv-subgroup{padding:0;border:1px solid var(--border);border-radius:9px;overflow:hidden}
.srv-subgroup-head{min-height:40px;margin:0;padding:9px 12px;border:0;border-bottom:1px solid var(--border);border-radius:0;background:var(--surface2)}
.srv-subgroup.collapsed .srv-subgroup-head{border-bottom:0}
.srv-subgroup-body{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));padding:10px}
.srv-row{
  gap:10px;
  padding:14px;
  border-color:var(--border);
  border-radius:9px;
  background:var(--surface)!important;
  box-shadow:none!important;
  transform:none!important;
}
.srv-row::after{display:none!important}
.srv-row:hover{border-color:var(--border-hi);background:var(--surface2)!important;box-shadow:none!important;transform:none!important}
.srv-row.active{border-color:var(--blue);box-shadow:0 0 0 2px var(--blue-soft)!important}
.srv-name{font-size:13px;font-weight:650}
.srv-desc{color:var(--text-2)}
.srv-badge{border:1px solid currentColor;border-radius:5px;background:transparent!important;font-size:8px}
.srv-fact{border-radius:5px;background:var(--surface2)}
.srv-card-section{border-top-color:var(--border)}
.srv-hb-dot{border-radius:1px}
.pin-btn{color:var(--text-2)}
.srv-create-btn{border-radius:9px;background:var(--surface)}

/* Detailed service pages use the same flat panel language. */
.main{max-width:1120px;padding:34px 30px 64px}
.back-btn,.edit-server-btn{border-radius:7px;background:var(--surface)}
.status-big{border-radius:9px;backdrop-filter:none;box-shadow:none!important}
.uptime-card,.section{border-radius:10px;background:var(--surface)!important;box-shadow:var(--card-shadow)!important}
.uptime-card::before{display:none}
.section-head{background:var(--surface2)}
.detail-data-notice{border-radius:9px}
.hb-modal-overlay{backdrop-filter:none}
.hb-modal-box,.welcome-box{border-radius:10px;background:var(--surface);box-shadow:0 16px 36px rgba(0,0,0,.25)}
.hb-modal-head{background:var(--surface2)}

@media(max-width:900px){
  .overview-top{gap:22px}
  .overview-signal{width:100%}
  .overview-metric{padding:10px 14px}
  .overview-metric:nth-child(3){padding-left:0;border-left:0}
  .srv-group-body{grid-template-columns:1fr}
  .public-resource-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:760px){
  .topbar{min-height:60px;padding:8px 12px}
  .layout,.sidebar{min-height:calc(100vh - 60px)}
  .sidebar-scroll{padding:18px 12px 40px}
  .status-overview{padding:20px 17px;margin-bottom:24px;border-radius:10px}
  .maintenance-summary{grid-template-columns:auto minmax(0,1fr);margin:-8px 0 24px;padding:15px 14px}
  .maintenance-summary-link{grid-column:2;justify-self:start}
  .incident-summary{grid-template-columns:auto minmax(0,1fr);margin:-8px 0 24px;padding:15px 14px}
  .incident-summary-link{grid-column:2;justify-self:start}
  .overview-title{font-size:27px}
  .overview-metrics{margin-top:20px;padding-top:14px}
  .overview-metric{padding:9px 10px}
  .srv-group{border-radius:10px}
  .srv-group-head{padding:11px 12px}
  .srv-group-body{padding:9px;gap:9px}
  .srv-row{min-height:0;padding:13px}
  .main{padding:20px 12px 40px}
  .public-resource-center{padding:17px 14px}.enterprise-footer{padding:20px 16px 26px}
}
@media(max-width:520px){
  .topbar-right .theme-toggle{flex:1 1 100%}
  .overview-metrics{grid-template-columns:1fr 1fr}
  .overview-metric{min-width:0}
  .overview-metric:nth-child(odd){padding-left:0;border-left:0}
  .overview-metric-value{font-size:17px}
  .overview-metric-icon{display:none!important}
  .status-legend{gap:9px 12px}
  .srv-card-top{gap:8px}
  .srv-card-actions{align-items:flex-end;flex-direction:column}
  .srv-facts{align-items:stretch}
  .srv-fact{max-width:100%}
  .public-resource-grid{grid-template-columns:1fr}.public-resource-head{display:block}
}
</style>
<% if (typeof customCss !== 'undefined' && customCss) { %><style id="group-custom-css"><%- customCss %></style><% } %>
</head>
<body>

<%- include('partials/topbar-public', {
  adminHref:     adminHref,
  groupName:     groupName,
  groupSubtitle: groupSubtitle,
  logoText:      logoText,
  logoImage:     logoImage,
  groupSlug:     groupSlug
}) %>

<!-- Operator-authored announcement banners (scheduled maintenance, ongoing issues, release notes). -->
<div id="adminBanners" class="admin-banners"></div>
<div class="layout">
  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-scroll" id="sidebarScroll">
      <section class="status-overview checking" id="statusOverview" aria-labelledby="statusHeadline">
        <div class="overview-top">
          <div class="overview-copy">
            <div class="overview-kicker"><span class="overview-live-dot"></span>Live service health</div>
            <h1 class="overview-title" id="statusHeadline">Checking system status</h1>
            <p class="overview-description" id="statusSummaryText">Loading the latest health checks across every monitored service.</p>
            <div class="overview-updated">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              <span id="statusUpdated">Connecting to live updates…</span>
            </div>
          </div>
          <div class="overview-signal" aria-live="polite">
            <div class="overview-signal-icon" id="statusSignalIcon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="overview-signal-copy">
              <div class="overview-signal-label" id="statusSignalLabel">Checking services</div>
              <div class="overview-signal-sub" id="statusSignalSub">Live status feed</div>
            </div>
          </div>
        </div>
        <div class="overview-metrics" aria-label="System status summary">
          <div class="overview-metric">
            <div class="overview-metric-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><line x1="7" y1="7" x2="7.01" y2="7"/><line x1="7" y1="17" x2="7.01" y2="17"/></svg></div>
            <div><div class="overview-metric-value" id="metricTotal">—</div><div class="overview-metric-label">Monitored</div></div>
          </div>
          <div class="overview-metric">
            <div class="overview-metric-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div><div class="overview-metric-value" id="metricOperational">—</div><div class="overview-metric-label">Operational</div></div>
          </div>
          <div class="overview-metric">
            <div class="overview-metric-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <div><div class="overview-metric-value" id="metricIssues">—</div><div class="overview-metric-label">Issues</div></div>
          </div>
          <div class="overview-metric">
            <div class="overview-metric-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></div>
            <div><div class="overview-metric-value" id="metricResponse">—</div><div class="overview-metric-label">Avg response</div></div>
          </div>
        </div>
      </section>
      <section id="incidentSummary" class="incident-summary" aria-live="polite" hidden></section>
      <section id="maintenanceSummary" class="maintenance-summary" aria-live="polite" hidden></section>
      <div class="sidebar-header">
        <div>
          <div class="sidebar-title">Services</div>
          <div class="sidebar-caption" id="serverResultCount">Loading monitored services…</div>
        </div>
        <div class="server-tools">
          <label class="server-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="serverSearch" type="search" placeholder="Search services" autocomplete="off" oninput="applyServerFilters()" aria-label="Search services">
          </label>
          <div class="server-filters" aria-label="Filter services">
            <button class="server-filter active" type="button" data-filter="all" onclick="setStatusFilter('all')">All</button>
            <button class="server-filter" type="button" data-filter="online" onclick="setStatusFilter('online')">Online</button>
            <button class="server-filter" type="button" data-filter="issues" onclick="setStatusFilter('issues')">Issues</button>
          </div>
        </div>
      </div>
      <div class="status-legend" aria-label="Service status key">
        <span class="status-legend-title">Status key</span>
        <span class="status-legend-item"><span class="status-legend-dot up"></span>Operational</span>
        <span class="status-legend-item"><span class="status-legend-dot degraded"></span>Degraded</span>
        <span class="status-legend-item"><span class="status-legend-dot down"></span>Outage</span>
        <span class="status-legend-item"><span class="status-legend-dot pending"></span>Checking</span>
      </div>
      <div class="sidebar-body" id="sidebarList">
        <!-- populated by JS -->
      </div>
      <section class="public-resource-center" id="statusResourceCenter" aria-labelledby="statusResourcesTitle">
        <div class="public-resource-head">
          <div><h2 class="public-resource-title" id="statusResourcesTitle">Status resources</h2><p class="public-resource-description">Follow service updates, review past events, or reach the operator tools.</p></div>
        </div>
        <div class="public-resource-grid">
          <% if (typeof groupSlug !== 'undefined' && groupSlug) { %>
          <a class="public-resource-link" href="/dashboard/<%= groupSlug %>/incidents"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 16 4-5 4 3 4-7"/></svg><span class="public-resource-copy"><span class="public-resource-name">Status history</span><span class="public-resource-note">Incidents and maintenance timeline</span></span></a>
          <button class="public-resource-link" type="button" onclick="openSubscribeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="public-resource-copy"><span class="public-resource-name">Email alerts</span><span class="public-resource-note">Down and recovery notifications</span></span></button>
          <a class="public-resource-link" href="/dashboard/<%= groupSlug %>/feed.rss" type="application/rss+xml"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg><span class="public-resource-copy"><span class="public-resource-name">RSS feed</span><span class="public-resource-note">Subscribe from any feed reader</span></span></a>
          <% } %>
          <a class="public-resource-link" href="<%- adminHref %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .6 2l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-2-.6 1.7 1.7 0 0 0-1.2 1.6v.2h-4v-.2A1.7 1.7 0 0 0 8.8 19a1.7 1.7 0 0 0-2 .6l-.1.1-2.8-2.8.1-.1a1.7 1.7 0 0 0 .6-2A1.7 1.7 0 0 0 3 13.6H3v-4h.2A1.7 1.7 0 0 0 4.8 8a1.7 1.7 0 0 0-.6-2l-.1-.1 2.8-2.8.1.1a1.7 1.7 0 0 0 2 .6A1.7 1.7 0 0 0 10.2 2H14v.2A1.7 1.7 0 0 0 15.2 4a1.7 1.7 0 0 0 2-.6l.1-.1 2.8 2.8-.1.1a1.7 1.7 0 0 0-.6 2 1.7 1.7 0 0 0 1.6 1.2h.2v4H21a1.7 1.7 0 0 0-1.6 1.6z"/></svg><span class="public-resource-copy"><span class="public-resource-name">Operations console</span><span class="public-resource-note">Manage monitoring and communications</span></span></a>
          <a class="public-resource-link" href="https://github.com/X4Applegate/status-server#readme" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span class="public-resource-copy"><span class="public-resource-name">Monitor documentation</span><span class="public-resource-note">Checks, badges, and integrations</span></span></a>
        </div>
      </section>
    </div>
    <button class="sb-scroll-btn sb-scroll-up" id="sbScrollUp" onclick="sbScrollStep(-1)" title="Scroll up">▲</button>
    <button class="sb-scroll-btn sb-scroll-dn" id="sbScrollDn" onclick="sbScrollStep(1)" title="Scroll down">▼</button>
  </div>

  <!-- MAIN -->
  <div class="main" id="mainArea">
    <!-- detail view rendered by JS -->
  </div>
</div>

<div id="mapView" class="map-view">
  <div id="mapMainContainer"></div>
  <div id="mapUnmapped" class="map-unmapped" style="display:none"></div>
</div>

<script>
// -- Group context (injected from server)
const GROUP_SLUG = <%- JSON.stringify(groupSlug) %>;
let   currentGroupId = null; // populated from /api/public/group/:slug response
let   statusFilter = "all";

function syncPageThemeControl() {
  const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
  const nextTheme = theme === "light" ? "dark" : "light";
  const nextLabel = nextTheme === "dark" ? "Dark mode" : "Light mode";
  const button = document.getElementById("themeToggle");
  const label = document.getElementById("themeToggleLabel");
  if (label) label.textContent = nextLabel;
  if (button) {
    button.setAttribute("aria-label", `Switch to ${nextLabel.toLowerCase()}`);
    button.title = `Switch to ${nextLabel.toLowerCase()}`;
  }
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  if (themeMeta) themeMeta.content = theme === "light" ? "#ffffff" : "#0c0d0f";
}

function togglePageTheme() {
  const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
  document.documentElement.dataset.theme = nextTheme;
  try { localStorage.setItem("status-page-theme", nextTheme); } catch (_) { /* non-persistent theme */ }
  syncPageThemeControl();
  if (window.innerWidth <= 1100) {
    const menu = document.getElementById("topbarRight");
    const menuButton = document.getElementById("topbarHamburger");
    if (menu) menu.classList.remove("menu-open");
    if (menuButton) {
      menuButton.classList.remove("open");
      menuButton.setAttribute("aria-label", "Open menu");
      menuButton.setAttribute("aria-expanded", "false");
    }
  }
}

syncPageThemeControl();

// Pinned servers (localStorage)
const PINS_KEY = "sm-pinned-" + (GROUP_SLUG || "_main");
let pinnedServers = new Set(JSON.parse(localStorage.getItem(PINS_KEY) || "[]"));

async function togglePin(id, e) {
  e.stopPropagation();
  if (sidebarSession.loggedIn) {
    // DB-backed for logged-in users
    try {
      const r = await fetch(`/api/pinned/${id}`, { method: "POST" });
      const data = await r.json();
      if (data.pinned) pinnedServers.add(id);
      else pinnedServers.delete(id);
    } catch(err) {
      // Fallback to localStorage on network error
      if (pinnedServers.has(id)) pinnedServers.delete(id);
      else pinnedServers.add(id);
    }
  } else {
    if (pinnedServers.has(id)) pinnedServers.delete(id);
    else pinnedServers.add(id);
  }
  localStorage.setItem(PINS_KEY, JSON.stringify([...pinnedServers]));
  renderSidebar();
}

async function loadDbPins() {
  if (!sidebarSession.loggedIn) return;
  try {
    const r = await fetch("/api/pinned");
    if (r.ok) {
      const ids = await r.json();
      // Merge DB pins with localStorage pins
      ids.forEach(id => pinnedServers.add(id));
      localStorage.setItem(PINS_KEY, JSON.stringify([...pinnedServers]));
    }
  } catch(e) { /* use localStorage only */ }
}

function updateStatusOverview() {
  const overview = document.getElementById("statusOverview");
  if (!overview) return;
  const total = servers.length;
  const up = servers.filter(s => s.overall === "up").length;
  const down = servers.filter(s => s.overall === "down").length;
  const degraded = servers.filter(s => s.overall === "degraded").length;
  const pending = Math.max(0, total - up - down - degraded);
  const issues = down + degraded;
  const responseTimes = servers.flatMap(s => (s.checks || [])
    .map(c => c.response_ms)
    .filter(value => value !== null && value !== undefined && value !== "" && Number.isFinite(Number(value)) && Number(value) >= 0)
    .map(Number));
  const avgResponse = responseTimes.length ? Math.round(responseTimes.reduce((sum, ms) => sum + ms, 0) / responseTimes.length) : null;
  const checkedTimes = servers.map(s => s.lastChecked ? new Date(s.lastChecked).getTime() : 0).filter(Boolean);
  const latestCheck = checkedTimes.length ? new Date(Math.max(...checkedTimes)) : null;

  overview.classList.remove("all-up", "has-issues", "has-outage", "checking");
  const headline = document.getElementById("statusHeadline");
  const summary = document.getElementById("statusSummaryText");
  const signal = document.getElementById("statusSignalLabel");
  const signalSub = document.getElementById("statusSignalSub");
  const signalIcon = document.getElementById("statusSignalIcon");
  const checkIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
  const alertIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;

  if (!total || pending === total) {
    overview.classList.add("checking");
    headline.textContent = total ? "Status checks in progress" : "No services configured yet";
    summary.textContent = total ? `Waiting for the first health result from ${total} monitored service${total === 1 ? "" : "s"}.` : "Add a service to begin tracking availability and response time.";
    signal.textContent = total ? "Checking services" : "Awaiting setup";
    signalSub.textContent = "Live status feed";
    signalIcon.innerHTML = alertIcon;
  } else if (down > 0) {
    overview.classList.add("has-outage");
    headline.textContent = "Some systems are unavailable";
    summary.textContent = `${down} service${down === 1 ? " is" : "s are"} currently down${degraded ? ` and ${degraded} ${degraded === 1 ? "is" : "are"} degraded` : ""}. The latest results appear below.`;
    signal.textContent = "Service disruption";
    signalSub.textContent = `${issues} active issue${issues === 1 ? "" : "s"}`;
    signalIcon.innerHTML = alertIcon;
  } else if (degraded > 0) {
    overview.classList.add("has-issues");
    headline.textContent = "Some systems are degraded";
    summary.textContent = `${degraded} service${degraded === 1 ? " is" : "s are"} experiencing reduced performance. All other monitored services are operational.`;
    signal.textContent = "Degraded performance";
    signalSub.textContent = `${degraded} affected service${degraded === 1 ? "" : "s"}`;
    signalIcon.innerHTML = alertIcon;
  } else if (pending > 0) {
    overview.classList.add("checking");
    headline.textContent = "Status checks in progress";
    summary.textContent = `${up} service${up === 1 ? " is" : "s are"} online while ${pending} health check${pending === 1 ? " is" : "s are"} still pending.`;
    signal.textContent = "Checking services";
    signalSub.textContent = `${pending} result${pending === 1 ? "" : "s"} pending`;
    signalIcon.innerHTML = alertIcon;
  } else {
    overview.classList.add("all-up");
    headline.textContent = "All systems operational";
    summary.textContent = `Every monitored service is responding normally. We are continuously checking ${total} service${total === 1 ? "" : "s"} for availability and performance.`;
    signal.textContent = "Fully operational";
    signalSub.textContent = `${up} of ${total} online`;
    signalIcon.innerHTML = checkIcon;
  }

  document.getElementById("metricTotal").textContent = total;
  document.getElementById("metricOperational").textContent = up;
  document.getElementById("metricIssues").textContent = issues;
  document.getElementById("metricResponse").textContent = avgResponse === null ? "—" : `${avgResponse}ms`;
  document.getElementById("statusUpdated").textContent = latestCheck
    ? `Latest check ${latestCheck.toLocaleString([], { month:"short", day:"numeric", hour:"numeric", minute:"2-digit" })}`
    : "Connecting to live updates…";
}

function setStatusFilter(filter) {
  statusFilter = ["all", "online", "issues"].includes(filter) ? filter : "all";
  document.querySelectorAll(".server-filter").forEach(btn => btn.classList.toggle("active", btn.dataset.filter === statusFilter));
  applyServerFilters();
}

function applyServerFilters() {
  const list = document.getElementById("sidebarList");
  if (!list) return;
  const query = (document.getElementById("serverSearch")?.value || "").trim().toLowerCase();
  const matchingIds = new Set(servers.filter(s => {
    const statusMatch = statusFilter === "all"
      || (statusFilter === "online" && s.overall === "up")
      || (statusFilter === "issues" && (s.overall === "down" || s.overall === "degraded"));
    const publicSearchText = [s.name, s.description, s.category, s.sub_category, ...(s.tags || [])];
    if (sidebarSession.loggedIn) publicSearchText.push(s.host);
    return statusMatch && (!query || publicSearchText.filter(Boolean).join(" ").toLowerCase().includes(query));
  }).map(s => String(s.id)));

  list.querySelectorAll(".srv-row").forEach(row => { row.hidden = !matchingIds.has(row.dataset.serverId); });
  [...list.querySelectorAll(".srv-subgroup")].reverse().forEach(group => {
    group.hidden = !group.querySelector(".srv-row:not([hidden])");
  });
  [...list.querySelectorAll(".srv-group")].reverse().forEach(group => {
    group.hidden = !group.querySelector(".srv-row:not([hidden])");
  });

  let empty = document.getElementById("serverFilterEmpty");
  if (!matchingIds.size && servers.length) {
    if (!empty) {
      empty = document.createElement("div");
      empty.id = "serverFilterEmpty";
      empty.className = "server-filter-empty";
      list.appendChild(empty);
    }
    empty.textContent = query ? `No services match “${query}”.` : "No services match this status filter.";
  } else if (empty) {
    empty.remove();
  }
  const count = document.getElementById("serverResultCount");
  if (count) count.textContent = `${matchingIds.size} of ${servers.length} monitored service${servers.length === 1 ? "" : "s"}`;
}

function updateMapBtnVisibility() {
  const mapBtn = document.getElementById("topbarMapBtn");
  if (mapBtn) mapBtn.style.display = (sidebarSession.loggedIn && servers.some(s => s.lat!=null&&s.lng!=null)) ? "" : "none";
}

// ── Map view (MapLibre GL JS) ─────────────────────────────────────────────────
let _mainMap    = null;
let _mainMarkers = [];
let _mapActive  = false;

// MapLibre GL JS does not support mapbox:// URL schemes used inside Mapbox-hosted
// styles, so we always use a native MapLibre-compatible style.
function _getMapStyle() {
  return "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json";
}

// Load MapLibre GL JS dynamically (CSS already in <head>)
function _loadMapLibre(cb) {
  if (typeof maplibregl !== "undefined") { cb(); return; }
  const s = document.createElement("script");
  s.src = "https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js";
  s.onload = cb;
  document.head.appendChild(s);
}

function toggleMapView() {
  _mapActive = !_mapActive;
  const btn    = document.getElementById("topbarMapBtn");
  const layout = document.querySelector(".layout");
  const mapDiv = document.getElementById("mapView");
  if (_mapActive) {
    if (layout) layout.style.display = "none";
    if (mapDiv) mapDiv.classList.add("active");
    if (btn)   { btn.textContent = "📋 List"; btn.classList.add("active"); }
    if (!_mainMap) _initMainMap();
    else { _renderMainMarkers(); setTimeout(() => _mainMap.resize(), 50); }
  } else {
    if (layout) layout.style.display = "";
    if (mapDiv) mapDiv.classList.remove("active");
    if (btn)   { btn.textContent = "🗺️ Map"; btn.classList.remove("active"); }
  }
}

async function _initMainMap() {
  _loadMapLibre(async () => {
    const style = _getMapStyle();
    _mainMap = new maplibregl.Map({
      container: "mapMainContainer",
      style,
      center: [0, 20],
      zoom: 2,
      validateStyle: false
    });
    _mainMap.addControl(new maplibregl.NavigationControl(), "top-right");
    _mainMap.on("load", () => { _renderMainMarkers(); setTimeout(() => _mainMap.resize(), 50); });
  });
}

function _renderMainMarkers() {
  if (!_mainMap || !_mainMap.isStyleLoaded()) return;
  _mainMarkers.forEach(m => m.remove());
  _mainMarkers = [];
  const colorMap = { up:"#10e88a", down:"#ff3d5a", degraded:"#ff8c2a", pending:"#5e8aad" };
  const colorPri = { up:0, degraded:1, pending:2, down:3 }; // higher = worse, drives cluster color
  const mapped   = servers.filter(s => s.lat != null && s.lng != null);
  const unmapped = servers.filter(s => s.lat == null || s.lng == null);

  // Group servers that share the exact same coordinates into one marker
  const locMap = new Map();
  mapped.forEach(s => {
    const key = `${s.lat},${s.lng}`;
    if (!locMap.has(key)) locMap.set(key, []);
    locMap.get(key).push(s);
  });

  locMap.forEach((group, key) => {
    // Pick the worst status color for the marker dot
    const worst = group.reduce((w, s) => (colorPri[s.overall]||0) > (colorPri[w.overall]||0) ? s : w, group[0]);
    const color = colorMap[worst.overall] || colorMap.pending;

    // Marker element — show a count badge when more than one server
    const el = document.createElement("div");
    el.style.cssText = `width:${group.length>1?22:16}px;height:${group.length>1?22:16}px;border-radius:50%;background:${color};border:2px solid #0d1829;box-shadow:0 0 6px ${color}88;cursor:pointer;display:flex;align-items:center;justify-content:center`;
    if (group.length > 1) {
      el.innerHTML = `<span style="font-size:10px;font-weight:700;color:#0d1829;line-height:1">${group.length}</span>`;
    }

    // Popup HTML — single row per server
    const rows = group.map((s, idx) => {
      const c = colorMap[s.overall] || colorMap.pending;
      const lastMs = (s.checks||[]).reduce((b,ck) => (ck.response_ms&&(b===null||ck.response_ms<b))?ck.response_ms:b, null);
      return `<div style="padding:${idx===0?"2px 0 6px":"6px 0"};${idx>0?"border-top:1px solid #1e2d45":""}">
        <div style="font-weight:600;font-size:13px;color:#ffffff;margin-bottom:3px;line-height:1.3">${s.name}</div>
        <div style="display:flex;align-items:center;gap:10px">
          <span style="color:${c};font-weight:700;font-size:11px;letter-spacing:.04em">${(s.overall||"pending").toUpperCase()}</span>
          ${sidebarSession.loggedIn && s.host ? `<span style="font-size:11px;color:#7a9abf">${s.host}</span>` : ""}
          ${lastMs!=null?`<span style="font-size:11px;color:#7a9abf">${lastMs}ms</span>`:""}
        </div>
      </div>`;
    }).join("");

    const popup = new maplibregl.Popup({ offset: 14, maxWidth:"260px" }).setHTML(
      `<div style="font-family:sans-serif;padding:4px 2px">${rows}</div>`
    );

    const [lat, lng] = key.split(",").map(Number);
    const marker = new maplibregl.Marker({ element: el })
      .setLngLat([lng, lat])
      .setPopup(popup)
      .addTo(_mainMap);
    _mainMarkers.push(marker);
  });
  if (mapped.length > 0) {
    try {
      const bounds = new maplibregl.LngLatBounds();
      mapped.forEach(s => bounds.extend([s.lng, s.lat]));
      _mainMap.fitBounds(bounds, { padding: 60, maxZoom: 14, duration: 500 });
    } catch(e) {}
  }
  const unmappedEl = document.getElementById("mapUnmapped");
  if (unmappedEl) {
    unmappedEl.style.display = unmapped.length ? "" : "none";
    if (unmapped.length) unmappedEl.textContent = `${unmapped.length} server${unmapped.length>1?"s":""} without a location are not shown. Add one in Admin → Edit Server.`;
  }
  const mapBtn = document.getElementById("topbarMapBtn");
  if (mapBtn) mapBtn.style.display = (sidebarSession.loggedIn && servers.some(s => s.lat!=null&&s.lng!=null)) ? "" : "none";
}

