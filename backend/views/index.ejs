// -- Helpers
// Minimal, safe markdown renderer for runbook notes. HTML-escape everything first,
// then selectively un-escape a small set of inline/block patterns. No external libs —
// this is intentionally tiny; if a user wants rich formatting they can structure with
// headings, lists, code, and links.
function escapeHtml(s){
  return String(s||"")
    .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function renderMarkdown(src){
  if (!src) return "";
  let html = escapeHtml(src);
  // Fenced code blocks first so their contents bypass inline rules.
  const codeBlocks = [];
  html = html.replace(/```([\s\S]*?)```/g, (_m, code) => {
    codeBlocks.push(code.replace(/^\n/, ""));
    return `\u0000CODE${codeBlocks.length - 1}\u0000`;
  });
  // Headings — support ## and ###, restricted to line starts.
  html = html.replace(/^### (.+)$/gm, '<h4 class="rb-h">$1</h4>');
  html = html.replace(/^## (.+)$/gm,  '<h3 class="rb-h">$1</h3>');
  html = html.replace(/^# (.+)$/gm,   '<h2 class="rb-h">$1</h2>');
  // Bullet and numbered lists — one pass per kind, merge consecutive lines.
  html = html.replace(/(?:^[-*] .+\n?)+/gm, m =>
    "<ul class='rb-ul'>" + m.trim().split(/\n/).map(l => `<li>${l.replace(/^[-*]\s+/, "")}</li>`).join("") + "</ul>");
  html = html.replace(/(?:^\d+\. .+\n?)+/gm, m =>
    "<ol class='rb-ol'>" + m.trim().split(/\n/).map(l => `<li>${l.replace(/^\d+\.\s+/, "")}</li>`).join("") + "</ol>");
  // Inline code, bold, italic, links. Links are gated to http/https/mailto to block javascript:.
  html = html.replace(/`([^`\n]+)`/g, '<code class="rb-code">$1</code>');
  html = html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, text, url) => {
    const safe = /^(https?:\/\/|mailto:)/i.test(url);
    return safe
      ? `<a href="${url}" target="_blank" rel="noopener noreferrer">${text}</a>`
      : escapeHtml(`[${text}](${url})`);
  });
  // Paragraphs — preserve double-newlines as block separators, single newlines as breaks.
  html = html.split(/\n{2,}/).map(block => {
    if (/^\s*<(h[234]|ul|ol|pre)/.test(block)) return block;
    return `<p>${block.replace(/\n/g, "<br>")}</p>`;
  }).join("");
  // Restore fenced code blocks last so their contents are not touched by inline rules.
  html = html.replace(/\u0000CODE(\d+)\u0000/g, (_m, i) => `<pre class="rb-pre"><code>${escapeHtml(codeBlocks[+i])}</code></pre>`);
  return html;
}

function fmtDur(secs){
  if (!secs) return "ongoing";
  if (secs < 60)   return `${secs}s`;
  if (secs < 3600) return `${Math.floor(secs/60)}m ${secs%60}s`;
  return `${Math.floor(secs/3600)}h ${Math.floor((secs%3600)/60)}m`;
}

function fmtTime(ts){
  return new Date(ts).toLocaleString("en-US",{month:"short",day:"numeric",hour:"2-digit",minute:"2-digit",hour12:false});
}
function fmtTimeFull(ts){
  return new Date(ts).toLocaleString("en-US",{month:"short",day:"numeric",year:"numeric",hour:"numeric",minute:"2-digit",second:"2-digit",hour12:true});
}
function checkWelcome(){
  // Show welcome popup when: logged in, no servers, on master view, not already dismissed
  if (!sidebarSession.loggedIn || GROUP_SLUG || servers.length > 0) return;
  if (sessionStorage.getItem("welcome-dismissed")) return;
  showWelcomePopup();
}
function showWelcomePopup(){
  sessionStorage.setItem("welcome-dismissed", "1");
  const overlay = document.createElement("div");
  overlay.className = "welcome-overlay";
  overlay.innerHTML = `
    <div class="welcome-box">
      <div class="welcome-icon">🖥️</div>
      <div class="welcome-title">Welcome to Applegate Monitor</div>
      <div class="welcome-text">You're all set! Add your first server to start monitoring uptime, response times, and get instant alerts when something goes down.</div>
      <button class="welcome-btn" onclick="this.closest('.welcome-overlay').remove(); window.location.href='/admin'">Add Your First Server</button>
    </div>`;
  overlay.addEventListener("click", e => { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}
function showHbTip(el){
  hideHbTip();
  const rect = el.getBoundingClientRect();
  const tip = document.createElement("div");
  tip.className = "hb-tooltip";
  tip.id = "hbTip";
  tip.innerHTML = `<div class="hb-tooltip-time">${el.dataset.time}</div><div class="hb-tooltip-status">${el.dataset.status}</div>`;
  document.body.appendChild(tip);
  const tipRect = tip.getBoundingClientRect();
  let left = rect.left + rect.width/2 - tipRect.width/2;
  if (left < 4) left = 4;
  if (left + tipRect.width > window.innerWidth - 4) left = window.innerWidth - 4 - tipRect.width;
  tip.style.left = left + "px";
  tip.style.top  = (rect.top - tipRect.height - 10) + "px";
}
function hideHbTip(){
  const t = document.getElementById("hbTip");
  if (t) t.remove();
}
function showHbIncident(el){
  hideHbTip();
  // Remove any existing modal
  const existing = document.getElementById("hbModal");
  if (existing) existing.remove();

  const ts = new Date(el.dataset.ts).getTime();

  // Find all incidents whose window covers this heartbeat tick (±90s tolerance)
  const matches = currentIncidents.filter(i => {
    const start = new Date(i.started_at).getTime() - 90000;
    const end   = i.ended_at ? new Date(i.ended_at).getTime() + 90000 : Date.now();
    return ts >= start && ts <= end;
  });

  let bodyHtml;
  if (matches.length === 0) {
    bodyHtml = `<div class="hb-modal-none">No incident record found for this time window.</div>`;
  } else {
    bodyHtml = `<div class="incident-list">` + matches.map(i => {
      const cause = i.cause || "Service unavailable";
      const timeStr = fmtTime(i.started_at) + (i.ended_at ? " → " + fmtTime(i.ended_at) : "");
      const dur = i.ended_at ? fmtDur(i.duration_s) : '<span style="color:var(--red);font-weight:700">ONGOING</span>';
      return `<div class="incident-row">
        <div class="incident-dot ${i.ended_at?"resolved":""}"></div>
        <div class="incident-info">
          <div class="incident-cause">${cause}</div>
          <div class="incident-time">${timeStr}</div>
        </div>
        <div class="incident-dur ${i.ended_at?"resolved":"open"}">${dur}</div>
      </div>`;
    }).join("") + `</div>`;
  }

  const overlay = document.createElement("div");
  overlay.className = "hb-modal-overlay";
  overlay.id = "hbModal";
  overlay.innerHTML = `
    <div class="hb-modal-box">
      <div class="hb-modal-head">
        <div class="hb-modal-head-dot"></div>
        <div class="hb-modal-title">Incident Detail</div>
        <div class="hb-modal-ts">${el.dataset.time}</div>
        <button class="hb-modal-close" onclick="document.getElementById('hbModal').remove()">✕</button>
      </div>
      <div class="hb-modal-body">${bodyHtml}</div>
    </div>`;
  overlay.addEventListener("click", e => { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}

function annotateServiceAreas(){
  document.querySelectorAll(".srv-group-head, .srv-subgroup-head").forEach(head => {
    const body = head.nextElementSibling;
    if (!body) return;
    const uniqueRows = new Map();
    body.querySelectorAll(".srv-row").forEach(row => uniqueRows.set(row.dataset.serverId, row));
    const rows = [...uniqueRows.values()];
    if (!rows.length) return;

    const totals = { up:0, down:0, degraded:0, pending:0, maintenance:0 };
    rows.forEach(row => {
      const status = row.dataset.status || "pending";
      totals[status] = (totals[status] || 0) + 1;
    });

    let cls = "up";
    let label = "All operational";
    if (totals.down) {
      cls = "down";
      label = `${totals.down} outage${totals.down === 1 ? "" : "s"}`;
    } else if (totals.degraded) {
      cls = "degraded";
      label = `${totals.degraded} degraded`;
    } else if (totals.pending) {
      cls = "pending";
      label = `${totals.pending} checking`;
    } else if (totals.maintenance) {
      cls = "pending";
      label = `${totals.maintenance} maintenance`;
    }

    const count = head.querySelector(".srv-group-count, .srv-subgroup-count");
    if (count) count.textContent = `${rows.length} service${rows.length === 1 ? "" : "s"}`;
    let health = head.querySelector(".area-health");
    if (!health) {
      health = document.createElement("span");
      if (count) count.before(health);
      else head.appendChild(health);
    }
    health.className = `area-health ${cls}`;
    health.innerHTML = `<span class="area-health-dot"></span>${label}`;

    if (head.hasAttribute("onclick")) {
      const section = head.closest(".srv-group, .srv-subgroup");
      head.tabIndex = 0;
      head.setAttribute("role", "button");
      head.setAttribute("aria-expanded", String(!section?.classList.contains("collapsed")));
      head.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          head.click();
        }
      });
    }
  });
}

// -- Sidebar
function renderSidebar(){
  const el   = document.getElementById("sidebarList");
  const down = servers.filter(s => s.overall === "down").length;
  const deg  = servers.filter(s => s.overall === "degraded").length;
  const dot  = document.getElementById("globalDot");
  const lbl  = document.getElementById("globalStatus");

  if (down > 0){
    dot.style.background = "var(--red)";  dot.style.animation="none";
    lbl.textContent = `${down} system${down>1?"s":""} down`;
  } else if (deg > 0){
    dot.style.background = "var(--orange)"; dot.style.animation="none";
    lbl.textContent = `${deg} system${deg>1?"s":""} degraded`;
  } else {
    dot.style.background = "var(--green)"; dot.style.animation="";
    lbl.textContent = "All systems operational";
  }

  // Helper that renders one server card
  const renderRow = (s) => {
    const hb = (s.uptimeHistory || []);
    const pad = Math.max(0, 20 - hb.length);
    const dots = [...Array(pad).fill(null).map(() => `<div class="srv-hb-dot pending"></div>`),
      ...hb.map(ok => `<div class="srv-hb-dot ${ok ? "up" : "down"}"></div>`)
    ].join("");
    const certChk = (s.checks || []).find(c => c.cert && typeof c.cert.days_left === 'number');
    const certDays = certChk ? certChk.cert.days_left : null;
    const certHtml = certDays !== null
      ? `<span class="srv-fact cert ${certDays < 0 ? 'expired' : certDays < 14 ? 'warn' : ''}"><span class="srv-fact-label">SSL</span><span class="srv-fact-value">${certDays < 0 ? 'Expired' : certDays + 'd'}</span></span>`
      : "";
    const isPinned = pinnedServers.has(s.id);
    const latestMs = (s.checks||[]).reduce((best,c) => {
      const raw = c.response_ms;
      const ms = raw === null || raw === undefined || raw === "" ? null : Number(raw);
      return ms !== null && Number.isFinite(ms) && (best === null || ms < best) ? ms : best;
    }, null);
    const msHtml   = latestMs !== null
      ? `<span class="srv-fact response ${latestMs<150?"fast":latestMs<400?"ok":"slow"}"><span class="srv-fact-label">Response</span><span class="srv-fact-value">${latestMs}ms</span></span>`
      : "";
    const badgeCls  = s.maintenance ? "pending" : (s.overall || "pending");
    const statusLabels = { up:"Operational", down:"Outage", degraded:"Degraded", pending:"Checking" };
    const badgeText = s.maintenance ? "Maintenance" : (statusLabels[s.overall] || "Checking");
    const maintTag  = s.maintenance ? ` <span title="Scheduled maintenance — alerts suppressed" aria-label="Scheduled maintenance">🔧</span>` : "";
    const hostHtml = sidebarSession.loggedIn && s.host
      ? `<span class="srv-fact"><span class="srv-fact-label">Host</span><span class="srv-fact-value">${s.host}</span></span>`
      : "";
    const recentCount = Math.min(20, hb.length);
    return `
    <div class="srv-row ${s.id===selectedId?"active":""}" data-server-id="${s.id}" data-status="${s.maintenance?'maintenance':(s.overall||'pending')}" role="button" tabindex="0" onclick="selectServer('${s.id}')" onkeydown="if(event.target===this&&(event.key==='Enter'||event.key===' ')){event.preventDefault();selectServer('${s.id}')}" aria-label="View ${escapeHtml(s.name)} status details">
      <div class="srv-card-top">
        <div class="srv-identity">
          <div class="srv-dot ${s.overall||'pending'}"></div>
          <div class="srv-identity-copy">
            <div class="srv-name">${s.name}${maintTag}</div>
            ${s.description ? `<div class="srv-desc">${s.description}</div>` : ""}
          </div>
        </div>
        <div class="srv-card-actions">
          <div class="srv-badge ${badgeCls}">${badgeText}</div>
          <button class="pin-btn ${isPinned ? 'pinned' : ''}" onclick="togglePin('${s.id}',event)" title="${isPinned ? 'Unpin' : 'Pin to top'}" aria-label="${isPinned ? 'Unpin' : 'Pin'} ${escapeHtml(s.name)}">${isPinned ? '&#9733;' : '&#9734;'}</button>
        </div>
      </div>
      <div class="srv-facts">${hostHtml}${msHtml}${certHtml}</div>
      <div class="srv-sparkline-wrap">
        <div class="srv-card-section-head"><span>24-hour response</span><span>Latency trend</span></div>
        <canvas class="srv-sparkline" id="spark-${s.id}" width="200" height="20" title="24-hour response-time trend"></canvas>
      </div>
      <div class="srv-card-section">
        <div class="srv-card-section-head"><span>Recent checks</span><span>${recentCount} of 20 probes</span></div>
        <div class="srv-hb-bar" aria-hidden="true">${dots}</div>
      </div>
    </div>`;
  };

  // Build pinned section HTML (used in both branches below)
  const _pinned = servers.filter(s => pinnedServers.has(s.id));
  let _pinnedHtml = "";
  if (_pinned.length) {
    _pinnedHtml = `<div class="srv-group">
      <div class="srv-group-head" style="color:var(--orange);border-color:rgba(255,140,42,0.2)">
        <span class="srv-group-dot" style="background:var(--orange)"></span>
        <span class="srv-group-name">&#9733; Pinned</span>
        <span class="srv-group-count">${_pinned.length}</span>
      </div>
      <div class="srv-group-body">${_pinned.map(renderRow).join("")}</div>
    </div>`;
  }

  // On public dashboard pages OR when we don't have groups loaded yet
  if (GROUP_SLUG || !dashboardGroups.length) {
    // If any servers have a category, render grouped sections; otherwise flat list.
    const hasCategories = servers.some(s => (s.category || "").trim());
    if (hasCategories) {
      // Preserve insertion order of categories as they appear in the server list.
      const catOrder = [];
      const byCat = {};
      for (const s of servers) {
        const cat = (s.category || "").trim() || "Other";
        if (!byCat[cat]) { byCat[cat] = { order: [], bySubCat: {} }; catOrder.push(cat); }
        const subCat = (s.sub_category || "").trim();
        const key = subCat || "\0";
        if (!byCat[cat].bySubCat[key]) { byCat[cat].bySubCat[key] = []; byCat[cat].order.push(key); }
        byCat[cat].bySubCat[key].push(s);
      }
      el.innerHTML = _pinnedHtml + catOrder.map(cat => {
        const { order: subOrder, bySubCat } = byCat[cat];
        const allItems = subOrder.flatMap(k => bySubCat[k]);
        const downCount = allItems.filter(s => s.overall === "down").length;
        const degCount  = allItems.filter(s => s.overall === "degraded").length;
        const dotColor  = downCount > 0 ? "var(--red)" : degCount > 0 ? "var(--orange)" : "var(--green)";
        // Check if any server in this section actually has a sub_category
        const hasSubCats = subOrder.some(k => k !== "\0");
        const namedSubCount = subOrder.filter(k => k !== "\0").length;
        const useSubCols = namedSubCount >= 5;
        let bodyHtml;
        if (hasSubCats) {
          // Render sub-groups; servers with no sub_category go under an implicit unsorted block
          const subHtml = subOrder.map(key => {
            const items = bySubCat[key];
            const subDown = items.filter(s => s.overall === "down").length;
            const subDeg  = items.filter(s => s.overall === "degraded").length;
            const barColor = subDown > 0 ? "var(--red)" : subDeg > 0 ? "var(--orange)" : "var(--green)";
            const subId = "sub-" + cat.replace(/\W/g,"_") + "-" + key.replace(/\W/g,"_");
            const isCollapsed = collapsedGroups.has(subId);
            if (key === "\0") {
              // No sub_category — render inline without a sub-heading
              return items.map(renderRow).join("");
            }
            return `
              <div class="srv-subgroup ${isCollapsed ? 'collapsed' : ''}">
                <div class="srv-subgroup-head" onclick="toggleGroup('${subId}')">
                  <span class="srv-subgroup-bar" style="background:${barColor}"></span>
                  <span class="srv-subgroup-name">${key}</span>
                  <span class="srv-subgroup-count">${items.length}</span>
                  <span class="srv-subgroup-chevron"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                </div>
                <div class="srv-subgroup-body">${items.map(renderRow).join("")}</div>
              </div>`;
          }).join("");
          bodyHtml = subHtml;
        } else {
          bodyHtml = allItems.map(renderRow).join("");
        }
        const catId = "cat-" + cat.replace(/\W/g,"_");
        const isCollapsed = collapsedGroups.has(catId);
        return `
          <div class="srv-group ${isCollapsed ? 'collapsed' : ''}">
            <div class="srv-group-head" onclick="toggleGroup('${catId}')">
              <span class="srv-group-dot" style="background:${dotColor}"></span>
              <span class="srv-group-name">${cat}</span>
              <span class="srv-group-count">${allItems.length}</span>
              <span class="srv-group-chevron"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            </div>
            <div class="srv-group-body${useSubCols ? ' sub-cols' : ''}">${bodyHtml}</div>
          </div>`;
      }).join("");
    } else {
      el.innerHTML = _pinnedHtml + servers.map(renderRow).join("");
    }
    updateStatusOverview();
    updateMapBtnVisibility();
    annotateServiceAreas();
    applyServerFilters();
    requestAnimationFrame(() => refreshSparklines());
    return;
  }

  // Helper: render items with optional category → sub_category nesting.
  // groupKeyPrefix is used to generate stable collapse IDs (e.g. "g42", "ungrouped").
  function renderBodyWithSections(items, groupKeyPrefix) {
    const hasCats = items.some(s => (s.category || "").trim());
    if (!hasCats) return items.map(renderRow).join("");

    const catOrder = [];
    const byCat = {};
    for (const s of items) {
      const cat = (s.category || "").trim() || "Other";
      if (!byCat[cat]) { byCat[cat] = { order: [], bySubCat: {} }; catOrder.push(cat); }
      const subCat = (s.sub_category || "").trim();
      const key = subCat || "\0";
      if (!byCat[cat].bySubCat[key]) { byCat[cat].bySubCat[key] = []; byCat[cat].order.push(key); }
      byCat[cat].bySubCat[key].push(s);
    }

    return catOrder.map(cat => {
      const { order: subOrder, bySubCat } = byCat[cat];
      const allItems = subOrder.flatMap(k => bySubCat[k]);
      const downC = allItems.filter(s => s.overall === "down").length;
      const degC  = allItems.filter(s => s.overall === "degraded").length;
      const dotC  = downC > 0 ? "var(--red)" : degC > 0 ? "var(--orange)" : "var(--green)";
      const hasSubCats = subOrder.some(k => k !== "\0");
      const namedSubCnt = subOrder.filter(k => k !== "\0").length;
      const useSC = namedSubCnt >= 5;
      let bodyHtml;
      if (hasSubCats) {
        const subHtml2 = subOrder.map(key => {
          const sitems = bySubCat[key];
          const subDown = sitems.filter(s => s.overall === "down").length;
          const subDeg  = sitems.filter(s => s.overall === "degraded").length;
          const barColor = subDown > 0 ? "var(--red)" : subDeg > 0 ? "var(--orange)" : "var(--green)";
          if (key === "\0") return sitems.map(renderRow).join("");
          const subId = groupKeyPrefix + "-cat-" + cat.replace(/\W/g,"_") + "-sub-" + key.replace(/\W/g,"_");
          const isC = collapsedGroups.has(subId);
          return `
            <div class="srv-subgroup ${isC ? 'collapsed' : ''}">
              <div class="srv-subgroup-head" onclick="toggleGroup('${subId}')">
                <span class="srv-subgroup-bar" style="background:${barColor}"></span>
                <span class="srv-subgroup-name">${key}</span>
                <span class="srv-subgroup-count">${sitems.length}</span>
                <span class="srv-subgroup-chevron"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
              </div>
              <div class="srv-subgroup-body">${sitems.map(renderRow).join("")}</div>
            </div>`;
        }).join("");
        bodyHtml = subHtml2;
      } else {
        bodyHtml = allItems.map(renderRow).join("");
      }
      const catId = groupKeyPrefix + "-cat-" + cat.replace(/\W/g,"_");
      const isCatC = collapsedGroups.has(catId);
      return `
        <div class="srv-subgroup ${isCatC ? 'collapsed' : ''}">
          <div class="srv-subgroup-head" onclick="toggleGroup('${catId}')">
            <span class="srv-subgroup-bar" style="background:${dotC}"></span>
            <span class="srv-subgroup-name">${cat}</span>
            <span class="srv-subgroup-count">${allItems.length}</span>
            <span class="srv-subgroup-chevron"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
          </div>
          <div class="srv-subgroup-body${useSC ? ' sub-cols' : ''}">${bodyHtml}</div>
        </div>`;
    }).join("");
  }

  // Master view → group servers by their dashboard group(s).
  // Servers in multiple groups show under each one; servers with no groups go to "Ungrouped".
  const sections = [];

  // Optional admin shortcut: + New Dashboard
  if (sidebarSession.role === "admin") {
    sections.push(`<a class="srv-create-btn" href="/admin?newGroup=1">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Dashboard
    </a>`);
  }

  for (const g of dashboardGroups) {
    const groupServers = servers.filter(s => (s.group_ids || []).includes(g.id));
    if (!groupServers.length) continue;
    const downCount = groupServers.filter(s => s.overall === "down").length;
    const degCount  = groupServers.filter(s => s.overall === "degraded").length;
    const dotColor  = downCount > 0 ? "var(--red)" : degCount > 0 ? "var(--orange)" : (g.accent_color || "var(--blue)");
    const isCollapsed = collapsedGroups.has("g" + g.id);
    const gCats = new Set(groupServers.map(s => (s.category || "").trim()).filter(Boolean));
    const gSubCols = gCats.size >= 5 ? ' sub-cols' : '';
    sections.push(`
      <div class="srv-group ${isCollapsed ? 'collapsed' : ''}">
        <div class="srv-group-head" onclick="toggleGroup('g${g.id}')">
          <span class="srv-group-dot" style="background:${dotColor}"></span>
          <span class="srv-group-name">${g.name}</span>
          <span class="srv-group-count">${groupServers.length}</span>
          <span class="srv-group-chevron"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
        </div>
        <div class="srv-group-body${gSubCols}">${renderBodyWithSections(groupServers, "g" + g.id)}</div>
      </div>`);
  }

  // Ungrouped section — servers not in any dashboard (admin-only infrastructure)
  const ungrouped = servers.filter(s => !(s.group_ids || []).length);
  if (ungrouped.length) {
    const downU = ungrouped.filter(s => s.overall === "down").length;
    const degU  = ungrouped.filter(s => s.overall === "degraded").length;
    const dotU  = downU > 0 ? "var(--red)" : degU > 0 ? "var(--orange)" : "var(--text-2)";
    const isCollapsedU = collapsedGroups.has("ungrouped");
    const uCats = new Set(ungrouped.map(s => (s.category || "").trim()).filter(Boolean));
    const uSubCols = uCats.size >= 5 ? ' sub-cols' : '';
    sections.push(`
      <div class="srv-group ${isCollapsedU ? 'collapsed' : ''}">
        <div class="srv-group-head" onclick="toggleGroup('ungrouped')">
          <span class="srv-group-dot" style="background:${dotU}"></span>
          <span class="srv-group-name">Ungrouped</span>
          <span class="srv-group-count">${ungrouped.length}</span>
          <span class="srv-group-chevron"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
        </div>
        <div class="srv-group-body${uSubCols}">${renderBodyWithSections(ungrouped, "ungrouped")}</div>
      </div>`);
  }

  if (_pinnedHtml) sections.unshift(_pinnedHtml);
  el.innerHTML = sections.join("");
  updateStatusOverview();
  updateMapBtnVisibility();
  annotateServiceAreas();
  applyServerFilters();
  requestAnimationFrame(() => refreshSparklines());
}

// -- Select server
// -- localStorage cache helpers (stale-while-revalidate)
const CACHE_PREFIX = "sm-cache-";
function cacheGet(key){
  try { const v = localStorage.getItem(CACHE_PREFIX + key); return v ? JSON.parse(v) : null; }
  catch(e){ return null; }
}
function cacheSet(key, val){
  try { localStorage.setItem(CACHE_PREFIX + key, JSON.stringify(val)); } catch(e){}
}
function cacheRemove(key){
  try { localStorage.removeItem(CACHE_PREFIX + key); } catch(e){}
}

const DETAIL_REQUEST_TIMEOUT_MS = 10000;

function normalizeDetailPayload(payload){
  const uptime = payload && payload.uptime && typeof payload.uptime === "object" && !Array.isArray(payload.uptime)
    ? payload.uptime
    : { h24:null, d7:null, d30:null };
  const percentOrNull = value => value !== null && value !== undefined && value !== "" && Number.isFinite(Number(value))
    ? Number(value)
    : null;
  return {
    uptime: {
      h24: percentOrNull(uptime.h24),
      d7: percentOrNull(uptime.d7),
      d30: percentOrNull(uptime.d30)
    },
    heartbeat: Array.isArray(payload && payload.heartbeat) ? payload.heartbeat.filter(item => item && typeof item === "object") : [],
    incidents: Array.isArray(payload && payload.incidents) ? payload.incidents.filter(item => item && typeof item === "object") : [],
    responseSeries: Array.isArray(payload && payload.responseSeries)
      ? payload.responseSeries.filter(item => item && typeof item === "object" && item.avg_ms !== null && item.avg_ms !== undefined && Number.isFinite(Number(item.avg_ms)))
      : []
  };
}

async function fetchDetailEndpoint(url, expectedType){
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), DETAIL_REQUEST_TIMEOUT_MS);
  try {
    const response = await fetch(url, { cache:"no-store", signal:controller.signal });
    if (!response.ok) throw new Error(`Request failed (${response.status})`);
    const data = await response.json();
    const valid = expectedType === "array"
      ? Array.isArray(data)
      : data && typeof data === "object" && !Array.isArray(data) && !data.error;
    if (!valid) throw new Error("Unexpected response from server");
    return { data, error:null };
  } catch(error) {
    const message = error && error.name === "AbortError"
      ? "Request timed out"
      : (error && error.message) || "Request failed";
    return { data:expectedType === "array" ? [] : {}, error:message };
  } finally {
    clearTimeout(timer);
  }
}

function showServerList(){
  selectedId = null;
  document.querySelector(".layout").classList.remove("detail-open");
}

async function selectServer(id){
  selectedId = id;
  cacheSet(CACHE_KEY_SELECTED, id);
  document.querySelector(".layout").classList.add("detail-open");
  document.getElementById("mainArea").scrollTop = 0;
  const server = servers.find(s => s.id === id);
  if (!server) return;

  // 1) Render from cache instantly if available, otherwise show skeleton
  const cacheKey = "detail-" + id;
  const cached = cacheGet(cacheKey);
  // Use requestAnimationFrame to ensure layout is painted before rendering detail
  // (the main area transitions from display:none to display:block)
  await new Promise(r => requestAnimationFrame(r));
  let renderedFromCache = false;
  if (cached) {
    try {
      const normalized = normalizeDetailPayload(cached);
      renderDetail(server, normalized.uptime, normalized.heartbeat, normalized.incidents, normalized.responseSeries);
      renderedFromCache = true;
    } catch(error) {
      cacheRemove(cacheKey);
    }
  }
  if (!renderedFromCache) renderDetailSkeleton(server);

  // 2) Fetch fresh data in parallel and update when ready
  const [uptimeResult, heartbeatResult, incidentsResult, responseResult] = await Promise.all([
    fetchDetailEndpoint(`/api/public/uptime/${id}`, "object"),
    fetchDetailEndpoint(`/api/public/heartbeat/${id}`, "array"),
    fetchDetailEndpoint(`/api/public/incidents/${id}`, "array"),
    fetchDetailEndpoint(`/api/public/response/${id}`, "array"),
  ]);

  // Avoid clobbering newer selection
  if (selectedId !== id) return;
  const detail = normalizeDetailPayload({
    uptime: uptimeResult.data,
    heartbeat: heartbeatResult.data,
    incidents: incidentsResult.data,
    responseSeries: responseResult.data
  });
  const errors = [uptimeResult.error, heartbeatResult.error, incidentsResult.error, responseResult.error].filter(Boolean);
  renderDetail(server, detail.uptime, detail.heartbeat, detail.incidents, detail.responseSeries, errors);
  if (!errors.length) cacheSet(cacheKey, detail);
}

function retryServerDetail(){
  if (selectedId) selectServer(selectedId);
}

// -- Skeleton while loading
function renderDetailSkeleton(s){
