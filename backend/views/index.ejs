// Color helpers (used to derive readable text + shaded surfaces from a custom bg)
function _hexParse(hex) {
  let h = String(hex||"").replace("#","");
  if (h.length === 3) h = h.split("").map(c => c+c).join("");
  if (h.length !== 6) return null;
  return {
    r: parseInt(h.substring(0,2), 16),
    g: parseInt(h.substring(2,4), 16),
    b: parseInt(h.substring(4,6), 16)
  };
}
function _hexToRgba(hex, a) {
  const c = _hexParse(hex) || {r:42,g:127,b:255};
  return `rgba(${c.r},${c.g},${c.b},${a})`;
}
// W3C-style relative luminance (0=dark, 1=light)
function _luminance(hex) {
  const c = _hexParse(hex);
  if (!c) return 0;
  const channel = (v) => {
    v /= 255;
    return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
  };
  return 0.2126*channel(c.r) + 0.7152*channel(c.g) + 0.0722*channel(c.b);
}
// Shift each channel toward white (positive amount) or black (negative amount). 0 = unchanged.
function _shade(hex, amount) {
  const c = _hexParse(hex);
  if (!c) return hex;
  const adj = (v) => Math.max(0, Math.min(255, Math.round(amount > 0 ? v + (255 - v) * amount : v * (1 + amount))));
  const toHex = (v) => v.toString(16).padStart(2, "0");
  return `#${toHex(adj(c.r))}${toHex(adj(c.g))}${toHex(adj(c.b))}`;
}
%>
<style>:root{
  --blue: <%= accentColor %>;
  --blue-soft: <%= _hexToRgba(accentColor, 0.12) %>;
  --blue-glow: <%= _hexToRgba(accentColor, 0.25) %>;
}</style>

<% if (bgColor) {
  // Custom background mode: derive shades + pick a readable text palette by luminance
  const lum         = _luminance(bgColor);
  const isDarkBg    = lum < 0.5;
  // Lighter backgrounds get progressively darker shades for surface contrast; darker backgrounds get lighter ones
  const shadeStep   = isDarkBg ? 0.12 : -0.06;
  const bg          = bgColor;
  const bg2         = _shade(bgColor, shadeStep * 1.0);
  const sidebar     = _shade(bgColor, shadeStep * 1.5);
  const surface     = _shade(bgColor, shadeStep * 2.0);
  const surface2    = _shade(bgColor, shadeStep * 2.8);
  const surface3    = _shade(bgColor, shadeStep * 3.5);
  // Text + border palettes — picked by luminance, NOT by the user's default_theme
  const text        = isDarkBg ? "#c8d6e8" : "#3a4658";
  const text2       = isDarkBg ? "rgba(255,255,255,0.55)" : "rgba(20,30,45,0.55)";
  const textHi      = isDarkBg ? "#ffffff" : "#1a2535";
  const textWhite   = isDarkBg ? "#ffffff" : "#0f1720";
  const border      = isDarkBg ? "rgba(255,255,255,0.12)" : "rgba(20,30,45,0.12)";
  const borderHi    = isDarkBg ? "rgba(255,255,255,0.22)" : "rgba(20,30,45,0.22)";
%>
<style id="custom-bg-overrides">
/* The class + attribute selector intentionally outranks the later
   html[data-theme] enterprise defaults, including their !important values. */
html.has-custom-background[data-theme] {
  --bg:        <%= bg %> !important;
  --bg2:       <%= bg2 %> !important;
  --sidebar:   <%= sidebar %> !important;
  --surface:   <%= surface %> !important;
