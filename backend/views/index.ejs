    <button class="back-btn" onclick="showServerList()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>All Servers</button>
    <div class="detail-header">
      <div>
        <div class="detail-name">${s.name}</div>
        ${sidebarSession.loggedIn ? `<div class="detail-host">${s.host}</div>` : ""}
      </div>
    </div>
    <div class="uptime-row">
      ${["24h","7d","30d"].map(l=>`<div class="uptime-card"><div class="uptime-label">${l}</div><div class="skeleton" style="height:32px;width:80px;margin:0 auto"></div></div>`).join("")}
    </div>
    <div class="section"><div class="section-head"><div class="section-title">Heartbeat</div></div><div class="section-body"><div class="skeleton" style="height:28px"></div></div></div>
