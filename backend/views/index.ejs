<!DOCTYPE html>
<html lang="en" data-theme="<%= defaultTheme === 'light' ? 'light' : 'dark' %>"<%- bgColor ? ' class="has-custom-background"' : '' %>>
<head>
<%- include('partials/head', { title: pageTitle }) %>
<script>
(function () {
  try {
    const savedTheme = localStorage.getItem("status-page-theme");
    const configuredTheme = <%- JSON.stringify(defaultTheme === "light" ? "light" : "dark") %>;
    const hasSavedTheme = savedTheme === "light" || savedTheme === "dark";
    document.documentElement.dataset.theme = hasSavedTheme ? savedTheme : configuredTheme;
    // Seed the shared preference from this status page's configured theme so
    // admin and history use the same appearance on first navigation.
    if (!hasSavedTheme) localStorage.setItem("status-page-theme", configuredTheme);
  } catch (_) { /* use the server-configured theme */ }
})();
</script>
<% if (groupSlug) { %>
<link rel="manifest" href="/dashboard/<%= groupSlug %>/manifest.json">
<link rel="alternate" type="application/rss+xml" title="<%= groupName %> status updates" href="/dashboard/<%= groupSlug %>/feed.rss">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="<%= groupName %>">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="/api/icon/<%= groupSlug %>">
<meta name="theme-color" content="<%= accentColor || '#2a7fff' %>">
<% } %>
<link href="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:       #0c0d0f;
  --bg2:      #0c0d0f;
  --sidebar:  #0c0d0f;
  --surface:  #141518;
  --surface2: #1b1d21;
  --border:   #2a2d32;
  --border-hi:#3b3f46;
  --text:     #c1c5cc;
  --text-2:   #9298a1;
  --text-hi:  #e5e7eb;
  --text-white:#f7f7f8;
  --blue:     #2a7fff;
  --blue-soft:rgba(42,127,255,0.12);
  --blue-glow:rgba(42,127,255,0.2);
  --orange:   #fdb022;
  --orange-soft:rgba(253,176,34,0.12);
  --orange-glow:rgba(253,176,34,0.2);
  --green:    #47cd89;
  --green-soft:rgba(71,205,137,0.12);
  --red:      #f97066;
  --red-soft: rgba(249,112,102,0.12);
  --mono:     'JetBrains Mono',monospace;
  --sans:     'Inter',sans-serif;
}
body{font-family:var(--sans);background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;font-size:14px;-webkit-font-smoothing:antialiased;overflow-x:hidden}

/* bg glow */
body::before{content:'';position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 50% at 20% 50%,rgba(42,127,255,0.05) 0%,transparent 70%),radial-gradient(ellipse 40% 40% at 80% 20%,rgba(255,140,42,0.04) 0%,transparent 60%);z-index:0}

/* -- TOP BAR -- */
.topbar{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:10px 28px;min-height:64px;flex-wrap:wrap;gap:12px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,var(--sidebar) 0%,var(--bg2) 100%);backdrop-filter:blur(12px)}
.topbar-brand{display:flex;align-items:center;gap:12px}
.topbar-icon{width:42px;height:42px;border-radius:10px;background:var(--blue-soft);border:1px solid rgba(42,127,255,0.25);display:flex;align-items:center;justify-content:center;font-size:14px;overflow:hidden}
.topbar-logo-img{width:38px;height:38px;border-radius:8px;object-fit:contain;display:block}
.topbar-icon-text{font-weight:700;font-size:18px;color:var(--blue);font-family:var(--sans);letter-spacing:-.02em}
.topbar-name{font-size:15px;font-weight:700;color:var(--text-white);letter-spacing:-.02em}
.topbar-name span{color:var(--blue)}
.topbar-right{display:flex;align-items:center;gap:14px;font-size:12px;color:var(--text-2)}
.topbar-hamburger{display:none;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;border:1px solid var(--border-hi);background:var(--surface);color:var(--text-hi);cursor:pointer;flex-shrink:0;transition:all .15s}
.topbar-hamburger:hover,.topbar-hamburger.open{background:var(--blue-soft);border-color:var(--blue);color:var(--blue)}
@media(max-width:1100px){
  .topbar-hamburger{display:inline-flex}
  .topbar-right{position:absolute;top:calc(100% + 6px);right:10px;min-width:220px;max-width:92vw;background:var(--surface2);border:1px solid var(--border-hi);border-radius:12px;padding:10px;gap:8px;z-index:550;box-shadow:0 8px 32px rgba(0,0,0,.5);flex-wrap:wrap;justify-content:flex-end;visibility:hidden;opacity:0;pointer-events:none;transition:opacity .15s}
  .topbar-right.menu-open{visibility:visible;opacity:1;pointer-events:auto}
}
.topbar-status{display:flex;align-items:center;gap:6px}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(16,232,138,0.4)}50%{box-shadow:0 0 0 5px transparent}}
.topbar-clock{font-family:var(--mono);font-size:12px;color:var(--text-2)}
.topbar-admin{padding:5px 12px;border:1px solid var(--border-hi);border-radius:6px;color:var(--text-hi);font-size:12px;font-weight:500;text-decoration:none;transition:all .15s}
.topbar-admin:hover{background:var(--blue-soft);border-color:var(--blue);color:var(--blue)}
.topbar-login{padding:5px 12px;border:1px solid var(--blue);border-radius:6px;color:var(--blue);background:var(--blue-soft);font-size:12px;font-weight:500;text-decoration:none;cursor:pointer;transition:all .15s;white-space:nowrap}
.topbar-login:hover{background:var(--blue);color:#fff}
.topbar-user{display:flex;align-items:center;gap:8px}
.topbar-username{font-size:12px;color:var(--text-2);font-weight:500}
.topbar-logout{padding:5px 10px;border:1px solid var(--border-hi);border-radius:6px;color:var(--text-2);background:transparent;font-size:12px;font-weight:500;cursor:pointer;transition:all .15s;white-space:nowrap}
.topbar-logout:hover{border-color:var(--red);color:var(--red);background:var(--red-soft)}

/* Dashboard quick-nav pills in the topbar — center-aligned, fills the gap between brand and topbar-right */
.topbar-dashboards{display:flex;align-items:center;justify-content:center;gap:6px;flex:1 1 auto;flex-wrap:nowrap;margin:0 16px;min-width:0;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}
.topbar-dashboards::-webkit-scrollbar{display:none}
.topbar-dash-menu{display:none;position:relative;margin:0 12px;flex-shrink:0}
.topbar-dash-btn{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;border:1px solid var(--border);background:var(--surface);color:var(--text-hi);cursor:pointer;font-family:var(--sans);font-size:11px;font-weight:500;white-space:nowrap;transition:all .15s}
.topbar-dash-btn:hover,.topbar-dash-btn.open{border-color:var(--blue);background:var(--blue-soft);color:var(--blue)}
.topbar-dash-btn svg{transition:transform .2s}
.topbar-dash-btn.open svg{transform:rotate(180deg)}
.topbar-dash-popup{position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%);min-width:220px;background:var(--surface2);border:1px solid var(--border-hi);border-radius:12px;padding:5px;z-index:600;display:none;flex-direction:column;gap:2px;box-shadow:0 8px 32px rgba(0,0,0,.5)}
.topbar-dash-popup.open{display:flex}
.topbar-dash-popup .dash-nav{border-radius:8px;justify-content:flex-start;width:100%;box-sizing:border-box}
@media(max-width:1100px){
  .topbar-dashboards{display:none}
  .topbar-dash-menu{display:none}
}
.dash-nav{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;border:1px solid var(--border);border-radius:20px;color:var(--text-hi);font-size:11px;font-weight:500;text-decoration:none;background:var(--surface);white-space:nowrap;transition:all .15s;cursor:pointer}
.dash-nav:hover{border-color:var(--blue);background:var(--blue-soft);color:var(--blue)}
.dash-nav.active{border-color:var(--blue);background:var(--blue-soft);color:var(--blue)}
.dash-nav-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dash-nav-admin{border-color:var(--border-hi);color:var(--text-hi);background:transparent}
.dash-nav-admin:hover{border-color:var(--orange);background:var(--orange-soft);color:var(--orange)}

/* -- LAYOUT -- */
.layout{position:relative;z-index:1;flex:1;overflow:hidden;min-height:calc(100vh - 64px)}

/* -- SERVER LIST (full-screen grid) -- */
.sidebar{width:100%;height:100%;background:var(--bg);position:relative;overflow:hidden}
.sidebar-scroll{width:100%;height:100%;overflow-y:auto;overflow-x:hidden;padding:16px 20px}
.sidebar-scroll::-webkit-scrollbar{width:4px}
.sidebar-scroll::-webkit-scrollbar-thumb{background:var(--surface2);border-radius:2px}
.sb-scroll-btn{position:absolute;right:7px;width:22px;height:22px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);color:var(--text-2);cursor:pointer;font-size:9px;display:flex;align-items:center;justify-content:center;z-index:10;opacity:0;pointer-events:none;transition:opacity .15s,background .1s;line-height:1;padding:0;font-family:var(--sans)}
.sb-scroll-btn.visible{opacity:.75;pointer-events:auto}
.sb-scroll-btn:hover{opacity:1!important;color:var(--text-hi);background:var(--border-hi)}
.sb-scroll-up{top:7px}
.sb-scroll-dn{bottom:7px}
.sidebar-header{padding:0 0 16px;flex-shrink:0}
.sidebar-title{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)}
.sidebar-body{columns:640px;column-gap:24px;display:block;overflow-x:hidden}

/* Server card */
.srv-row{display:flex;flex-direction:column;gap:7px;padding:11px 14px;cursor:pointer;border:1px solid var(--border);border-radius:10px;background:var(--surface);transition:border-color .18s,box-shadow .18s,transform .1s;min-width:0}
.srv-row:hover{border-color:var(--border-hi);box-shadow:0 4px 16px rgba(0,0,0,.2);transform:translateY(-1px)}
.srv-row.active{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue)}
.srv-hb-bar{display:flex;gap:2px;width:100%;align-items:flex-end}
.srv-hb-dot{flex:1;height:4px;border-radius:1px}
.srv-hb-dot.up{background:var(--green);opacity:.6}
.srv-hb-dot.down{background:var(--red);opacity:1;box-shadow:0 0 4px var(--red)}
.srv-hb-dot.pending{background:var(--surface2)}

/* Grouped sections — break-inside keeps each group whole within its column */
.srv-group{break-inside:avoid;display:block;margin-bottom:16px}
.srv-group-head{display:flex;align-items:center;gap:7px;padding:9px 6px;cursor:pointer;user-select:none;transition:background .15s}
.srv-group-head:hover{background:var(--surface);border-radius:8px}
.srv-group-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;box-shadow:0 0 6px rgba(255,255,255,.08)}
.srv-group-name{font-size:12px;font-weight:700;color:var(--text-hi);letter-spacing:.06em;text-transform:uppercase;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.srv-group-count{font-size:10px;font-weight:600;color:var(--text-2);padding:2px 7px;border-radius:10px;background:var(--surface);border:1px solid var(--border)}
.srv-group-chevron{display:flex;align-items:center;justify-content:center;color:var(--text-2);transition:transform .2s}
.srv-group.collapsed .srv-group-chevron{transform:rotate(-90deg)}
.srv-group-body{display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:8px;max-height:5000px;overflow:hidden;overflow-x:hidden;transition:max-height .25s ease}
.srv-group.collapsed .srv-group-body{max-height:0}

/* Sub-group sections (nested inside a srv-group) */
.srv-subgroup{break-inside:avoid;display:block}
.srv-subgroup-head{display:flex;align-items:center;gap:8px;padding:7px 12px;cursor:pointer;user-select:none;background:var(--surface2);border-radius:8px;border:1px solid var(--border);margin-bottom:6px}
.srv-subgroup-head:hover{background:var(--surface3,var(--surface2));border-color:var(--border-hi)}
.srv-subgroup-bar{width:3px;height:14px;border-radius:2px;flex-shrink:0}
.srv-subgroup-name{font-size:11px;font-weight:700;color:var(--text-hi);letter-spacing:.07em;text-transform:uppercase;flex:1}
.srv-subgroup-count{font-size:10px;font-weight:600;color:var(--text-2);padding:1px 7px;border-radius:8px;background:var(--bg);border:1px solid var(--border)}
.srv-subgroup-chevron{display:flex;align-items:center;justify-content:center;color:var(--text-2);transition:transform .2s}
.srv-subgroup.collapsed .srv-subgroup-chevron{transform:rotate(-90deg)}
.srv-subgroup-body{display:grid;grid-template-columns:repeat(auto-fill, minmax(220px, 1fr));gap:7px;padding-left:0;max-height:5000px;overflow:hidden;transition:max-height .25s ease}
.srv-subgroup.collapsed .srv-subgroup-body{max-height:0}
/* Sub-sections always span the full group width so cards inside get proper room */
.srv-group-body:not(.sub-cols) > .srv-subgroup{grid-column:1 / -1}
/* 2-column sub-section layout — CSS grid with min-width:0 so items never overflow */
.srv-group-body.sub-cols,.srv-subgroup-body.sub-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:start;overflow:hidden}
.srv-group-body.sub-cols > .srv-subgroup,.srv-subgroup-body.sub-cols > .srv-subgroup{min-width:0;overflow:hidden}
.srv-group-body.sub-cols .srv-subgroup-body,.srv-subgroup-body.sub-cols .srv-subgroup-body{grid-template-columns:1fr;padding-left:6px}

/* Quick create button — column-span:all makes it stretch across all CSS columns */
.srv-create-btn{display:flex;align-items:center;gap:8px;padding:14px 20px;font-size:11px;font-weight:600;color:var(--blue);text-decoration:none;border:1px dashed var(--border-hi);border-radius:12px;letter-spacing:.04em;text-transform:uppercase;transition:background .15s;column-span:all;margin-bottom:8px}
.srv-create-btn:hover{background:var(--blue-soft)}
.srv-create-btn svg{width:12px;height:12px;flex-shrink:0}
.srv-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;transition:none}
.srv-dot.up      {background:var(--green);box-shadow:0 0 6px rgba(16,232,138,0.5),0 0 0 0 rgba(16,232,138,0.5);animation:srvDotPulse 2.4s ease-in-out infinite}
@keyframes srvDotPulse{0%,100%{box-shadow:0 0 6px rgba(16,232,138,0.5),0 0 0 0 rgba(16,232,138,0)}50%{box-shadow:0 0 6px rgba(16,232,138,0.5),0 0 0 4px rgba(16,232,138,0)}}
.srv-dot.down    {background:var(--red);animation:blink 1.2s ease-in-out infinite}
.srv-dot.degraded{background:var(--orange)}
.srv-dot.pending {background:var(--text-2)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.srv-info{min-width:0;flex:1}
.srv-name{font-size:12px;font-weight:500;color:var(--text-hi);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:break-word}
.srv-host{font-family:var(--mono);font-size:10px;color:var(--text-2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.srv-desc{font-size:10px;color:var(--text-2);margin-top:2px;opacity:.75;font-style:italic;overflow:hidden;text-overflow:ellipsis;word-break:break-word;overflow-wrap:anywhere}
.srv-badge{font-size:10px;font-weight:600;padding:3px 9px;border-radius:10px;flex-shrink:0;letter-spacing:.04em}
.srv-badge.up      {color:var(--green);background:var(--green-soft)}
.srv-badge.down    {color:var(--red);background:var(--red-soft)}
.srv-badge.degraded{color:var(--orange);background:var(--orange-soft)}
.srv-badge.pending {color:var(--text-2);background:var(--surface2)}
.srv-cert-days{font-size:10px;font-weight:500;color:var(--text-2);letter-spacing:.02em;flex-shrink:0;white-space:nowrap}
.srv-cert-days.warn{color:var(--orange)}
.srv-cert-days.expired{color:var(--red)}
.pin-btn{background:none;border:none;cursor:pointer;color:var(--text-2);font-size:14px;padding:2px 4px;border-radius:4px;transition:color .15s;line-height:1;flex-shrink:0}
.pin-btn:hover,.pin-btn.pinned{color:var(--orange)}
/* Health banner */
/* Operator-authored admin banners (announcements, maintenance notices). Stacks above the auto-status health bar. */
.admin-banners{display:flex;flex-direction:column}
.admin-banner{display:flex;align-items:flex-start;gap:12px;padding:12px 22px;font-size:13px;line-height:1.5;border-bottom:1px solid var(--border)}
.admin-banner.sev-info{background:rgba(99,102,241,.08);color:#a5b4fc;border-bottom-color:rgba(99,102,241,.2)}
.admin-banner.sev-warning{background:rgba(245,158,11,.08);color:#fbbf24;border-bottom-color:rgba(245,158,11,.2)}
.admin-banner.sev-critical{background:rgba(239,61,90,.1);color:#fca5a5;border-bottom-color:rgba(239,61,90,.25)}
.admin-banner.sev-success{background:rgba(16,184,122,.08);color:#6ee7b7;border-bottom-color:rgba(16,184,122,.2)}
.admin-banner-icon{flex-shrink:0;margin-top:1px}
.admin-banner-body{flex:1;min-width:0}
.admin-banner-title{font-weight:700;color:var(--text-white);margin-bottom:2px;font-size:13px}
.admin-banner-msg{color:var(--text-hi);font-weight:500;white-space:pre-wrap;word-wrap:break-word}
.admin-banner.sev-critical .admin-banner-title{color:#fecaca}
.admin-banner.sev-warning .admin-banner-title{color:#fef3c7}
.admin-banner.sev-info .admin-banner-title{color:#c7d2fe}
.admin-banner.sev-success .admin-banner-title{color:#bbf7d0}
.admin-banner-link{display:inline-block;margin-left:8px;padding:2px 10px;border-radius:6px;background:rgba(255,255,255,.06);color:inherit;font-weight:600;font-size:12px;text-decoration:none;border:1px solid rgba(255,255,255,.1);transition:background .15s}
.admin-banner-link:hover{background:rgba(255,255,255,.12);text-decoration:none}
.admin-banner-close{flex-shrink:0;margin-left:8px;width:22px;height:22px;border:none;background:transparent;color:currentColor;opacity:.55;font-size:18px;line-height:1;cursor:pointer;border-radius:4px;transition:opacity .15s,background .15s}
.admin-banner-close:hover{opacity:1;background:rgba(255,255,255,.08)}
/* Response time pill */
.srv-ms{font-size:10px;font-family:var(--mono);padding:2px 6px;border-radius:3px;font-weight:600;flex-shrink:0;letter-spacing:.01em}
.srv-ms.fast{color:#10e88a;background:rgba(16,232,138,.1)}
.srv-ms.ok{color:var(--orange);background:var(--orange-soft)}
.srv-ms.slow{color:var(--red);background:var(--red-soft)}
.srv-sparkline{display:block;width:100%;height:20px;margin-top:3px;opacity:.7}
.srv-sparkline-wrap{width:100%;overflow:hidden}
/* Map view */
.map-view{display:none;flex-direction:column;flex:1;height:calc(100vh - 64px);min-height:0}
.map-view.active{display:flex}
#mapMainContainer{flex:1;width:100%;min-height:0}
#mapMainContainer .maplibregl-map{width:100%;height:100%}
.map-unmapped{background:var(--bg2);border-top:1px solid var(--border);padding:10px 16px;font-size:12px;color:var(--text-2)}
/* Map toggle button */
.map-toggle-btn{padding:5px 12px;border:1px solid var(--border-hi);border-radius:6px;color:var(--text-hi);font-size:12px;font-weight:500;background:none;cursor:pointer;transition:all .15s;white-space:nowrap}
.map-toggle-btn:hover,.map-toggle-btn.active{background:var(--blue-soft);border-color:var(--blue);color:var(--blue)}

/* -- MAIN AREA (detail view — hidden until a server is selected) -- */
.main{width:100%;height:100%;overflow-y:auto;padding:28px 32px;display:none}
.main::-webkit-scrollbar{width:4px}
.main::-webkit-scrollbar-thumb{background:var(--surface2);border-radius:2px}
.back-btn{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--text-2);background:var(--surface);border:1px solid var(--border-hi);border-radius:8px;padding:7px 14px;cursor:pointer;transition:color .15s,border-color .15s;margin-bottom:20px;text-decoration:none}
.back-btn:hover{color:var(--text-hi);border-color:var(--blue)}

/* view state toggles */
.layout.detail-open .sidebar{display:none}
.layout.detail-open .main{display:block}

/* empty state */
.empty-main{display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-2);font-size:14px}

/* welcome popup */
.welcome-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s}
.welcome-box{background:var(--surface);border:1px solid var(--border-hi);border-radius:16px;padding:40px;max-width:480px;width:90%;text-align:center;box-shadow:0 8px 40px rgba(0,0,0,.5)}
.welcome-icon{font-size:48px;margin-bottom:16px}
.welcome-title{font-size:22px;font-weight:700;color:var(--text-hi);margin-bottom:8px}
.welcome-text{font-size:14px;color:var(--text-2);line-height:1.6;margin-bottom:24px}
.welcome-btn{display:inline-block;padding:12px 28px;background:var(--blue);color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s}
.welcome-btn:hover{background:#1a6fe8}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* -- DETAIL MAP -- */
.detail-map-wrap{border-radius:10px;overflow:hidden;height:180px;border:1px solid var(--border);margin-bottom:24px;position:relative}
.detail-map-wrap .maplibregl-map{width:100%;height:180px}

/* -- MAP POPUP DARK THEME -- */
.maplibregl-popup-content{background:#0d1829!important;border:1px solid #1e2d45!important;border-radius:10px!important;padding:10px 14px!important;box-shadow:0 8px 28px rgba(0,0,0,.6)!important;color:#e8eaf0!important}
.maplibregl-popup-tip{border-top-color:#0d1829!important;border-bottom-color:#0d1829!important}
.maplibregl-popup-close-button{color:#5e7a99!important;font-size:16px!important;line-height:1!important;top:6px!important;right:8px!important}
.maplibregl-popup-close-button:hover{color:#e8eaf0!important;background:none!important}

/* -- SERVER DETAIL -- */
.detail-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;gap:16px;flex-wrap:wrap}
.detail-name{font-size:22px;font-weight:700;color:var(--text-white);letter-spacing:-.02em}
.detail-host{font-family:var(--mono);font-size:12px;color:var(--text-2);margin-top:4px}
.detail-desc{font-size:13px;color:var(--text);margin-top:4px}
.detail-tags{display:flex;gap:5px;margin-top:6px;flex-wrap:wrap}
.detail-tag{font-size:10px;font-weight:600;letter-spacing:.05em;padding:2px 8px;border-radius:4px;background:var(--surface2);color:var(--text-2);border:1px solid var(--border);text-transform:uppercase}
.status-big{display:flex;align-items:center;gap:12px;padding:12px 20px;border-radius:12px;border:1px solid;flex-shrink:0;transition:transform .2s,box-shadow .2s;backdrop-filter:blur(4px)}
.status-big:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,0,0,0.15)}
.status-big.up      {color:var(--green);border-color:rgba(16,232,138,0.2);background:var(--green-soft)}
.status-big.down    {color:var(--red);border-color:rgba(255,61,90,0.2);background:var(--red-soft)}
.status-big.degraded{color:var(--orange);border-color:rgba(255,140,42,0.2);background:var(--orange-soft)}
.status-big.pending {color:var(--text-2);border-color:var(--border);background:var(--surface)}
.status-big-dot{width:10px;height:10px;border-radius:50%;background:currentColor}
.status-big.up .status-big-dot{animation:pulse 2s ease-in-out infinite}
.status-big-label{font-size:13px;font-weight:700;letter-spacing:.05em}
.status-big-time{font-size:11px;opacity:.7;margin-top:2px}
.edit-server-btn{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--text-2);background:var(--surface);border:1px solid var(--border-hi);border-radius:8px;padding:6px 12px;text-decoration:none;transition:color .15s,border-color .15s,background .15s}
.edit-server-btn:hover{color:var(--text-hi);border-color:var(--blue);background:var(--blue-soft)}

/* -- UPTIME CARDS -- */
.uptime-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}
.uptime-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;text-align:center;transition:transform .2s cubic-bezier(.4,0,.2,1),border-color .2s,box-shadow .2s;position:relative;overflow:hidden}
.uptime-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--blue-soft) 0%,transparent 50%);opacity:0;transition:opacity .25s;pointer-events:none}
.uptime-card:hover{transform:translateY(-2px);border-color:var(--border-hi);box-shadow:0 8px 24px rgba(0,0,0,0.2)}
.uptime-card:hover::before{opacity:1}
.uptime-label{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2);margin-bottom:8px}
.uptime-pct{font-size:28px;font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--text-hi)}
.uptime-pct.great{color:var(--green)}
.uptime-pct.good {color:var(--blue)}
.uptime-pct.warn {color:var(--orange)}
.uptime-pct.bad  {color:var(--red)}
.uptime-sub{font-size:11px;color:var(--text-2);margin-top:4px}

/* -- SECTION -- */
.section{background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:20px;overflow:hidden;transition:border-color .2s,box-shadow .2s}
.section:hover{border-color:var(--border-hi)}
.section-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border)}
.section-title{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2)}
.section-body{padding:20px}
.detail-data-notice{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin:0 0 18px;padding:13px 15px;border:1px solid rgba(255,140,42,.28);border-radius:12px;background:var(--orange-soft);color:var(--text-hi);font-size:12px;line-height:1.5}
.detail-data-notice-copy{min-width:0}
.detail-data-notice-title{color:var(--orange);font-weight:700}
.detail-data-notice-message{margin-top:2px;color:var(--text-2)}
.detail-retry-btn{flex-shrink:0;min-height:36px;padding:0 13px;border:1px solid rgba(255,140,42,.32);border-radius:8px;background:var(--surface);color:var(--orange);font:700 11px var(--sans);cursor:pointer}
.detail-retry-btn:hover{background:var(--surface2)}

/* -- HEARTBEAT TIMELINE -- */
/* Bars use flex:1 so they stretch to fill the full section width on any screen,
   instead of staying at a fixed 10px and leaving empty space on wide monitors. */
.heartbeat{display:flex;gap:1px;align-items:flex-end;width:100%;flex-wrap:nowrap;overflow:hidden}
.hb-dot{flex:1 1 0;min-width:0;height:28px;border-radius:2px;transition:opacity .2s;cursor:pointer;position:relative}
.hb-dot.up     {background:var(--green);opacity:.7}
.hb-dot.up:last-child{opacity:1}
.hb-dot.down   {background:var(--red);opacity:1;min-width:3px;flex-shrink:0;box-shadow:0 0 6px var(--red)}
.hb-dot.pending{background:var(--surface2)}
.hb-dot:hover  {opacity:1!important}
.hb-dot.down   {cursor:pointer}
.hb-tooltip{position:fixed;z-index:9999;background:var(--surface2);border:1px solid var(--border-hi);border-radius:8px;padding:10px 16px;white-space:nowrap;pointer-events:none;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.5)}
.hb-tooltip-time{font-size:16px;font-weight:600;color:var(--text-hi)}
.hb-tooltip-status{font-size:14px;color:var(--text-2);margin-top:3px}
.hb-tooltip::after{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:var(--border-hi)}
.hb-legend{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--text-2);margin-top:8px}
/* -- INCIDENT MODAL (heartbeat click) -- */
.hb-modal-overlay{position:fixed;inset:0;z-index:9998;display:flex;align-items:center;justify-content:center;background:rgba(0,5,20,.65);backdrop-filter:blur(5px);animation:fadeIn .15s}
.hb-modal-box{background:var(--surface);border:1px solid var(--border-hi);border-radius:14px;padding:0;min-width:320px;max-width:560px;width:92%;box-shadow:0 12px 48px rgba(0,0,0,.6);position:relative;overflow:hidden}
.hb-modal-head{display:flex;align-items:center;gap:10px;padding:16px 20px;border-bottom:1px solid var(--border);background:var(--surface2)}
.hb-modal-head-dot{width:10px;height:10px;border-radius:50%;background:var(--red);flex-shrink:0;box-shadow:0 0 6px var(--red)}
.hb-modal-title{font-size:14px;font-weight:700;color:var(--text-white);flex:1}
.hb-modal-ts{font-size:11px;color:var(--text-2);font-family:var(--mono)}
.hb-modal-close{width:28px;height:28px;border:none;background:var(--surface3);color:var(--text-2);border-radius:6px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .12s,color .12s}
.hb-modal-close:hover{background:var(--red-soft);color:var(--red)}
.hb-modal-body{padding:16px 20px;max-height:55vh;overflow-y:auto}
.hb-modal-body .incident-list{display:flex;flex-direction:column;gap:0}
.hb-modal-body .incident-row{display:grid;grid-template-columns:auto 1fr auto;align-items:start;gap:14px;padding:11px 0;border-bottom:1px solid var(--border)}
.hb-modal-body .incident-row:last-child{border-bottom:none}
.hb-modal-none{padding:8px 0;color:var(--text-2);font-size:13px;text-align:center}

/* -- RESPONSE TIME CHART -- */
.chart-wrap{position:relative;height:120px;width:100%}
canvas#responseChart{width:100%!important}
.chart-empty{display:flex;align-items:center;justify-content:center;height:120px;font-size:13px;color:var(--text-2)}

/* -- CHECKS -- */
.checks-row{display:flex;gap:10px;flex-wrap:wrap}
.runbook-section.runbook-hot{border-color:var(--red);box-shadow:0 0 0 1px var(--red) inset}
.runbook-flag{display:inline-block;margin-left:8px;padding:2px 8px;background:var(--red);color:#fff;border-radius:10px;font-size:10px;font-weight:700;letter-spacing:.04em;vertical-align:middle;animation:runbook-pulse 1.6s ease-in-out infinite}
@keyframes runbook-pulse{0%,100%{opacity:1}50%{opacity:.55}}
.runbook-body{font-size:13px;line-height:1.6;color:var(--text-hi)}
.runbook-body h2.rb-h,.runbook-body h3.rb-h,.runbook-body h4.rb-h{margin:14px 0 6px;color:var(--text-hi);font-weight:600}
.runbook-body h2.rb-h{font-size:15px}
.runbook-body h3.rb-h{font-size:14px}
.runbook-body h4.rb-h{font-size:13px;color:var(--text-2);text-transform:uppercase;letter-spacing:.04em}
.runbook-body h2.rb-h:first-child,.runbook-body h3.rb-h:first-child,.runbook-body h4.rb-h:first-child{margin-top:0}
.runbook-body p{margin:0 0 10px}
.runbook-body p:last-child{margin-bottom:0}
.runbook-body ul.rb-ul,.runbook-body ol.rb-ol{margin:0 0 10px;padding-left:22px}
.runbook-body li{margin:3px 0}
.runbook-body a{color:var(--blue);text-decoration:none;border-bottom:1px solid rgba(42,127,255,0.35)}
.runbook-body a:hover{border-bottom-color:var(--blue)}
.runbook-body code.rb-code{background:var(--input-bg);border:1px solid var(--border);padding:1px 6px;border-radius:4px;font-family:var(--mono);font-size:12px}
.runbook-body pre.rb-pre{background:var(--input-bg);border:1px solid var(--border);padding:10px 12px;border-radius:6px;overflow-x:auto;font-family:var(--mono);font-size:12px;line-height:1.5;margin:0 0 10px}
.runbook-body pre.rb-pre code{background:transparent;border:none;padding:0}
.check-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:8px;font-size:12px;border:1px solid}
.check-chip.ok  {border-color:rgba(16,232,138,0.2);background:var(--green-soft)}
.check-chip.fail{border-color:rgba(255,61,90,0.2);background:var(--red-soft)}
/* SSL cert badge — inline inside the HTTP check chip */
.chip-cert{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:2px 7px;border-radius:10px;letter-spacing:.02em;margin-left:4px;white-space:nowrap}
.chip-cert.cert-ok     {color:var(--green);background:var(--green-soft);border:1px solid rgba(16,232,138,0.25)}
.chip-cert.cert-warn   {color:var(--orange);background:var(--orange-soft);border:1px solid rgba(255,140,42,0.3)}
.chip-cert.cert-expired{color:var(--red);background:var(--red-soft);border:1px solid rgba(255,61,90,0.3)}
.chip-cert svg{flex-shrink:0;opacity:.85}
.chip-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.check-chip.ok   .chip-dot{background:var(--green)}
.check-chip.fail .chip-dot{background:var(--red)}
.chip-label {font-weight:500;color:var(--text-hi)}
.chip-detail{font-family:var(--mono);font-size:11px;color:var(--text-2);padding-left:6px;border-left:1px solid var(--border)}

/* -- INCIDENTS -- */
.incident-list{display:flex;flex-direction:column;gap:0}
.incident-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid var(--border)}
.incident-row:last-child{border-bottom:none}
.incident-dot{width:8px;height:8px;border-radius:50%;background:var(--red);flex-shrink:0}
.incident-dot.resolved{background:var(--red);opacity:.5}
.incident-info{}
.incident-cause{font-size:13px;color:var(--text-hi);font-weight:500}
.incident-time{font-size:11px;color:var(--text-2);margin-top:2px;font-family:var(--mono)}
.incident-dur{font-size:12px;font-weight:600;text-align:right}
.incident-dur.resolved{color:var(--text-2)}
.incident-dur.open{color:var(--red)}
.no-incidents{text-align:center;padding:20px;color:var(--text-2);font-size:13px}

/* -- SKELETON -- */
.skeleton{background:linear-gradient(90deg,var(--surface) 25%,var(--surface2) 50%,var(--surface) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:6px}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* -- RESPONSIVE -- */
@media(max-width:760px){
  .topbar{padding:8px 12px;min-height:56px;gap:8px;row-gap:6px}
  .topbar-brand{flex-shrink:0}
  .topbar-name{font-size:14px}
  .topbar-icon{width:36px;height:36px;border-radius:9px}
  .topbar-logo-img{width:32px;height:32px;border-radius:7px}
  .topbar-right{gap:10px;font-size:11px}
  .topbar-status span{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px}
  .topbar-clock{display:none}
  .topbar-admin{padding:4px 9px;font-size:11px}
  .topbar-dashboards{width:100%;order:3;margin:0;flex-basis:100%;overflow-x:auto;flex-wrap:nowrap;padding-bottom:2px;-webkit-overflow-scrolling:touch}
  .topbar-dashboards::-webkit-scrollbar{display:none}
  .dash-nav{padding:4px 10px;font-size:10px}
  .layout{height:auto;overflow:visible}
  /* On mobile the whole page scrolls — disable the inner scroll container */
  .sidebar{height:auto;overflow:visible}
  .sidebar-scroll{height:auto;overflow:visible;padding:16px 12px}
  .sb-scroll-btn{display:none}
  .sidebar-body{columns:1}
  .srv-group-body.sub-cols,.srv-subgroup-body.sub-cols{grid-template-columns:1fr}
  .srv-group-body{grid-template-columns:1fr}
  .srv-subgroup-body{grid-template-columns:1fr}
  .main{padding:14px 12px}
  .detail-header{flex-direction:column;gap:10px;margin-bottom:18px}
  .detail-name{font-size:18px}
  .uptime-row{grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px}
  .uptime-card{padding:12px 6px}
  .uptime-pct{font-size:20px}
  .uptime-label{font-size:9px;letter-spacing:.04em}
  .uptime-sub{font-size:9px}
  .section{margin-bottom:14px}
  .section-head{padding:11px 14px}
  .section-body{padding:14px}
  .detail-data-notice{align-items:stretch;flex-direction:column;margin-bottom:14px}
  .detail-retry-btn{width:100%;min-height:44px}
  .heartbeat{gap:1px}
  .hb-dot{height:24px}
  .checks-row{gap:6px}
  .check-chip{padding:6px 10px;font-size:11px}
  .chip-detail{font-size:10px}
  .incident-row{gap:10px;padding:10px 0}
  .incident-cause{font-size:12px}
  .incident-time{font-size:10px}
}

/* -- BRAND SUBTITLE (per-dashboard branding) -- */
.topbar-subtitle{font-size:11px;color:var(--text-2);margin-top:1px;font-weight:400}

/* -- STATUS PAGE 4.0 -------------------------------------------------------
   A calmer, public-first overview layered over the existing monitoring UI. */
:root{
  --page-width:1440px;
  --card-shadow:0 18px 50px rgba(0,0,0,.18);
  --card-highlight:rgba(255,255,255,.055);
}
body{
  background:
    radial-gradient(circle at 12% 4%,var(--blue-soft),transparent 28rem),
    radial-gradient(circle at 90% 18%,rgba(16,232,138,.035),transparent 24rem),
    var(--bg);
}
body::before{
  background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);
  background-size:52px 52px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.18),transparent 34rem);
  opacity:.2;
}
.topbar{
  position:sticky;
  top:0;
  padding:12px max(24px,calc((100vw - var(--page-width)) / 2 + 30px));
  min-height:72px;
  background:color-mix(in srgb,var(--bg2) 84%,transparent);
  border-bottom-color:var(--border);
  box-shadow:0 1px 0 rgba(255,255,255,.015),0 12px 40px rgba(0,0,0,.12);
}
.topbar-icon{border-radius:13px;background:linear-gradient(145deg,var(--blue-soft),var(--surface));box-shadow:inset 0 1px 0 var(--card-highlight)}
.topbar-name{font-size:16px;letter-spacing:-.025em}
.topbar-subtitle{font-size:10px;letter-spacing:.03em}
.layout{min-height:calc(100vh - 72px);overflow:visible}
.sidebar{height:auto;min-height:calc(100vh - 72px);background:transparent;overflow:visible}
.sidebar-scroll{height:auto;max-width:var(--page-width);margin:0 auto;padding:38px 30px 64px;overflow:visible}
.sb-scroll-btn{display:none}
/* Overview hero */
.status-overview{
  position:relative;
  overflow:hidden;
  border:1px solid var(--border-hi);
  border-radius:28px;
  padding:30px;
  margin-bottom:26px;
  background:linear-gradient(135deg,color-mix(in srgb,var(--surface) 96%,var(--blue) 4%),color-mix(in srgb,var(--bg2) 90%,transparent));
  box-shadow:var(--card-shadow),inset 0 1px 0 var(--card-highlight);
}
.status-overview::before{
  content:"";
  position:absolute;
  width:360px;
  height:360px;
  border-radius:50%;
  right:-120px;
  top:-210px;
  background:var(--blue);
  opacity:.1;
  filter:blur(12px);
  pointer-events:none;
}
.status-overview.all-up::before{background:var(--green);opacity:.12}
.status-overview.has-issues::before{background:var(--orange);opacity:.14}
.status-overview.has-outage::before{background:var(--red);opacity:.16}
.overview-top{position:relative;display:flex;align-items:center;justify-content:space-between;gap:28px}
.overview-copy{min-width:0}
.overview-kicker{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:var(--text-2);font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
.overview-live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px var(--green-soft)}
.status-overview.has-issues .overview-live-dot{background:var(--orange);box-shadow:0 0 0 5px var(--orange-soft)}
.status-overview.has-outage .overview-live-dot{background:var(--red);box-shadow:0 0 0 5px var(--red-soft)}
.overview-title{font-size:clamp(28px,3.3vw,46px);line-height:1.08;letter-spacing:-.045em;color:var(--text-white);font-weight:700}
.overview-description{max-width:650px;margin-top:10px;color:var(--text);font-size:14px;line-height:1.65}
.overview-updated{display:flex;align-items:center;gap:7px;margin-top:18px;color:var(--text-2);font-family:var(--mono);font-size:10px}
.overview-updated svg{opacity:.7}
.overview-signal{position:relative;display:flex;align-items:center;gap:13px;min-width:230px;padding:17px 19px;border:1px solid rgba(16,232,138,.2);border-radius:17px;background:var(--green-soft);color:var(--green)}
.status-overview.has-issues .overview-signal{color:var(--orange);border-color:rgba(255,140,42,.24);background:var(--orange-soft)}
.status-overview.has-outage .overview-signal{color:var(--red);border-color:rgba(255,61,90,.24);background:var(--red-soft)}
.status-overview.checking .overview-signal{color:var(--text-2);border-color:var(--border);background:var(--surface2)}
.overview-signal-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:currentColor;box-shadow:0 0 24px color-mix(in srgb,currentColor 35%,transparent)}
.overview-signal-icon svg{color:var(--bg)}
.overview-signal-copy{min-width:0}
.overview-signal-label{font-size:13px;font-weight:700;color:currentColor}
.overview-signal-sub{margin-top:3px;font-size:10px;color:var(--text-2);font-family:var(--mono)}
.overview-metrics{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:28px;padding-top:22px;border-top:1px solid var(--border)}
.overview-metric{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;background:color-mix(in srgb,var(--surface2) 65%,transparent);border:1px solid transparent}
.overview-metric-icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;color:var(--blue);background:var(--blue-soft)}
.overview-metric:nth-child(2) .overview-metric-icon{color:var(--green);background:var(--green-soft)}
.overview-metric:nth-child(3) .overview-metric-icon{color:var(--orange);background:var(--orange-soft)}
.overview-metric-value{color:var(--text-white);font-size:19px;font-weight:700;line-height:1}
.overview-metric-label{margin-top:4px;color:var(--text-2);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}

/* Service directory toolbar */
.sidebar-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:0 2px 16px}
.sidebar-title{color:var(--text-white);font-size:20px;font-weight:700;letter-spacing:-.03em;text-transform:none}
.sidebar-caption{margin-top:5px;color:var(--text-2);font-size:12px}
.status-legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:0 2px 16px;color:var(--text-2);font-size:10px}
