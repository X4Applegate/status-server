// -- Dashboard grouping state (master / view only)
// dashboardGroups holds the metadata (id, name, slug, accent_color) for the groups the
// current user can see. Populated by loadDashboardGroups() after login is confirmed.
let dashboardGroups = [];
let sidebarSession  = { loggedIn: false, role: null };
const COLLAPSE_KEY  = "sm-sidebar-collapsed";
let currentIncidents = []; // kept in sync by renderDetail for hb click handler
let collapsedGroups = new Set(JSON.parse(localStorage.getItem(COLLAPSE_KEY) || "[]"));

async function loadDashboardGroups(){
  let me = null;
  try {
    // Session lookup runs on every page so the topbar quick-nav knows the role.
    const meRes = await fetch("/api/me");
    if (meRes.ok) {
      me = await meRes.json();
      sidebarSession = { loggedIn: !!me.loggedIn, role: me.role || null, username: me.username || null };
    }
    // Only logged-in users get dashboard pills, and the list is scoped to what
    // the server says they're allowed to see (admins: all; viewers: their grants;
    // public visitors on /dashboard/<slug>: nothing — each dashboard is private).
    if (sidebarSession.loggedIn) {
      const groupsRes = await fetch("/api/admin/groups");
      if (groupsRes.ok) {
        dashboardGroups = await groupsRes.json();
      }
    }
  } catch(e) { /* silent — fall back to flat rendering */ }

  if (sidebarSession.loggedIn) loadDbPins().then(() => { if (servers.length) renderSidebar(); });

  // Render login/logout button in topbar
  const authEl = document.getElementById("topbarAuthBtn");
  if (authEl) {
    if (!sidebarSession.loggedIn) {
      authEl.innerHTML = `<a class="topbar-login" href="/login">Sign In</a>`;
    } else {
      // Show username + logout; admin button (if present) is already in the topbar
      authEl.innerHTML = `<div class="topbar-user">
        <span class="topbar-username">${sidebarSession.username || ""}</span>
        <button class="topbar-logout" onclick="doLogout()">Sign Out</button>
      </div>`;
    }
  }

  // Manage button is now rendered by renderTopbarDashboards() as a pill —
  // clear the legacy topbarManageBtn container to avoid duplicates.
  const manageEl = document.getElementById("topbarManageBtn");
  if (manageEl) manageEl.innerHTML = "";

  // Re-render open detail panel to show/hide protected info now that auth is known
  if (selectedId) {
    const s = servers.find(x => x.id === selectedId);
    if (s) {
      const cached = cacheGet("detail-" + selectedId);
      if (cached) renderDetail(s, cached.uptime, cached.heartbeat, cached.incidents, cached.responseSeries);
    }
  }
  // Check if welcome popup should show (session is now confirmed)
  if (window._serversLoaded) checkWelcome();
  // Re-render server list to show/hide host under each card
  if (servers.length) renderSidebar();

  // Paint the topbar pills (empty for public visitors, scoped for viewers, full for admins)
  renderTopbarDashboards();
  // Sidebar grouping only applies on the master view
  if (!GROUP_SLUG && servers.length) renderSidebar();
}

async function doLogout(){
  try { await fetch("/api/logout", { method:"POST" }); } catch(e) {}
  window.location.reload();
}

// Paint the topbar dashboard quick-nav. One pill per accessible dashboard, plus
// an "Admin" pill at the end (admins only — viewers don't see it, and even if
// they somehow do, clicking it shows a permission-denied toast).
function renderTopbarDashboards(){
  const el      = document.getElementById("topbarDashboards");
  const popup   = document.getElementById("topbarDashPopup");
  const dashMenu = document.getElementById("topbarDashMenu");
  if (!el) return;
  const pills = (dashboardGroups || []).map(g => {
    const dot = g.accent_color || "var(--blue)";
    const isCurrent = GROUP_SLUG === g.slug;
    const href = g.custom_domain ? `https://${g.custom_domain}` : `/dashboard/${g.slug}`;
    return `<a class="dash-nav ${isCurrent ? 'active' : ''}" href="${href}">
      <span class="dash-nav-dot" style="background:${dot}"></span>${g.name}</a>`;
  });
  el.innerHTML = pills.join("");
  if (popup) popup.innerHTML = pills.join("");
  // Hide the Dashboards dropdown button entirely when there are no groups to show
  if (dashMenu) dashMenu.style.display = pills.length ? "" : "none";
}

