<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Applegate Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#080b12;
  --surface:#0d1117;
  --surface2:#161b22;
  --border:rgba(255,255,255,0.07);
  --border-hi:rgba(255,255,255,0.12);
  --text:#8b949e;
  --text-hi:#c9d1d9;
  --text-white:#f0f6fc;
  --input-bg:#0d1117;
  --accent:#2563eb;
  --accent-hover:#1d4ed8;
  --accent-soft:rgba(37,99,235,0.10);
  --accent-border:rgba(37,99,235,0.28);
  --danger:#ef4444;
  --sans:'Inter',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --mono:'JetBrains Mono',monospace;
  --r:10px;--r-sm:7px;
}
html[data-theme="light"]{
  --bg:#f4f5f7;
  --surface:#ffffff;
  --surface2:#f6f8fa;
  --border:rgba(0,0,0,0.09);
  --border-hi:rgba(0,0,0,0.15);
  --text:#656d76;
  --text-hi:#1f2328;
  --text-white:#111318;
  --input-bg:#ffffff;
}
body{
  font-family:var(--sans);
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:24px;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
.card{
  width:100%;
  max-width:380px;
  background:var(--surface);
  border:1px solid var(--border-hi);
  border-radius:var(--r);
  padding:32px;
  box-shadow:0 8px 32px rgba(0,0,0,.28),0 1px 2px rgba(0,0,0,.18);
}
/* brand row */
.brand{display:flex;align-items:center;gap:11px;margin-bottom:26px}
.brand-icon{
  width:36px;height:36px;border-radius:9px;
  background:var(--accent-soft);
  border:1px solid var(--accent-border);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.brand-name{font-size:16px;font-weight:700;color:var(--text-white);letter-spacing:-.02em}
.brand-name em{font-style:normal;color:var(--accent)}
/* headings */
.heading{font-size:17px;font-weight:700;color:var(--text-white);margin-bottom:4px;letter-spacing:-.015em}
.subhead{font-size:13px;color:var(--text);margin-bottom:22px;line-height:1.5}
/* form */
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.label{font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text)}
.input-wrap{position:relative}
.input{
  width:100%;padding:9px 12px;
  background:var(--input-bg);
  border:1px solid var(--border-hi);
  border-radius:var(--r-sm);
  color:var(--text-white);
  font:400 13px/1.4 var(--sans);
  outline:none;
  transition:border-color .15s,box-shadow .15s;
}
.input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(37,99,235,.18)}
.input::placeholder{color:var(--text)}
.input.has-icon{padding-right:38px}
.toggle-btn{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  background:none;border:none;cursor:pointer;color:var(--text);
  padding:4px;display:flex;align-items:center;
  border-radius:4px;transition:color .15s;
}
.toggle-btn:hover{color:var(--text-hi)}
/* actions */
.btn-login{
  width:100%;min-height:38px;padding:9px;
  background:var(--accent);
  border:1px solid var(--accent);
  border-radius:var(--r-sm);
  color:#fff;
  font:600 13px var(--sans);
  cursor:pointer;margin-top:6px;
  transition:background .15s,border-color .15s,transform .1s;
}
.btn-login:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.btn-login:active{transform:scale(.98)}
.btn-login:disabled{opacity:.6;cursor:not-allowed;transform:none}
/* error */
.error{
  background:rgba(239,68,68,.08);
  border:1px solid rgba(239,68,68,.22);
  border-radius:var(--r-sm);
  padding:9px 12px;font-size:12px;color:#fca5a5;
  margin-top:10px;display:none;line-height:1.45;
}
.error.show{display:block}
/* divider */
.divider{
  display:flex;align-items:center;gap:10px;
  margin:16px 0;color:var(--text);
  font-size:11px;font-weight:500;letter-spacing:.04em;text-transform:uppercase;
}
.divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--border-hi)}
/* google button */
.btn-google{
  width:100%;min-height:38px;padding:9px;
  background:var(--surface2);
  border:1px solid var(--border-hi);
  border-radius:var(--r-sm);
  color:var(--text-hi);
  font:500 13px var(--sans);
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;
  transition:background .15s,border-color .15s;
}
.btn-google:hover{background:var(--surface);border-color:rgba(255,255,255,.2)}
/* footer */
.page-footer{
  margin-top:20px;font-size:11px;color:var(--text);text-align:center;
}
.page-footer a{color:var(--text);text-decoration:none}
.page-footer a:hover{color:var(--text-hi);text-decoration:underline;text-underline-offset:3px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}}
</style>
</head>
<body>
<div class="card">
  <div class="brand">
    <div class="brand-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent)"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/></svg>
    </div>
    <div class="brand-name">Applegate<em>Monitor</em></div>
  </div>
  <div class="heading" id="formHeading">Welcome back</div>
  <div class="subhead" id="formSubhead">Sign in to access the dashboard</div>
  <div class="form-group">
    <label class="label" for="username">Username</label>
    <input class="input" id="username" type="text" placeholder="Enter your username" autocomplete="username">
  </div>
  <div class="form-group">
    <label class="label" for="password">Password</label>
    <div class="input-wrap">
      <input class="input has-icon" id="password" type="password" placeholder="Enter password" autocomplete="current-password">
      <button type="button" class="toggle-btn" onclick="togglePwd()" id="pwdToggle" aria-label="Show or hide password">
        <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
  </div>
  <div class="form-group" id="confirmGroup" style="display:none">
    <label class="label" for="confirmPassword">Confirm Password</label>
    <input class="input" id="confirmPassword" type="password" placeholder="Confirm your password" autocomplete="new-password">
  </div>
  <div id="turnstileWrap" style="display:none;margin:4px 0"></div>
  <button class="btn-login" id="loginBtn" onclick="doLogin()">Sign In</button>
  <div class="error" id="errorMsg" role="alert"></div>
  <% if (googleEnabled) { %>
  <div class="divider" id="googleDivider">or</div>
  <button class="btn-google" id="googleBtn" onclick="window.location.href='/auth/google'">
    <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.93 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
    Continue with Google
  </button>
  <% } %>
</div>
<div class="page-footer">
  <a href="https://github.com/X4Applegate/status-server" target="_blank" rel="noopener">Applegate Monitor</a>
</div>
<script>
(function(){
  const params = new URLSearchParams(window.location.search);
  const oauthErr = params.get("error");
  if (oauthErr) {
    const msg = oauthErr === "google_denied" ? "Google sign-in was cancelled."
              : oauthErr === "state_mismatch" ? "Security check failed — please try again."
              : "Google sign-in failed — please try again.";
    const el = document.getElementById("errorMsg");
    el.textContent = msg;
    el.classList.add("show");
    history.replaceState(null, "", "/login");
  }
})();

let setupMode = false;
let turnstileWidgetId = null;
let turnstileSiteKey  = "";

function renderTurnstile(){
  if (!turnstileSiteKey || !window.turnstile) return;
  const wrap = document.getElementById("turnstileWrap");
  wrap.style.display = "block";
  wrap.innerHTML = "";
  turnstileWidgetId = window.turnstile.render(wrap, {
    sitekey: turnstileSiteKey,
    theme: "auto",
    size: "flexible"
  });
}

(async () => {
  try {
    const meRes = await fetch("/api/me");
    const me = await meRes.json();
    if (me.loggedIn) { window.location.href = me.login_redirect || "/"; return; }
  } catch(e) {}

  try {
    const r = await fetch("/api/setup-status");
    const d = await r.json();
    if (d.needsSetup) {
      setupMode = true;
      document.getElementById("formHeading").textContent = "Create Admin Account";
      document.getElementById("formSubhead").textContent = "Set up your first admin account to get started";
      document.getElementById("confirmGroup").style.display = "flex";
      document.getElementById("loginBtn").textContent = "Create Account";
      document.getElementById("username").placeholder = "Choose a username";
      document.getElementById("password").autocomplete = "new-password";
      const gd = document.getElementById("googleDivider");
      const gb = document.getElementById("googleBtn");
      if (gd) gd.style.display = "none";
      if (gb) gb.style.display = "none";
    }
  } catch(e) {}

  if (!setupMode) {
    try {
      const r = await fetch("/api/turnstile-config");
      const d = await r.json();
      if (d.enabled && d.site_key) {
        turnstileSiteKey = d.site_key;
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileReady";
        s.async = true; s.defer = true;
        document.head.appendChild(s);
      }
    } catch(e) {}
  }
})();

window.onTurnstileReady = renderTurnstile;

document.getElementById("password").addEventListener("keydown", e => {
  if (e.key === "Enter") {
    if (setupMode) document.getElementById("confirmPassword").focus();
    else doLogin();
  }
});
document.getElementById("username").addEventListener("keydown", e => { if(e.key==="Enter") document.getElementById("password").focus(); });
document.getElementById("confirmPassword").addEventListener("keydown", e => { if(e.key==="Enter") doLogin(); });

function togglePwd(){
  const input = document.getElementById("password");
  const icon  = document.getElementById("eyeIcon");
  if(input.type === "password"){
    input.type = "text";
    icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
  } else {
    input.type = "password";
    icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }
}

async function doLogin(){
  const btn      = document.getElementById("loginBtn");
  const err      = document.getElementById("errorMsg");
  const username = document.getElementById("username").value.trim();
  const password = document.getElementById("password").value;
  if(!username||!password){ err.textContent="Please enter your username and password."; err.classList.add("show"); return; }

  if (setupMode) {
    const confirm = document.getElementById("confirmPassword").value;
    if (password !== confirm) { err.textContent="Passwords do not match."; err.classList.add("show"); return; }
    btn.disabled=true; btn.textContent="Creating account…"; err.classList.remove("show");
    try {
      const r = await fetch("/api/setup", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username,password})});
      const data = await r.json();
      if (!r.ok) { err.textContent=data.error||"Setup failed"; err.classList.add("show"); btn.disabled=false; btn.textContent="Create Account"; return; }
      window.location.href = data.redirect || "/";
    } catch(e) {
      err.textContent="Connection error — please try again"; err.classList.add("show"); btn.disabled=false; btn.textContent="Create Account";
    }
    return;
  }

  let turnstile_token = "";
  if (turnstileSiteKey) {
    if (window.turnstile && turnstileWidgetId !== null) {
      turnstile_token = window.turnstile.getResponse(turnstileWidgetId) || "";
    }
    if (!turnstile_token) {
      err.textContent = "Please complete the security check.";
      err.classList.add("show");
      return;
    }
  }

  btn.disabled=true; btn.textContent="Signing in…"; err.classList.remove("show");
  try{
    const r=await fetch("/api/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username,password,turnstile_token})});
    const data=await r.json();
    if(!r.ok){
      err.textContent=data.error||"Login failed";
      err.classList.add("show");
      btn.disabled=false; btn.textContent="Sign In";
      if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
      return;
    }
    window.location.href = data.redirect || "/";
  }catch(e){
    err.textContent="Connection error — please try again"; err.classList.add("show"); btn.disabled=false; btn.textContent="Sign In";
    if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
  }
}
</script>
</body>
</html>
