<!DOCTYPE html>
<html lang="en" data-theme="<%= defaultTheme === 'light' ? 'light' : 'dark' %>">
<head>
<%- include('partials/head', { title: pageTitle }) %>
<script>
(function () {
  const configuredTheme = "<%= defaultTheme === 'light' ? 'light' : 'dark' %>";
  let theme = configuredTheme;
  try {
    const savedTheme = localStorage.getItem("status-page-theme");
    if (savedTheme === "light" || savedTheme === "dark") {
      theme = savedTheme;
    } else {
      localStorage.setItem("status-page-theme", configuredTheme);
    }
  } catch (_) { /* storage may be unavailable; use the configured group theme */ }
  document.documentElement.dataset.theme = theme;
})();
</script>
<link rel="alternate" type="application/rss+xml" title="<%= groupName %> status updates" href="<%= feedUrl %>">
<meta name="theme-color" content="<%= accentColor || '#2a7fff' %>">
<style>
:root{
  --enterprise-accent:<%= accentColor || '#2a7fff' %>;
  --history-accent:<%= accentColor || '#2563eb' %>;
  --history-bg:var(--enterprise-bg,#f5f7fa);
  --history-surface:var(--enterprise-surface,#fff);
  --history-surface-subtle:var(--enterprise-surface-subtle,#f7f8fa);
  --history-surface-raised:var(--enterprise-surface-raised,#fff);
  --history-border:var(--enterprise-border,#dfe3e8);
  --history-border-strong:var(--enterprise-border-strong,#cbd2da);
  --history-text:var(--enterprise-text,#17202a);
  --history-text-muted:var(--enterprise-text-muted,#5d6875);
  --history-text-subtle:var(--enterprise-text-subtle,#7b8794);
  --history-shadow:var(--enterprise-shadow-md,0 12px 36px rgba(15,23,42,.08));
  --history-success:var(--enterprise-success,#168a5b);
  --history-warning:var(--enterprise-warning,#a66500);
  --history-danger:var(--enterprise-danger,#c73348);
  --history-info:var(--enterprise-info,#6650c8);
  --history-page-background:<%= bgColor || 'var(--history-bg)' %>;
  --history-radius:var(--enterprise-radius-lg,16px);
  --history-radius-sm:var(--enterprise-radius-md,10px);
  --history-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace;
  color-scheme:light;
}
html[data-theme="dark"]{
  --history-bg:var(--enterprise-bg,#0d131c);
  --history-surface:var(--enterprise-surface,#141c27);
  --history-surface-subtle:var(--enterprise-surface-subtle,#101722);
  --history-surface-raised:var(--enterprise-surface-raised,#182230);
  --history-border:var(--enterprise-border,#293646);
  --history-border-strong:var(--enterprise-border-strong,#3a4a5d);
  --history-text:var(--enterprise-text,#edf2f7);
  --history-text-muted:var(--enterprise-text-muted,#b0bcc9);
  --history-text-subtle:var(--enterprise-text-subtle,#8794a3);
  --history-shadow:var(--enterprise-shadow-md,0 18px 42px rgba(0,0,0,.24));
  --history-success:var(--enterprise-success,#3ac58a);
  --history-warning:var(--enterprise-warning,#f0b34f);
  --history-danger:var(--enterprise-danger,#ff7185);
  --history-info:var(--enterprise-info,#ad9cff);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body.enterprise-shell.history-page{
  min-height:100vh;
  margin:0;
  background:var(--history-page-background);
  color:var(--history-text);
  font-family:var(--enterprise-font-sans,'Inter',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);
  font-size:14px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
button,a{-webkit-tap-highlight-color:transparent}
button{font:inherit}
:focus-visible{outline:3px solid color-mix(in srgb,var(--history-accent) 32%,transparent);outline-offset:3px}
.history-skip-link{position:fixed;top:10px;left:10px;z-index:1000;padding:10px 14px;border-radius:8px;background:var(--history-text);color:var(--history-surface);font-weight:700;text-decoration:none;transform:translateY(-160%);transition:transform .15s}
.history-skip-link:focus{transform:translateY(0)}
.history-header{position:sticky;top:0;z-index:100;border-bottom:1px solid var(--history-border);background:color-mix(in srgb,var(--history-surface) 92%,transparent);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.history-header__inner{width:min(1180px,calc(100% - 40px));min-height:72px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:18px}
.history-brand{display:inline-flex;align-items:center;gap:11px;min-width:0;width:max-content;color:var(--history-text);text-decoration:none;border-radius:10px}
.history-brand__mark{--brand-logo-size:<%= logoSize %>px;width:var(--brand-logo-size);height:var(--brand-logo-size);max-width:46px;max-height:46px;min-width:34px;min-height:34px;display:grid;place-items:center;overflow:hidden;border:1px solid color-mix(in srgb,var(--history-accent) 24%,var(--history-border));border-radius:11px;background:color-mix(in srgb,var(--history-accent) 10%,var(--history-surface));color:var(--history-accent);font-size:16px;font-weight:750;letter-spacing:-.02em;flex:0 0 auto}
.history-brand__mark img{display:block;width:100%;height:100%;object-fit:contain}
.history-brand__copy{min-width:0;display:flex;flex-direction:column;line-height:1.2}
.history-brand__name{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:750;letter-spacing:-.01em}
.history-brand__context{margin-top:3px;color:var(--history-text-subtle);font-size:11px;font-weight:550}
.history-nav{display:flex;align-items:center;justify-content:center;gap:4px;padding:4px;border:1px solid var(--history-border);border-radius:10px;background:var(--history-surface-subtle)}
.history-nav__link{padding:7px 11px;border-radius:7px;color:var(--history-text-muted);font-size:12px;font-weight:650;text-decoration:none;white-space:nowrap;transition:background-color .15s,color .15s,box-shadow .15s}
.history-nav__link:hover{color:var(--history-text);background:var(--history-surface)}
.history-nav__link[aria-current="page"]{color:var(--history-text);background:var(--history-surface);box-shadow:0 1px 3px rgba(15,23,42,.08)}
.history-header__actions{display:flex;align-items:center;justify-content:flex-end;gap:8px}
.history-icon-button{width:38px;height:38px;display:inline-grid;place-items:center;border:1px solid var(--history-border);border-radius:9px;background:var(--history-surface);color:var(--history-text-muted);cursor:pointer;text-decoration:none;transition:border-color .15s,background-color .15s,color .15s}
.history-icon-button:hover{border-color:var(--history-border-strong);background:var(--history-surface-subtle);color:var(--history-text)}
.history-icon-button svg{width:17px;height:17px}
.history-theme-icon--sun{display:none}
html[data-theme="dark"] .history-theme-icon--sun{display:block}
html[data-theme="dark"] .history-theme-icon--moon{display:none}
.history-main{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:38px 0 72px}
.enterprise-card{background:var(--history-surface);border:1px solid var(--history-border);border-radius:var(--history-radius);box-shadow:0 1px 2px rgba(15,23,42,.025)}
.history-hero{position:relative;overflow:hidden;padding:34px 36px 0;border-top:4px solid var(--history-accent);box-shadow:var(--history-shadow)}
.history-hero::after{content:"";position:absolute;right:-90px;top:-120px;width:300px;height:300px;border-radius:50%;background:color-mix(in srgb,var(--history-accent) 7%,transparent);pointer-events:none}
.history-hero__body{position:relative;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:32px;padding-bottom:30px}
.history-eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 12px;color:var(--history-accent);font-size:11px;font-weight:750;letter-spacing:.09em;text-transform:uppercase}
.history-eyebrow svg{width:15px;height:15px}
.history-hero h1{max-width:680px;margin:0;color:var(--history-text);font-size:clamp(30px,4vw,46px);line-height:1.08;letter-spacing:-.04em}
.history-hero__description{max-width:680px;margin:13px 0 0;color:var(--history-text-muted);font-size:15px;line-height:1.65}
.history-hero__actions{display:flex;flex:0 0 auto;align-items:center;gap:9px;padding-top:27px}
.enterprise-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 14px;border:1px solid var(--history-border);border-radius:9px;background:var(--history-surface);color:var(--history-text);font-size:12px;font-weight:700;text-decoration:none;cursor:pointer;transition:transform .15s,border-color .15s,background-color .15s,color .15s}
.enterprise-button:hover{border-color:var(--history-border-strong);background:var(--history-surface-subtle);transform:translateY(-1px)}
.enterprise-button svg{width:15px;height:15px}
.enterprise-button--primary{border-color:var(--history-accent);background:var(--history-accent);color:#fff}
.enterprise-button--primary:hover{border-color:color-mix(in srgb,var(--history-accent) 86%,#000);background:color-mix(in srgb,var(--history-accent) 86%,#000);color:#fff}
.enterprise-kpi-grid.history-summary{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0 -36px;border-top:1px solid var(--history-border);background:var(--history-surface-subtle)}
.enterprise-kpi.history-summary__item{min-width:0;padding:20px 26px;border-right:1px solid var(--history-border)}
.enterprise-kpi.history-summary__item:last-child{border-right:0}
.history-summary__item dt{color:var(--history-text-subtle);font-size:10px;font-weight:750;letter-spacing:.08em;text-transform:uppercase}
.history-summary__item dd{margin:4px 0 0;color:var(--history-text);font-size:26px;font-weight:750;line-height:1.15;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.history-summary__item dd.history-summary__note{display:block;min-width:0;margin:4px 0 0;overflow:hidden;color:var(--history-text-muted);font-size:11px;font-weight:500;line-height:1.35;letter-spacing:0;text-overflow:ellipsis;white-space:nowrap}
.history-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;align-items:start;gap:24px;margin-top:28px}
.history-feed{min-width:0}
.history-section{scroll-margin-top:96px;margin-bottom:28px}
.history-section[hidden]{display:none}
.history-section__header{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:12px;padding:0 2px}
.history-section__eyebrow{margin:0 0 4px;color:var(--history-text-subtle);font-size:10px;font-weight:750;letter-spacing:.09em;text-transform:uppercase}
.history-section__title{margin:0;color:var(--history-text);font-size:20px;line-height:1.25;letter-spacing:-.025em}
.history-section__description{margin:5px 0 0;color:var(--history-text-muted);font-size:12px}
.history-count{flex:0 0 auto;padding:4px 9px;border:1px solid var(--history-border);border-radius:999px;background:var(--history-surface);color:var(--history-text-muted);font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}
.incident{scroll-margin-top:96px;margin-bottom:14px;overflow:hidden}
.incident.open{border-color:color-mix(in srgb,var(--history-danger) 38%,var(--history-border));box-shadow:inset 3px 0 0 var(--history-danger)}
.inc-head{padding:22px 24px 18px;border-bottom:1px solid var(--history-border)}
.inc-head__top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.inc-title{display:flex;align-items:flex-start;gap:12px;min-width:0}
.inc-title__marker{width:11px;height:11px;margin-top:6px;border:3px solid color-mix(in srgb,var(--history-success) 30%,transparent);border-radius:50%;background:var(--history-success);box-shadow:0 0 0 3px color-mix(in srgb,var(--history-success) 11%,transparent);flex:0 0 auto}
.incident.open .inc-title__marker{border-color:color-mix(in srgb,var(--history-danger) 30%,transparent);background:var(--history-danger);box-shadow:0 0 0 3px color-mix(in srgb,var(--history-danger) 11%,transparent)}
.inc-title h2{min-width:0;margin:0;color:var(--history-text);font-size:17px;font-weight:750;line-height:1.4;letter-spacing:-.015em}
.badges{display:flex;flex:0 0 auto;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:6px}
.enterprise-badge,.badge{display:inline-flex;align-items:center;min-height:24px;padding:3px 8px;border:1px solid var(--history-border);border-radius:999px;background:var(--history-surface-subtle);color:var(--history-text-muted);font-size:9px;font-weight:750;letter-spacing:.055em;text-transform:uppercase;white-space:nowrap}
.badge.status-investigating{border-color:color-mix(in srgb,var(--history-danger) 28%,var(--history-border));background:color-mix(in srgb,var(--history-danger) 9%,var(--history-surface));color:var(--history-danger)}
.badge.status-identified{border-color:color-mix(in srgb,var(--history-warning) 30%,var(--history-border));background:color-mix(in srgb,var(--history-warning) 9%,var(--history-surface));color:var(--history-warning)}
.badge.status-monitoring{border-color:color-mix(in srgb,var(--history-info) 30%,var(--history-border));background:color-mix(in srgb,var(--history-info) 9%,var(--history-surface));color:var(--history-info)}
.badge.status-resolved{border-color:color-mix(in srgb,var(--history-success) 30%,var(--history-border));background:color-mix(in srgb,var(--history-success) 9%,var(--history-surface));color:var(--history-success)}
.badge.impact-major{border-color:color-mix(in srgb,var(--history-warning) 26%,var(--history-border));color:var(--history-warning)}
.badge.impact-critical{border-color:color-mix(in srgb,var(--history-danger) 26%,var(--history-border));color:var(--history-danger)}
.inc-meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:15px;color:var(--history-text-muted);font-size:11px}
.inc-meta span{display:inline-flex;align-items:center;gap:5px}
.inc-meta strong{color:var(--history-text);font-weight:650}
.updates{margin:0;padding:16px 24px 21px;list-style:none}
.update{position:relative;margin-left:6px;padding:9px 0 13px 29px;border-left:1px solid var(--history-border)}
.update:last-child{padding-bottom:2px}
.update::before{content:"";position:absolute;left:-5px;top:14px;width:9px;height:9px;border:2px solid var(--history-surface);border-radius:50%;background:var(--history-text-subtle);box-shadow:0 0 0 1px var(--history-border)}
.update.investigating::before{background:var(--history-danger)}
.update.identified::before{background:var(--history-warning)}
.update.monitoring::before{background:var(--history-info)}
.update.resolved::before{background:var(--history-success)}
.update-head{display:flex;align-items:baseline;flex-wrap:wrap;gap:7px 11px;margin-bottom:5px}
.update-status{font-size:10px;font-weight:750;letter-spacing:.065em;text-transform:uppercase}
.update-status.investigating{color:var(--history-danger)}
.update-status.identified{color:var(--history-warning)}
.update-status.monitoring{color:var(--history-info)}
.update-status.resolved{color:var(--history-success)}
.update-time{color:var(--history-text-subtle);font-family:var(--history-mono);font-size:10px}
.update-msg{color:var(--history-text-muted);font-size:13px;line-height:1.65;overflow-wrap:anywhere;white-space:pre-wrap}
.update-empty{padding:8px 0;color:var(--history-text-muted);font-size:12px}
.maintenance{scroll-margin-top:96px;margin-bottom:14px;padding:21px 23px;border-left:3px solid var(--history-warning)}
.maintenance.in-progress{border-left-color:var(--history-accent)}
.maintenance.completed{border-left-color:var(--history-success)}
.maintenance-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.maintenance-title{margin:0;color:var(--history-text);font-size:16px;font-weight:750;line-height:1.4;letter-spacing:-.015em}
.maintenance-status{display:inline-flex;align-items:center;flex:0 0 auto;padding:4px 8px;border:1px solid color-mix(in srgb,var(--history-warning) 28%,var(--history-border));border-radius:999px;background:color-mix(in srgb,var(--history-warning) 9%,var(--history-surface));color:var(--history-warning);font-size:9px;font-weight:750;letter-spacing:.055em;text-transform:uppercase;white-space:nowrap}
.maintenance.in-progress .maintenance-status{border-color:color-mix(in srgb,var(--history-accent) 28%,var(--history-border));background:color-mix(in srgb,var(--history-accent) 9%,var(--history-surface));color:var(--history-accent)}
.maintenance.completed .maintenance-status{border-color:color-mix(in srgb,var(--history-success) 28%,var(--history-border));background:color-mix(in srgb,var(--history-success) 9%,var(--history-surface));color:var(--history-success)}
.maintenance-notes{margin-top:10px;color:var(--history-text-muted);font-size:13px;line-height:1.65;overflow-wrap:anywhere;white-space:pre-wrap}
.maintenance-meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:14px;padding-top:14px;border-top:1px solid var(--history-border);color:var(--history-text-muted);font-size:11px}
.maintenance-meta strong{color:var(--history-text);font-weight:650}
.empty{display:grid;justify-items:center;gap:10px;padding:42px 24px;text-align:center;color:var(--history-text-muted)}
.empty__icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--history-border);border-radius:10px;background:var(--history-surface-subtle);color:var(--history-text-subtle)}
.empty__icon svg{width:19px;height:19px}
.empty strong{color:var(--history-text);font-size:14px}
.empty p{max-width:430px;margin:0;font-size:12px;line-height:1.6}
.empty--error .empty__icon{color:var(--history-danger)}
.skeleton{height:180px;overflow:hidden;position:relative}
.skeleton::before{content:"";position:absolute;inset:20px;background:linear-gradient(var(--history-border) 0 0) 0 0/56% 15px no-repeat,linear-gradient(var(--history-border) 0 0) 0 34px/82% 9px no-repeat,linear-gradient(var(--history-border) 0 0) 0 55px/66% 9px no-repeat,linear-gradient(var(--history-border) 0 0) 0 96px/92% 8px no-repeat;opacity:.68}
.skeleton::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--history-surface) 62%,transparent),transparent);animation:historyShimmer 1.4s infinite}
@keyframes historyShimmer{100%{transform:translateX(100%)}}
.history-sidebar{position:sticky;top:100px;display:grid;gap:14px}
.history-panel{padding:20px}
.history-panel__eyebrow{margin:0 0 4px;color:var(--history-text-subtle);font-size:10px;font-weight:750;letter-spacing:.08em;text-transform:uppercase}
.history-panel h2{margin:0;color:var(--history-text);font-size:15px;letter-spacing:-.015em}
.history-panel__description{margin:7px 0 16px;color:var(--history-text-muted);font-size:11px;line-height:1.55}
.history-sidebar .enterprise-resource-grid{display:grid;grid-template-columns:1fr;gap:8px}
.enterprise-resource-link{display:grid;grid-template-columns:34px minmax(0,1fr) 16px;align-items:center;gap:10px;padding:10px;border:1px solid var(--history-border);border-radius:10px;background:var(--history-surface-subtle);text-decoration:none;transition:border-color .15s,background-color .15s,transform .15s}
.history-page .enterprise-resource-link::after{display:none}
.enterprise-resource-link:hover{border-color:var(--history-border-strong);background:var(--history-surface);transform:translateY(-1px)}
.history-resource__icon{width:34px;height:34px;display:grid;place-items:center;border-radius:8px;background:var(--history-surface);color:var(--history-accent)}
.history-resource__icon svg,.history-resource__arrow{width:15px;height:15px}
.history-resource__copy{min-width:0}
.history-resource__title{display:block;color:var(--history-text);font-size:11px;font-weight:700}
.history-resource__detail{display:block;margin-top:2px;overflow:hidden;color:var(--history-text-subtle);font-size:10px;text-overflow:ellipsis;white-space:nowrap}
.history-resource__arrow{color:var(--history-text-subtle)}
.history-footer{border-top:1px solid var(--history-border);background:var(--history-surface)}
.history-footer__inner{width:min(1180px,calc(100% - 40px));min-height:72px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:18px;color:var(--history-text-subtle);font-size:11px}
.history-footer__links{display:flex;align-items:center;flex-wrap:wrap;gap:6px 14px}
.history-footer a{color:var(--history-text-muted);text-decoration:none}
.history-footer a:hover{color:var(--history-text);text-decoration:underline;text-underline-offset:3px}
@media(max-width:960px){
  .history-layout{grid-template-columns:1fr}
  .history-sidebar{position:static;grid-template-columns:1fr}
  .history-sidebar .enterprise-resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:760px){
  .history-header__inner{width:min(100% - 28px,1180px);grid-template-columns:minmax(0,1fr) auto;gap:9px;padding:10px 0}
  .history-nav{grid-column:1/-1;grid-row:2;width:100%}
  .history-nav__link{flex:1;text-align:center}
  .history-brand__context{display:none}
  .history-main{width:min(100% - 28px,1180px);padding-top:24px}
  .history-hero{padding:26px 22px 0}
  .history-hero__body{display:block;padding-bottom:24px}
  .history-hero__actions{padding-top:20px}
  .enterprise-kpi-grid.history-summary{grid-template-columns:repeat(2,minmax(0,1fr));margin:0 -22px}
  .enterprise-kpi.history-summary__item:nth-child(2){border-right:0}
  .enterprise-kpi.history-summary__item:nth-child(-n+2){border-bottom:1px solid var(--history-border)}
  .history-footer__inner{width:min(100% - 28px,1180px)}
}
@media(max-width:520px){
  .history-header__inner{width:min(100% - 20px,1180px)}
  .history-brand__name{max-width:170px;font-size:13px}
  .history-brand__mark{max-width:38px;max-height:38px}
  .history-main{width:min(100% - 20px,1180px);padding-bottom:50px}
  .history-hero{padding:22px 18px 0}
  .history-hero h1{font-size:30px}
  .history-hero__actions{display:grid;grid-template-columns:1fr 1fr}
  .enterprise-kpi-grid.history-summary{margin:0 -18px}
  .enterprise-kpi.history-summary__item{padding:17px 18px}
  .history-layout{gap:20px;margin-top:22px}
  .history-section__header{align-items:center}
  .inc-head{padding:19px 18px 16px}
  .inc-head__top,.maintenance-head{display:block}
  .badges{justify-content:flex-start;margin-top:12px}
  .inc-meta{display:grid;gap:7px}
  .updates{padding:14px 18px 19px}
  .maintenance{padding:18px}
  .maintenance-status{margin-top:11px}
  .history-sidebar .enterprise-resource-grid{grid-template-columns:1fr}
  .history-footer__inner{width:min(100% - 20px,1180px);padding:18px 0;align-items:flex-start;flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
</style>
</head>
<body class="enterprise-shell history-page">
<a class="history-skip-link" href="#history-main">Skip to status history</a>

<header class="enterprise-header history-header">
  <div class="history-header__inner">
    <a class="history-brand" href="<%= dashboardUrl %>" aria-label="<%= groupName %> current status">
      <span class="history-brand__mark" aria-hidden="true">
        <% if (logoImage) { %>
          <img src="<%= logoImage %>" alt="">
        <% } else { %>
          <%= logoText || groupName.charAt(0).toUpperCase() %>
        <% } %>
      </span>
      <span class="history-brand__copy">
        <span class="history-brand__name"><%= groupName %></span>
        <span class="history-brand__context">Service status center</span>
      </span>
    </a>

    <nav class="history-nav" aria-label="Status navigation">
      <a class="history-nav__link" href="<%= dashboardUrl %>">Current status</a>
      <a class="history-nav__link" href="<%= dashboardUrl === '/' ? '/incidents' : dashboardUrl + '/incidents' %>" aria-current="page">Status history</a>
    </nav>

    <div class="history-header__actions">
      <a class="enterprise-icon-button history-icon-button" href="<%= feedUrl %>" type="application/rss+xml" aria-label="Open RSS status feed" title="RSS status feed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8"/><path d="M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <button class="enterprise-icon-button history-icon-button" id="historyThemeToggle" type="button" data-enterprise-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
        <svg class="history-theme-icon--moon" data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
        <svg class="history-theme-icon--sun" data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<main class="history-main" id="history-main">
  <section class="enterprise-card history-hero" aria-labelledby="history-title">
    <div class="history-hero__body">
      <div>
        <p class="history-eyebrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
          Service transparency
        </p>
        <h1 id="history-title">Status history</h1>
        <p class="history-hero__description">Review public incident updates and planned maintenance activity for <%= groupName %>.</p>
      </div>
      <div class="history-hero__actions" aria-label="Status history actions">
        <a class="enterprise-button enterprise-button--primary" href="<%= dashboardUrl %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          Current status
        </a>
        <a class="enterprise-button enterprise-button--secondary" href="<%= feedUrl %>" type="application/rss+xml">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8"/><path d="M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1" fill="currentColor" stroke="none"/></svg>
          RSS feed
        </a>
      </div>
    </div>

    <dl class="enterprise-kpi-grid history-summary" aria-label="Status history summary" aria-live="polite">
      <div class="enterprise-kpi history-summary__item">
        <dt>Active incidents</dt>
        <dd id="summaryActive">—</dd>
        <dd class="history-summary__note" id="summaryActiveNote">Loading incident feed</dd>
      </div>
      <div class="enterprise-kpi history-summary__item">
        <dt>Past incidents</dt>
        <dd id="summaryPast">—</dd>
        <dd class="history-summary__note" id="summaryPastNote">Loading history</dd>
      </div>
      <div class="enterprise-kpi history-summary__item">
        <dt>Maintenance records</dt>
        <dd id="summaryMaintenance">—</dd>
        <dd class="history-summary__note" id="summaryMaintenanceNote">Loading activity</dd>
      </div>
      <div class="enterprise-kpi history-summary__item">
        <dt>Timeline updates</dt>
        <dd id="summaryUpdates">—</dd>
        <dd class="history-summary__note" id="summaryUpdatesNote">Loading public updates</dd>
      </div>
    </dl>
  </section>

  <div class="history-layout">
    <div class="history-feed">
      <section class="history-section" id="openSection" aria-labelledby="open-heading" hidden>
        <div class="history-section__header">
          <div>
            <p class="history-section__eyebrow">Needs attention</p>
            <h2 class="history-section__title" id="open-heading">Active incidents</h2>
            <p class="history-section__description">Current issues and the latest public operator updates.</p>
          </div>
          <span class="history-count" id="openCount" aria-label="Active incident count">0</span>
        </div>
        <div id="openList"></div>
      </section>

      <section class="history-section" id="maintenanceSection" aria-labelledby="maintenance-heading" hidden>
        <div class="history-section__header">
          <div>
            <p class="history-section__eyebrow">Change calendar</p>
            <h2 class="history-section__title" id="maintenance-heading">Maintenance activity</h2>
            <p class="history-section__description">Scheduled, active, and recently completed service windows.</p>
          </div>
          <span class="history-count" id="maintenanceCount" aria-label="Maintenance record count">0</span>
        </div>
        <div id="maintenanceList"></div>
      </section>

      <section class="history-section" id="recentSection" aria-labelledby="recent-heading">
        <div class="history-section__header">
          <div>
            <p class="history-section__eyebrow">Incident archive</p>
            <h2 class="history-section__title" id="recent-heading">Past incidents</h2>
            <p class="history-section__description">Resolved incidents and their public update timelines.</p>
          </div>
          <span class="history-count" id="recentCount" aria-label="Past incident count">—</span>
        </div>
        <div id="recentList" aria-live="polite" aria-busy="true">
          <div class="enterprise-card skeleton" aria-hidden="true"></div>
          <span class="enterprise-visually-hidden">Loading incident history</span>
        </div>
      </section>
    </div>

    <aside class="history-sidebar" aria-label="Status resources">
      <section class="enterprise-card history-panel">
        <p class="history-panel__eyebrow">Resources</p>
        <h2>Stay informed</h2>
        <p class="history-panel__description">Use the live dashboard for current health or follow the public update feed.</p>
        <div class="enterprise-resource-grid">
          <a class="enterprise-resource-link" href="<%= dashboardUrl %>">
            <span class="history-resource__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-7 4 14 2-7h6"/></svg></span>
            <span class="history-resource__copy"><span class="history-resource__title">Current status</span><span class="history-resource__detail">Live service health</span></span>
            <svg class="history-resource__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a class="enterprise-resource-link" href="<%= feedUrl %>" type="application/rss+xml">
            <span class="history-resource__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 11a8 8 0 0 1 8 8"/><path d="M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1" fill="currentColor" stroke="none"/></svg></span>
            <span class="history-resource__copy"><span class="history-resource__title">RSS updates</span><span class="history-resource__detail">Follow incident changes</span></span>
            <svg class="history-resource__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <% if (privacyUrl) { %>
          <a class="enterprise-resource-link" href="<%= privacyUrl || '/privacy' %>">
            <span class="history-resource__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <span class="history-resource__copy"><span class="history-resource__title">Privacy</span><span class="history-resource__detail">Data and service policy</span></span>
            <svg class="history-resource__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <% } %>
          <% if (termsUrl) { %>
          <a class="enterprise-resource-link" href="<%= termsUrl || '/terms' %>">
            <span class="history-resource__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg></span>
            <span class="history-resource__copy"><span class="history-resource__title">Terms</span><span class="history-resource__detail">Service terms</span></span>
            <svg class="history-resource__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <% } %>
        </div>
      </section>
    </aside>
  </div>
</main>

<footer class="history-footer">
  <div class="history-footer__inner">
    <span><%= groupName %> service status</span>
    <nav class="history-footer__links" aria-label="Status footer">
      <a href="<%= dashboardUrl %>">Current status</a>
      <a href="<%= feedUrl %>" type="application/rss+xml">RSS feed</a>
      <a href="<%= privacyUrl || '/privacy' %>">Privacy</a>
      <a href="<%= termsUrl || '/terms' %>">Terms</a>
    </nav>
  </div>
</footer>

<script>
const GROUP_SLUG = <%- JSON.stringify(groupSlug) %>;

function escapeHtml(s) {
  return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function fmtDate(iso) {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return String(iso);
    return d.toLocaleString(undefined, { month:"short", day:"numeric", year:"numeric", hour:"numeric", minute:"2-digit" });
  } catch (_) { return String(iso); }
}

function fmtDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  if (s < 60) return s + "s";
  if (s < 3600) return Math.floor(s / 60) + "m " + (s % 60) + "s";
  if (s < 86400) {
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    return h + "h " + String(m).padStart(2, "0") + "m";
  }
  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600);
  return d + "d " + h + "h";
}

function statusToken(value, fallback) {
  const token = String(value || fallback || "").toLowerCase().replace(/[^a-z0-9_-]/g, "");
  return ["investigating", "identified", "monitoring", "resolved"].includes(token) ? token : fallback;
}

function impactToken(value) {
  const token = String(value || "minor").toLowerCase().replace(/[^a-z0-9_-]/g, "");
  return ["minor", "major", "critical"].includes(token) ? token : "minor";
}

function labelFor(value) {
  return String(value || "").replace(/[_-]+/g, " ").replace(/\b\w/g, char => char.toUpperCase());
}

function renderIncident(inc) {
  const isOpen = !inc.ended_at;
  const fallbackStatus = isOpen ? "investigating" : "resolved";
  const status = statusToken(inc.status, fallbackStatus);
  const impact = impactToken(inc.impact);
  const cause = inc.cause ? " — " + String(inc.cause).split(",")[0].trim() : "";
  const title = inc.title || String(inc.server_name || "Service incident") + cause;
  const incidentId = encodeURIComponent(inc.id);
  const updates = Array.isArray(inc.updates) ? inc.updates.slice().reverse() : [];
  const updatesHtml = updates.map(update => {
    const updateStatus = statusToken(update.status, status);
    return `
      <li class="update ${updateStatus}">
        <div class="update-head">
          <span class="update-status ${updateStatus}">${escapeHtml(labelFor(updateStatus))}</span>
          <time class="update-time" datetime="${escapeHtml(update.created_at)}">${escapeHtml(fmtDate(update.created_at))}</time>
        </div>
        <div class="update-msg">${escapeHtml(update.message)}</div>
      </li>`;
  }).join("");
  const durationHtml = inc.ended_at
    ? `<span><strong>Resolved in</strong> ${escapeHtml(fmtDuration(inc.duration_s))}</span>`
    : `<span><strong>Ongoing</strong> since ${escapeHtml(fmtDate(inc.started_at))}</span>`;

  return `
    <article class="enterprise-card incident ${isOpen ? "open" : ""}" id="incident-${incidentId}" aria-labelledby="incident-title-${incidentId}">
      <div class="inc-head">
        <div class="inc-head__top">
          <div class="inc-title">
            <span class="inc-title__marker" aria-hidden="true"></span>
            <h2 id="incident-title-${incidentId}">${escapeHtml(title)}</h2>
          </div>
          <div class="badges" aria-label="Incident classification">
            <span class="enterprise-badge badge status-${status}">${escapeHtml(labelFor(status))}</span>
            <span class="enterprise-badge badge impact-${impact}">${escapeHtml(labelFor(impact))} impact</span>
          </div>
        </div>
        <div class="inc-meta">
          <span><strong>Service</strong> ${escapeHtml(inc.server_name)}</span>
          <span><strong>Started</strong> <time datetime="${escapeHtml(inc.started_at)}">${escapeHtml(fmtDate(inc.started_at))}</time></span>
          ${durationHtml}
        </div>
      </div>
      <ol class="updates" aria-label="Incident update timeline">
        ${updatesHtml || '<li class="update-empty">No public timeline updates are available for this incident.</li>'}
      </ol>
    </article>`;
}

function formatMaintenanceRange(event) {
  const start = new Date(event.start_time);
  const end = new Date(event.end_time);
  if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return "Schedule unavailable";
  const sameDay = start.toDateString() === end.toDateString();
  const startText = start.toLocaleString(undefined, { month:"short", day:"numeric", year:"numeric", hour:"numeric", minute:"2-digit" });
  const endText = sameDay
    ? end.toLocaleTimeString(undefined, { hour:"numeric", minute:"2-digit" })
    : end.toLocaleString(undefined, { month:"short", day:"numeric", year:"numeric", hour:"numeric", minute:"2-digit" });
  return `${startText} – ${endText}`;
}

function renderMaintenance(event) {
  const inProgress = event.status === "in_progress";
  const completed = event.status === "completed";
  const services = Array.isArray(event.services) ? event.services.map(service => service.name).join(", ") : "";
  const maintenanceId = encodeURIComponent(event.id);
  return `
    <article class="enterprise-card maintenance ${inProgress ? "in-progress" : completed ? "completed" : ""}" id="maintenance-${maintenanceId}" aria-labelledby="maintenance-title-${maintenanceId}">
      <div class="maintenance-head">
        <h2 class="maintenance-title" id="maintenance-title-${maintenanceId}">${escapeHtml(event.title)}</h2>
        <span class="maintenance-status">${inProgress ? "In progress" : completed ? "Completed" : "Scheduled"}</span>
      </div>
      ${event.notes ? `<div class="maintenance-notes">${escapeHtml(event.notes)}</div>` : ""}
      <div class="maintenance-meta">
        <span><strong>Window:</strong> ${escapeHtml(formatMaintenanceRange(event))}</span>
        <span><strong>Affected:</strong> ${escapeHtml(services || "Services on this dashboard")}</span>
      </div>
    </article>`;
}

function setSummary(id, value, note) {
  const valueElement = document.getElementById(id);
  const noteElement = document.getElementById(id + "Note");
  if (valueElement) valueElement.textContent = value;
  if (noteElement) noteElement.textContent = note;
}

function countLabel(count, singular, plural) {
  return count === 1 ? singular : plural;
}

function scrollToHashTarget() {
  if (!window.location.hash) return;
  let id;
  try { id = decodeURIComponent(window.location.hash.slice(1)); }
  catch (_) { id = window.location.hash.slice(1); }
  requestAnimationFrame(() => {
    const target = document.getElementById(id);
    if (target) {
      const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior:reduceMotion ? "auto" : "smooth", block:"start" });
    }
  });
}

async function loadMaintenance() {
  try {
    const response = await fetch(`/api/public/group/${encodeURIComponent(GROUP_SLUG)}/maintenance?include=recent`);
    if (!response.ok) throw new Error("Failed to load maintenance");
    const data = await response.json();
    const events = Array.isArray(data) ? data : [];
    setSummary("summaryMaintenance", String(events.length), events.length ? "Maintenance timeline" : "No maintenance records");
    if (events.length) {
      document.getElementById("maintenanceList").innerHTML = events.map(renderMaintenance).join("");
      document.getElementById("maintenanceCount").textContent = String(events.length);
      document.getElementById("maintenanceSection").hidden = false;
      scrollToHashTarget();
    }
  } catch (_) {
    setSummary("summaryMaintenance", "—", "Maintenance feed unavailable");
    // Incident history remains useful if the optional maintenance feed fails.
  }
}

async function loadIncidents() {
  const recentList = document.getElementById("recentList");
  try {
    const response = await fetch(`/api/public/group/${encodeURIComponent(GROUP_SLUG)}/incidents`);
    if (!response.ok) throw new Error("Failed to load");
    const data = await response.json();
    const open = Array.isArray(data.open) ? data.open : [];
    const recent = Array.isArray(data.recent) ? data.recent : [];
    const timelineUpdates = [...open, ...recent].reduce((count, incident) => count + (Array.isArray(incident.updates) ? incident.updates.length : 0), 0);

    setSummary("summaryActive", String(open.length), open.length ? countLabel(open.length, "Open incident", "Open incidents") : "No open incident records");
    setSummary("summaryPast", String(recent.length), countLabel(recent.length, "Historical record", "Historical records"));
    setSummary("summaryUpdates", String(timelineUpdates), countLabel(timelineUpdates, "Public timeline entry", "Public timeline entries"));

    document.getElementById("openCount").textContent = String(open.length);
    document.getElementById("recentCount").textContent = String(recent.length);
    if (open.length) {
      document.getElementById("openList").innerHTML = open.map(renderIncident).join("");
      document.getElementById("openSection").hidden = false;
    } else {
      document.getElementById("openSection").hidden = true;
    }

    if (recent.length) {
      recentList.innerHTML = recent.map(renderIncident).join("");
    } else {
      recentList.innerHTML = `
        <div class="enterprise-card empty">
          <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg></span>
          <strong>No past incidents</strong>
          <p>There are no resolved public incidents to display for this status page.</p>
        </div>`;
    }
    recentList.setAttribute("aria-busy", "false");
    scrollToHashTarget();
  } catch (_) {
    setSummary("summaryActive", "—", "Incident feed unavailable");
    setSummary("summaryPast", "—", "History unavailable");
    setSummary("summaryUpdates", "—", "Updates unavailable");
    document.getElementById("recentCount").textContent = "—";
    recentList.setAttribute("aria-busy", "false");
    recentList.innerHTML = `
      <div class="enterprise-card empty empty--error" role="alert">
        <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 17h.01"/></svg></span>
        <strong>Incident history is temporarily unavailable</strong>
        <p>Please refresh the page or try again in a moment.</p>
      </div>`;
  }
}

loadMaintenance();
loadIncidents();
</script>
</body>
</html>
