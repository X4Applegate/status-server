async function hydrateAdminOverview(){
  const [incidentsResult, maintenanceResult] = await Promise.allSettled([
    fetch("/api/admin/incidents").then(response => { if (!response.ok) throw new Error(`Incident request failed (${response.status})`); return response.json(); }),
    fetch("/api/admin/maintenance").then(response => { if (!response.ok) throw new Error(`Maintenance request failed (${response.status})`); return response.json(); })
  ]);
  overviewIncidents = incidentsResult.status === "fulfilled" && Array.isArray(incidentsResult.value) ? incidentsResult.value : null;
  overviewMaintenance = maintenanceResult.status === "fulfilled" && Array.isArray(maintenanceResult.value) ? maintenanceResult.value : null;
  liveServers = reconcileLiveMaintenanceFlags(liveServers, overviewMaintenance);
  renderSidebarList(liveServers);
  renderAdminOverview(liveServers);
}

