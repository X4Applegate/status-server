const MANAGEMENT_SETTING_SECTIONS = [
  ["setSmtpHost","Email delivery","SMTP and outbound alert email"],
  ["setTsEnabled","Login protection","Cloudflare Turnstile"],
  ["setGoEnabled","Google OAuth","Single sign-on configuration"],
  ["setMbToken","Private maps","Mapbox tiles for operators"],
  ["setWrEnabled","Weekly reports","Scheduled uptime summaries"],
  ["dangerMsg","Danger zone","History and destructive controls"],
];

function renderSettingsDirectory(){
  const directory = document.getElementById("adminPanelBody");
  const query = managementSearchValue();
  const sections = MANAGEMENT_SETTING_SECTIONS.filter(([, title, description]) => !query || `${title} ${description}`.toLowerCase().includes(query));
  document.getElementById("aCount").textContent = `${sections.length} section${sections.length === 1 ? "" : "s"}`;
  document.getElementById("managementDirectorySubtitle").textContent = query ? `${sections.length} of ${MANAGEMENT_SETTING_SECTIONS.length} sections` : "Platform configuration";
  if (!sections.length) {
    directory.innerHTML = `<div class="empty-state">No settings sections match this search.</div>`;
    return;
  }
  directory.innerHTML = `<nav class="management-section-nav" aria-label="Settings sections">${sections.map(([target,title,description], index) => `<button class="management-section-button${index === 0 ? " active" : ""}" type="button" data-settings-target="${_escHtml(target)}" onclick="scrollManagementSetting(this.dataset.settingsTarget,this)"><span class="record-row-title">${_escHtml(title)}</span><span class="record-row-meta">${_escHtml(description)}</span></button>`).join("")}</nav>`;
}

function scrollManagementSetting(targetId, button){
  document.querySelectorAll(".management-section-button").forEach(item => item.classList.toggle("active", item === button));
  const target = document.getElementById(targetId);
  target?.scrollIntoView({ behavior:"smooth", block:"center" });
  if (target && /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test(target.tagName)) target.focus({ preventScroll:true });
}

