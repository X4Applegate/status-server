  btn.setAttribute("aria-expanded", String(!isOpen));
}
function toggleTopbarMenu(e){
  e.stopPropagation();
  const right = document.getElementById("topbarRight");
  const btn   = document.getElementById("topbarHamburger");
  const isOpen = right.classList.contains("menu-open");
  right.classList.toggle("menu-open", !isOpen);
  btn.classList.toggle("open", !isOpen);
  btn.setAttribute("aria-expanded", String(!isOpen));
  btn.setAttribute("aria-label", !isOpen ? "Close menu" : "Open menu");
}
document.addEventListener("click", (e) => {
  // Close dashboards dropdown
  const popup = document.getElementById("topbarDashPopup");
  const dbtn  = document.getElementById("topbarDashBtn");
  if (popup) popup.classList.remove("open");
  if (dbtn)  { dbtn.classList.remove("open"); dbtn.setAttribute("aria-expanded", "false"); }
  // Close hamburger menu when clicking outside it
  const right = document.getElementById("topbarRight");
  const hbtn  = document.getElementById("topbarHamburger");
  if (right && hbtn && !right.contains(e.target) && !hbtn.contains(e.target)) {
    right.classList.remove("menu-open");
    hbtn.classList.remove("open");
    hbtn.setAttribute("aria-expanded", "false");
    hbtn.setAttribute("aria-label", "Open menu");
  }
});

document.addEventListener("keydown", event => {
  const activeLayer = document.querySelector(".confirm-overlay.open,.modal-overlay.open,.drawer.open");
  if (event.key === "Escape") {
    if (document.getElementById("confirmDlg")?.classList.contains("open")) closeConfirm();
    else if (document.getElementById("profileModal")?.classList.contains("open")) closeProfile();
    else if (document.getElementById("changePwdModal")?.classList.contains("open")) closeChangePassword();
    else if (activeDrawer === "adminDrawer") closeAdmin();
    else if (activeDrawer) closeDrawer(activeDrawer);
    else {
      document.getElementById("topbarDashPopup")?.classList.remove("open");
      document.getElementById("topbarDashBtn")?.classList.remove("open");
      document.getElementById("topbarDashBtn")?.setAttribute("aria-expanded", "false");
      document.getElementById("topbarRight")?.classList.remove("menu-open");
      document.getElementById("topbarHamburger")?.classList.remove("open");
      document.getElementById("topbarHamburger")?.setAttribute("aria-expanded", "false");
    }
    event.preventDefault();
    return;
  }
  if (event.key !== "Tab" || !activeLayer) return;
  const focusable = [...activeLayer.querySelectorAll('button:not([disabled]),[href],input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])')]
    .filter(element => element.getClientRects().length > 0);
  if (!focusable.length) return;
  const first = focusable[0];
  const last = focusable[focusable.length - 1];
  if (event.shiftKey && document.activeElement === first) { last.focus(); event.preventDefault(); }
  else if (!event.shiftKey && document.activeElement === last) { first.focus(); event.preventDefault(); }
});

