function managementMatches(record, fields){
  const query = managementSearchValue();
  if (!query) return true;
  return fields.some(field => {
    const value = typeof field === "function" ? field(record) : record?.[field];
    if (Array.isArray(value)) return value.some(item => String(item ?? "").toLowerCase().includes(query));
    return String(value ?? "").toLowerCase().includes(query);
  });
}

