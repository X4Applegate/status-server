// ── Drawer management ─────────────────────────────────────────────────────────
let activeDrawer = null;
let _panelScrollPoll = null;
let _drawerReturnFocus = null;
// Elements on the background page that could steal scroll events
const _bgScrollEls = () => document.querySelectorAll(".main, .sidebar-scroll, #mainArea");

function openDrawer(id){
  if (!activeDrawer) _drawerReturnFocus = document.activeElement;
  if (activeDrawer && activeDrawer !== id) {
    const previous = document.getElementById(activeDrawer);
    previous?.classList.remove("open");
    previous?.setAttribute("aria-hidden", "true");
  }
  activeDrawer = id;
  const drawer = document.getElementById(id);
  if (!drawer) return;
  drawer.classList.add("open");
  drawer.setAttribute("aria-hidden", "false");
  document.getElementById("sharedOverlay").classList.add("open");
  document.getElementById("sharedOverlay").setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
  // Freeze background scrollable areas so wheel events go straight to the drawer panel
  _bgScrollEls().forEach(el => el.style.overflow = "hidden");
  // Fire at key points during/after the CSS transition
  setTimeout(updatePanelScrollBtns, 150);
  setTimeout(updatePanelScrollBtns, 400);
  // Polling fallback: keep buttons in sync every 600ms while drawer is open
  if (_panelScrollPoll) clearInterval(_panelScrollPoll);
  _panelScrollPoll = setInterval(updatePanelScrollBtns, 600);
  setTimeout(() => drawer.querySelector(".drawer-close,button,[href],input,select,textarea")?.focus(), 30);
}
function closeDrawer(id){
  const drawer = document.getElementById(id);
  drawer?.classList.remove("open");
  drawer?.setAttribute("aria-hidden", "true");
  document.getElementById("sharedOverlay").classList.remove("open");
  document.getElementById("sharedOverlay").setAttribute("aria-hidden", "true");
  document.body.style.overflow = "";
  // Restore background scroll
  _bgScrollEls().forEach(el => el.style.overflow = "");
  activeDrawer = null;
  if (_panelScrollPoll) { clearInterval(_panelScrollPoll); _panelScrollPoll = null; }
  if (id === "adminDrawer") restoreAdminWorkspaceNav();
  const returnTarget = _drawerReturnFocus;
  _drawerReturnFocus = null;
  if (returnTarget && document.contains(returnTarget)) setTimeout(() => returnTarget.focus(), 0);
}
function closeAll(){ if (activeDrawer) closeDrawer(activeDrawer); }

function restoreAdminWorkspaceNav(){
  const target = currentAdminWorkspace === "management"
    ? document.querySelector(`[data-nav-tab="${currentTab}"]`)
    : document.querySelector(`[data-nav-view="${currentAdminWorkspace}"]`);
  setAdminNavActive(target);
}

// ── Log Drawer ────────────────────────────────────────────────────────────────
let logEntries = [], logFilter = "all", autoScroll = true, unread = 0;

function openLogs(){
  unread = 0;
  document.getElementById("logBadge").classList.remove("show");
  openDrawer("logDrawer");
  renderLogs();
}
function closeLogs(){ closeDrawer("logDrawer"); }
function setLF(f, el){
  logFilter = f;
  document.querySelectorAll(".filter-tab").forEach(t => t.classList.remove("active"));
  el.classList.add("active");
  renderLogs();
}
function toggleAS(){
  autoScroll = !autoScroll;
  document.getElementById("asTrk").classList.toggle("on", autoScroll);
}
function clearLogs(){ logEntries = []; renderLogs(); }

function addLog(e){
  logEntries.unshift(e);
  if (logEntries.length > 300) logEntries.pop();
  if (activeDrawer !== "logDrawer"){
    unread++;
    const b = document.getElementById("logBadge");
    b.textContent = unread > 99 ? "99+" : unread;
    b.classList.add("show");
  }
  if (activeDrawer === "logDrawer") renderLogs();
}

function renderLogs(){
  const body = document.getElementById("logBody");
  let list = [...logEntries];
  if (logFilter === "error")   list = list.filter(l => l.level === "error");
  if (logFilter === "changes") list = list.filter(l => l.isStatusChange);
  document.getElementById("logCount").textContent = `${list.length} entr${list.length === 1 ? "y" : "ies"}`;
  if (!list.length){
    body.innerHTML = `<div class="log-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${logFilter === "all" ? "Waiting for results..." : "No matching entries"}</div>`;
    return;
  }
  const fmt = ts => new Date(ts).toLocaleTimeString("en-US", {hour12:false, hour:"2-digit", minute:"2-digit", second:"2-digit"});
  body.innerHTML = list.map((e, i) => {
    let cls = "log-entry", ic = "o";
    if (e.isStatusChange)      { cls += " change"; ic = ">"; }
    else if (e.level === "error") { cls += " fail";   ic = "x"; }
    else if (e.server === "system") { cls += " sys";  ic = "*"; }
    else                          { cls += " ok";     ic = "+"; }
    if (i === 0) cls += " new-entry";
    return `<div class="${cls}"><span class="log-ts">${fmt(e.ts)}</span><span class="log-icon">${ic}</span><span class="log-server">${e.server||"system"}</span><span class="log-msg">${e.message||e.msg||""}</span></div>`;
  }).join("");
  if (autoScroll) body.scrollTop = 0;
}

// ── Status stream + sidebar/stats ────────────────────────────────────────────
function renderServers(servers){
  servers = reconcileLiveMaintenanceFlags(servers, overviewMaintenance);
  liveServers = servers;
  renderAdminOverview(servers);

  // Sidebar list
  renderSidebarList(servers);

  // Stats
  document.getElementById("sT").textContent = servers.length;
  document.getElementById("sU").textContent = servers.filter(s => s.overall === "up").length;
  document.getElementById("sD").textContent = servers.filter(s => s.overall === "down").length;
  document.getElementById("sW").textContent = servers.filter(s => s.overall === "degraded").length;
  document.getElementById("footTs").textContent = `Last check: ${new Date().toLocaleTimeString()}`;

  // Update map button visibility and re-render markers if map is open
  updateAdminMapBtn();
  if (_adminMapActive) _renderAdminMapMarkers();

  // Auto-select the first authorized service on first paint, or recover if the
  // selected service was removed or is no longer available to this user.
  const selectedStillAvailable = selectedServerId !== null && selectedServerId !== undefined
    ? servers.some(server => String(server.id) === String(selectedServerId))
    : false;
  if (!selectedStillAvailable && servers.length > 0) {
    selectedServerId = null;
    const cachedSelected = cacheGet("selected-id");
    const cachedServer = cachedSelected && servers.find(s => String(s.id) === String(cachedSelected));
    const initialId = cachedServer ? cachedServer.id : servers[0].id;
    selectServer(initialId);
    return;
  }
  if (!servers.length) {
    selectedServerId = null;
    cacheDel("selected-id");
    const main = document.getElementById("mainArea");
    if (main) main.innerHTML = `<div class="empty-main">No services configured yet</div>`;
    return;
  }

  // If currently-selected server's status changed, refresh the small status badge in detail view
  if (selectedServerId) {
    const s = servers.find(x => String(x.id) === String(selectedServerId));
    if (s) {
      const big = document.querySelector("#mainArea .status-big");
      if (big) {
        big.className = `status-big ${s.overall||"pending"}`;
        const lbl = big.querySelector(".status-big-label");
        if (lbl) lbl.textContent = s.overall==="up"?"Online":s.overall==="down"?"Offline":s.overall==="degraded"?"Degraded":"Pending";
        const tm = big.querySelector(".status-big-time");
        if (tm) tm.textContent = s.lastChecked ? `Last checked ${new Date(s.lastChecked).toLocaleTimeString()}` : "Not yet checked";
      }
    }
  }
}

function renderSidebarList(servers){
  const focusedServiceId = document.activeElement?.matches?.("#sidebarList .srv-row")
    ? document.activeElement.dataset.serviceId
    : null;
  const q = (document.getElementById("sidebarSearchInput")?.value || "").trim().toLowerCase();
  const list = q ? servers.filter(s =>
    (s.name        || "").toLowerCase().includes(q) ||
    (s.host        || "").toLowerCase().includes(q) ||
    (s.category    || "").toLowerCase().includes(q) ||
    (s.sub_category|| "").toLowerCase().includes(q) ||
    (s.description || "").toLowerCase().includes(q)
  ) : servers;
  const sidebar = document.getElementById("sidebarList");
  if (!sidebar) return;
  const count = document.getElementById("serviceDirectoryCount");
  if (count) {
    const nextCount = q
      ? `${list.length} of ${servers.length} services shown`
      : `${servers.length} monitored service${servers.length === 1 ? "" : "s"}`;
    if (count.textContent !== nextCount) count.textContent = nextCount;
  }
  if (!list.length) {
    sidebar.innerHTML = `<div class="service-directory-empty">${servers.length ? `No services match “${_escHtml(q)}”.` : "No services configured yet."}</div>`;
    return;
  }
  sidebar.innerHTML = list.map(s => {
    const lbl    = s.maintenance ? "MAINT" : (s.overall==="up"?"UP":s.overall==="down"?"DOWN":s.overall==="degraded"?"DEG":"PEND");
    const badgeCls = s.maintenance ? "pending" : (s.overall||"pending");
    const active = String(s.id) === String(selectedServerId);
    const maintTag = s.maintenance ? ` <span title="Under scheduled maintenance — alerts suppressed" style="font-size:10px">🔧</span>` : "";
    return `<button class="srv-row${active ? " active" : ""}" type="button" data-service-id="${_escHtml(s.id)}" onclick="selectServer(this.dataset.serviceId)"${active ? ` aria-current="true"` : ""}>
      <div class="srv-dot ${s.overall||'pending'}"></div>
      <div class="srv-row-info">
        <div class="srv-row-name">${_escHtml(s.name)}${maintTag}</div>
        <div class="srv-row-host">${_escHtml(s.host)}</div>
        ${s.description ? `<div class="srv-row-desc">${_escHtml(s.description)}</div>` : ""}
      </div>
      <div class="srv-badge ${badgeCls}">${lbl}</div>
    </button>`;
  }).join("");
  if (focusedServiceId !== null && focusedServiceId !== undefined) {
    const focusedRow = [...sidebar.querySelectorAll(".srv-row")]
      .find(row => String(row.dataset.serviceId) === String(focusedServiceId));
    focusedRow?.focus({ preventScroll:true });
  }
}

