async function submitUnifiForm() {
  const id = parseInt(document.getElementById("ufId").value) || null;
  const name = document.getElementById("ufName").value.trim();
  const base_url = document.getElementById("ufUrl").value.trim();
  const username = document.getElementById("ufUsername").value.trim();
  const password = document.getElementById("ufPassword").value;
  const api_key  = document.getElementById("ufApiKey").value;
  const verify_tls = document.getElementById("ufVerifyTls").checked;
  const group_ids = [...document.querySelectorAll("#ufGroupPicker input:checked")].map(el => parseInt(el.value));
