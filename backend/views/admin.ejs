.admin-kpi{display:flex;align-items:center;gap:11px;min-width:0;padding:5px 18px;border-left:1px solid var(--border)}
.admin-kpi:first-child{padding-left:0;border-left:0}.admin-kpi-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:7px;background:var(--surface2);color:var(--text-2)}
.admin-kpi-icon svg{width:16px;height:16px}.admin-kpi-value{font-size:19px;font-weight:750;color:var(--text-white);letter-spacing:-.03em}.admin-kpi-label{font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2)}
.admin-overview-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.75fr);gap:18px;margin-top:18px}
.ops-card{border:1px solid var(--border);border-radius:11px;background:var(--surface);overflow:hidden;box-shadow:0 1px 2px var(--shadow)}
.ops-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 17px;border-bottom:1px solid var(--border);background:var(--surface2)}
.ops-card-title{font-size:12px;font-weight:700;color:var(--text-hi)}.ops-card-meta{font-size:10px;color:var(--text-2)}
.ops-card-body{padding:8px}.attention-item{width:100%;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:11px;padding:11px;border:0;border-radius:8px;background:transparent;color:inherit;font-family:var(--sans);text-align:left;cursor:pointer}
.attention-item:hover{background:var(--surface2)}.attention-dot{width:8px;height:8px;border-radius:50%;background:var(--orange)}.attention-dot.down{background:var(--red)}.attention-dot.pending{background:var(--text-2)}
.attention-name,.attention-detail{display:block}.attention-name{color:var(--text-hi);font-size:12px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.attention-detail{margin-top:2px;color:var(--text-2);font-size:10px}.attention-state{font-size:9px;font-weight:750;letter-spacing:.05em;text-transform:uppercase;color:var(--orange)}
.ops-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:28px 18px;color:var(--text-2);font-size:12px;line-height:1.55}.ops-empty-icon{display:flex;align-items:center;justify-content:center;width:38px;height:38px;margin-bottom:10px;border-radius:50%;background:var(--green-soft);color:var(--green)}
.ops-list-row{width:100%;display:flex;align-items:flex-start;gap:11px;padding:11px;border:0;border-radius:8px;background:transparent;color:inherit;font-family:var(--sans);text-align:left;cursor:pointer}.ops-list-row:hover{background:var(--surface2)}.ops-list-icon{display:flex;align-items:center;justify-content:center;width:30px;height:30px;flex:none;border-radius:7px;background:var(--surface2);color:var(--text-2)}.ops-list-copy{min-width:0;flex:1}.ops-list-title,.ops-list-meta{display:block}.ops-list-title{font-size:12px;font-weight:650;color:var(--text-hi)}.ops-list-meta{margin-top:3px;color:var(--text-2);font-size:10px;line-height:1.45}
.quick-action-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.quick-action{display:flex;align-items:center;gap:9px;min-height:54px;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text-hi);font:650 11px var(--sans);text-align:left;cursor:pointer}.quick-action:hover{background:var(--surface2);border-color:var(--border-hi)}.quick-action svg{width:16px;height:16px;color:var(--blue)}
.admin-resources{margin-top:18px}.admin-resources-intro{padding:17px}.admin-resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:0 8px 8px}.admin-resource{display:flex;align-items:center;gap:11px;min-height:58px;padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text-hi);font-family:var(--sans);text-align:left;text-decoration:none;cursor:pointer}.admin-resource:hover{background:var(--surface2);border-color:var(--border-hi)}.admin-resource svg{width:17px;height:17px;color:var(--blue);flex:none}.admin-resource-title,.admin-resource-desc{display:block}.admin-resource-title{font-size:11px;font-weight:700}.admin-resource-desc{margin-top:2px;font-size:9px;color:var(--text-2);line-height:1.35}
.page-footer{display:none}
.admin-service-workspace .content{display:block;padding:0;overflow:visible;background:transparent}
.admin-map-view{top:68px}
.drawer{background:var(--bg2);border-color:var(--border-hi)}.drawer-overlay{background:rgba(0,0,0,.45)}
.drawer-header,.drawer-toolbar,.drawer-footer,.form-footer{background:var(--bg2);border-color:var(--border)}
.admin-tabs{gap:5px}.admin-tab{min-height:30px;border-radius:6px}.admin-tab.active{background:var(--surface2);border-color:var(--border-hi)}
.admin-server-item:hover,.user-item:hover{background:var(--surface2)}
.finput,.fselect,.modal-input{background:var(--input-bg);color:var(--text-white)}
@media(max-width:1100px){
  .admin-rail{width:220px;flex-basis:220px}.admin-overview-grid{grid-template-columns:1fr}.admin-resource-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:980px){
  .admin-service-layout{grid-template-columns:1fr}.admin-record-layout,.admin-management-layout{grid-template-columns:1fr}.service-directory,.record-directory,.management-directory{position:static;height:auto;min-height:0;max-height:none}.service-directory .sidebar-body,.record-directory-list,.management-directory #adminPanelBody{max-height:340px}.service-detail-panel,.record-detail{min-width:0}.admin-management-workspace.management-wide .admin-management-layout{grid-template-columns:1fr}.admin-management-workspace.management-wide .management-directory #adminPanelBody{max-height:260px}
}
@media(max-width:820px){
  .main-layout{display:block}.admin-rail{position:sticky;top:60px;width:auto;height:auto;display:flex;align-items:center;gap:6px;overflow-x:auto;overflow-y:hidden;border-right:0;border-bottom:1px solid var(--border);padding:10px 12px;scrollbar-width:none}.admin-rail::-webkit-scrollbar{display:none}.admin-rail-heading,.admin-nav-label{display:none}.admin-nav-section,.admin-nav-section:not(:first-of-type){display:contents;margin:0}.admin-nav-item{width:auto;flex:none;min-height:34px;padding:7px 10px}.admin-nav-item span:not(.admin-nav-item-badge){white-space:nowrap}.admin-workspace{padding:20px 14px 36px}.admin-page-heading{flex-direction:column}.admin-page-actions{justify-content:flex-start}.admin-kpi-grid{grid-template-columns:1fr 1fr}.admin-kpi:nth-child(3){padding-left:0;border-left:0;margin-top:12px}.admin-kpi:nth-child(4){margin-top:12px}.admin-resource-grid{grid-template-columns:1fr}.topbar{min-height:60px}.main-layout{min-height:calc(100vh - 60px)}
}
@media(max-width:520px){
  .brand-name{font-size:14px}.admin-page-title{font-size:27px}.admin-health-card{padding:18px 15px}.admin-health-top{display:block}.admin-health-state{margin-top:15px;white-space:normal}.admin-kpi{padding:7px 10px}.admin-kpi-icon{display:none}.admin-kpi-value{font-size:18px}.quick-action-grid{grid-template-columns:1fr}.admin-page-actions .btn{flex:1}.topbar-right.menu-open{left:10px;right:10px}.admin-nav-item svg{display:none}.admin-service-toolbar{align-items:flex-start;flex-direction:column}.record-directory-controls{grid-template-columns:1fr}.record-detail-head{display:block}.record-detail-actions{margin-top:14px;justify-content:flex-start}.record-facts{grid-template-columns:1fr}#mainArea .uptime-row{grid-template-columns:repeat(3,minmax(0,1fr))}#mainArea .uptime-card{min-width:0;padding:12px 4px}#mainArea .uptime-pct{font-size:clamp(17px,5vw,20px)}#mainArea .uptime-label{font-size:8px;white-space:nowrap}
}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="bg-glow"></div>
<div class="drawer-overlay" id="sharedOverlay" onclick="closeAll()" aria-hidden="true"></div>

<!-- Confirm dialog -->
<div class="confirm-overlay" id="confirmDlg" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" aria-hidden="true">
  <div class="confirm-box">
    <div class="confirm-title" id="confirmTitle">Are you sure?</div>
    <div class="confirm-msg" id="confirmMsg"></div>
    <div class="confirm-btns"><button class="btn" onclick="closeConfirm()">Cancel</button><button class="btn btn-danger" onclick="void(0)">Remove</button></div>
  </div>
</div>

<!-- Change Password Modal -->
<div class="modal-overlay" id="changePwdModal" role="dialog" aria-modal="true" aria-labelledby="changePwdTitle" aria-hidden="true">
  <div class="modal-box">
    <div class="modal-title" id="changePwdTitle">Change Password</div>
    <div class="modal-group"><label class="modal-label">Current Password</label><input class="modal-input" id="pwdCurrent" type="password" placeholder="Current password"></div>
    <div class="modal-group"><label class="modal-label">New Password</label><input class="modal-input" id="pwdNew" type="password" placeholder="Min 8 characters"></div>
    <div class="modal-group"><label class="modal-label">Confirm New Password</label><input class="modal-input" id="pwdConfirm" type="password" placeholder="Repeat new password"></div>
    <div class="modal-footer"><span class="modal-err" id="pwdErr"></span><button class="btn" onclick="closeChangePassword()">Cancel</button><button class="btn btn-primary" onclick="submitChangePassword()">Update</button></div>
  </div>
</div>

<!-- Profile Modal -->
<div class="modal-overlay" id="profileModal" role="dialog" aria-modal="true" aria-labelledby="profileTitle" aria-hidden="true">
  <div class="modal-box" style="max-width:420px">
    <div class="modal-title" id="profileTitle">My Profile</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
      <div class="modal-group" style="margin-bottom:0"><label class="modal-label">First Name</label><input class="modal-input" id="profFirstName" type="text" placeholder="First name" autocomplete="given-name"></div>
      <div class="modal-group" style="margin-bottom:0"><label class="modal-label">Last Name</label><input class="modal-input" id="profLastName" type="text" placeholder="Last name" autocomplete="family-name"></div>
    </div>
    <div class="modal-group"><label class="modal-label">Email <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(for password reset)</span></label><input class="modal-input" id="profEmail" type="email" placeholder="you@example.com" autocomplete="email"></div>
    <div class="modal-footer"><span class="modal-err" id="profErr"></span><button class="btn" onclick="closeProfile()">Cancel</button><button class="btn btn-primary" onclick="submitProfile()">Save</button></div>
  </div>
</div>

<div class="toast-stack" id="toasts"></div>

<!-- LOG DRAWER -->
<div class="drawer" id="logDrawer" role="dialog" aria-modal="true" aria-labelledby="logDrawerTitle" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-title" id="logDrawerTitle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>Check Logs</div>
    <button class="drawer-close" onclick="closeLogs()" aria-label="Close check logs">✕</button>
  </div>
  <div class="drawer-toolbar">
    <div class="filter-tabs"><button class="filter-tab active" onclick="setLF('all',this)">All</button><button class="filter-tab" onclick="setLF('error',this)">Errors</button><button class="filter-tab" onclick="setLF('changes',this)">Changes</button></div>
    <div class="drawer-spacer"></div>
    <div class="auto-scroll-toggle" onclick="toggleAS()"><div class="toggle-track on" id="asTrk"><div class="toggle-thumb"></div></div><span>Auto-scroll</span></div>
    <button class="clear-btn" onclick="clearLogs()">Clear</button>
  </div>
  <div class="drawer-body" style="padding:6px 0" id="logBody"><div class="log-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>Connecting to log stream...</div></div>
  <div class="drawer-footer"><span id="logCount">0 entries</span><div class="live-pill"><div class="live-dot"></div> Live</div></div>
</div>

<!-- ADMIN DRAWER -->
<div class="drawer" id="adminDrawer" role="dialog" aria-modal="true" aria-labelledby="adminDrawerTitle" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-title" id="adminDrawerTitle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg><span id="adminDrawerTitleText">Edit configuration</span></div>
    <button class="drawer-close" onclick="closeAdmin()" aria-label="Close editor">✕</button>
  </div>
  <div id="aListView" class="admin-section">
    <div class="drawer-toolbar">
      <div class="admin-tabs"><button class="admin-tab active" id="tabServers" onclick="switchTab('servers')">Servers</button><button class="admin-tab" id="tabGroups" onclick="switchTab('groups')">Groups</button><div class="admin-tab-group" id="tabNetCtrl"><button type="button" class="admin-tab" id="tabNetCtrlBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="tabNetCtrlMenu" onclick="toggleNetCtrl(event)">Network Controller &#9662;</button><div class="admin-tab-submenu" id="tabNetCtrlMenu" role="menu"><button type="button" role="menuitem" id="tabOmadaSub" onclick="switchTab('omada');closeNetCtrl()">Omada</button><button type="button" role="menuitem" id="tabUnifiSub" onclick="switchTab('unifi');closeNetCtrl()">UniFi</button></div></div><button id="tabOmada" style="display:none"></button><button id="tabUnifi" style="display:none"></button><button class="admin-tab" id="tabSquare" onclick="switchTab('square')">Square</button><button class="admin-tab" id="tabMaint" onclick="closeAdminToWorkspace('maintenance')">Maintenance</button><button class="admin-tab" id="tabIncidents" onclick="closeAdminToWorkspace('incidents')">Incidents</button><button class="admin-tab" id="tabBanners" onclick="switchTab('banners')">Banners</button><button class="admin-tab" id="tabApiKeys" onclick="switchTab('apikeys')">API Keys</button><button class="admin-tab" id="tabUsers" onclick="switchTab('users')">Users</button><button class="admin-tab" id="tabWebhooks" onclick="switchTab('webhooks')">Webhooks</button><button class="admin-tab" id="tabSettings" onclick="switchTab('settings')">Settings</button><button class="admin-tab" id="tabAudit" onclick="switchTab('audit')">Audit</button></div>
      <span style="font-size:11px;color:var(--text-2)" id="aCount"></span>
      <div class="drawer-spacer"></div>
      <button class="btn" id="importBtn" onclick="triggerImport()" style="font-size:11px;padding:5px 11px;display:none" title="Import servers from JSON">⬆ Import</button>
      <input type="file" id="importFileInput" accept=".json" style="display:none" onchange="handleImportFile(this)">
      <button class="btn" id="exportBtn" onclick="exportServers()" style="font-size:11px;padding:5px 11px;display:none" title="Export all servers to JSON">⬇ Export</button>
      <button class="btn btn-primary" id="addBtn" onclick="showServerForm(null)" style="font-size:11px;padding:5px 11px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg><span id="addBtnLabel">Add Server</span></button>
    </div>
    <div class="admin-management-layout">
      <aside class="management-directory" aria-labelledby="managementDirectoryTitle">
        <div class="record-directory-head">
          <div class="record-directory-title" id="managementDirectoryTitle">Records</div>
          <div class="record-directory-subtitle" id="managementDirectorySubtitle">Select a record to inspect and manage it.</div>
        </div>
        <div class="drawer-stat-bar" id="drawerStatBar">
          <div class="ss-card"><div class="ss-val" id="dT">—</div><div class="ss-lbl">Total</div></div>
          <div class="ss-card up"><div class="ss-val" id="dU">—</div><div class="ss-lbl">Up</div></div>
          <div class="ss-card down"><div class="ss-val" id="dD">—</div><div class="ss-lbl">Down</div></div>
          <div class="ss-card warn"><div class="ss-val" id="dW">—</div><div class="ss-lbl">Deg</div></div>
        </div>
        <div class="server-search-bar visible" id="serverSearchBar">
          <div class="server-search-wrap">
            <label class="enterprise-visually-hidden" for="serverSearchInput">Search records</label>
            <input class="server-search-input" id="serverSearchInput" type="search" placeholder="Search records…" autocomplete="off" oninput="onManagementSearch(this.value)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="serverSearchIcon" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <button class="server-search-clear" id="serverSearchClear" type="button" onclick="clearManagementSearch()" title="Clear search" aria-label="Clear search">&#x2715;</button>
          </div>
        </div>
        <div class="panel-scroll-wrap">
          <div class="drawer-body" id="adminPanelBody" aria-live="polite"></div>
          <button class="panel-scroll-btn panel-scroll-up" id="panelScrollUp" onclick="panelScrollStep(-1)" title="Scroll up" aria-label="Scroll records up">▲</button>
          <button class="panel-scroll-btn panel-scroll-dn" id="panelScrollDn" onclick="panelScrollStep(1)" title="Scroll down" aria-label="Scroll records down">▼</button>
        </div>
      </aside>
      <div class="record-detail admin-management-detail" id="adminManagementDetail" aria-live="polite">
        <div id="adminManagementDetailContent"><div class="record-empty">Select a record to view its details.</div></div>
        <div id="adminManagementAuxHost"></div>
      </div>
    </div>
    <div class="drawer-footer"><span>Changes save directly to MariaDB</span><span style="color:var(--blue);font-size:10px">Select a record for details</span></div>
  </div>
  <div id="aFormView" class="admin-section" style="display:none">
    <div class="drawer-body">
      <div class="form-wrap">
        <div class="form-heading" id="fHeading">Add Server</div>
        <input type="hidden" id="fId">
        <div class="form-grid">
          <div class="fg"><label class="flabel">Server Name *</label><input class="finput" id="fName" placeholder="e.g. Web Server"></div>
          <div class="fg"><label class="flabel">Host / IP *</label><input class="finput" id="fHost" placeholder="e.g. 10.0.0.2"></div>
          <div class="fg full">
            <label class="flabel">Location <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(address or place name — pins server on map view)</span></label>
            <div style="display:flex;gap:8px">
              <input class="finput" id="fAddress" placeholder="e.g. 1600 Pennsylvania Ave NW, Washington DC" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();geocodeAddress()}">
              <button type="button" class="btn" id="fGeoBtn" onclick="geocodeAddress()" style="flex-shrink:0;white-space:nowrap">Look up</button>
            </div>
            <div id="fGeoResult" style="margin-top:5px;font-size:11px;color:var(--text-2);min-height:16px"></div>
            <div id="fGeoList" style="display:none;margin-top:4px;border:1px solid var(--border-hi);border-radius:var(--r-sm);overflow:hidden"></div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <div style="flex:1"><label class="flabel" style="font-size:10px;margin-bottom:3px">Latitude</label>
                <input class="finput" id="fLat" placeholder="e.g. 47.6062" style="font-family:var(--mono);font-size:12px" oninput="onManualCoord()"></div>
              <div style="flex:1"><label class="flabel" style="font-size:10px;margin-bottom:3px">Longitude</label>
                <input class="finput" id="fLng" placeholder="e.g. -122.3321" style="font-family:var(--mono);font-size:12px" oninput="onManualCoord()"></div>
              <div style="display:flex;align-items:flex-end"><button type="button" class="btn btn-sm" onclick="clearCoords()" style="margin-bottom:0" title="Clear location">✕ Clear</button></div>
            </div>
          </div>
          <div class="fg full"><label class="flabel">Description</label><input class="finput" id="fDesc" placeholder="Short description"></div>
          <div class="fg full"><label class="flabel">Section <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(optional — groups servers under a heading on the dashboard)</span></label><input class="finput" id="fCategory" placeholder="e.g. Omada Network, DNS Servers" list="categoryHints"><datalist id="categoryHints"></datalist></div>
          <div class="fg full"><label class="flabel">Sub-section <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(optional — nested heading within the section above)</span></label><input class="finput" id="fSubCategory" placeholder="e.g. WiFi, Switching, Core" list="subCategoryHints"><datalist id="subCategoryHints"></datalist></div>
          <div class="fg full"><label class="flabel">Tags <span style="font-weight:400;text-transform:none;letter-spacing:0">(comma-separated)</span></label><input class="finput" id="fTags" placeholder="production, web, db"></div>
          <div class="fg"><label class="flabel">Poll Interval <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(seconds, min 10)</span></label>
            <select class="fselect" id="fInterval">
              <option value="20">20s (fast)</option>
              <option value="30" selected>30s (default)</option>
              <option value="60">1m</option>
              <option value="300">5m</option>
              <option value="600">10m</option>
            </select>
          </div>
          <div class="fg"><label class="flabel">Alert After <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(consecutive failed polls before alerting)</span></label>
            <select class="fselect" id="fThreshold">
              <option value="1" selected>1 failure (immediate)</option>
              <option value="2">2 failures</option>
              <option value="3">3 failures</option>
              <option value="4">4 failures</option>
              <option value="6">6 failures</option>
              <option value="10">10 failures</option>
            </select>
          </div>
          <div class="fg full"><label class="flabel">Dashboards <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)" id="fGroupsHint">(pick one or more — this server appears in each)</span></label>
            <div id="fGroupsPicker" style="background:var(--input-bg);border:1px solid var(--border-hi);border-radius:var(--r-sm);max-height:220px;overflow-y:auto;padding:8px"></div>
          </div>
          <div class="fg full checks-wrap"><div class="checks-head"><label class="flabel" style="margin:0">Health Checks</label><button class="btn" onclick="addCrow()" style="font-size:11px;padding:4px 10px">+ Add Check</button></div><div class="check-rows" id="crowContainer"></div></div>
