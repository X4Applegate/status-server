function managementDetailCard({ kicker, title, meta = "", actions = "", facts = "", body = "" }){
  return `<article class="record-detail-card">
    <header class="record-detail-head"><div><div class="record-detail-kicker">${_escHtml(kicker)}</div><h2 class="record-detail-title">${_escHtml(title || "Untitled")}</h2>${meta ? `<div class="record-detail-meta">${_escHtml(meta)}</div>` : ""}</div><div class="record-detail-actions">${actions}</div></header>
    <div class="record-detail-body">${facts ? `<div class="record-facts">${facts}</div>` : ""}${body}</div>
  </article>`;
}

function maskedDestination(value){
  const text = String(value || "");
  if (!text) return "Not configured";
  if (/^[^@\s]+@[^@\s]+$/.test(text)) {
    const [local, domain] = text.split("@");
    return `${local.slice(0, 2)}•••@${domain}`;
  }
  try {
    const url = new URL(text);
    return `${url.origin}/${url.pathname.split("/").filter(Boolean)[0] || "…"}/••••`;
  } catch (_) {
    return text.length > 10 ? `${text.slice(0, 6)}••••` : "••••";
  }
}

function safeExternalHref(value){
  try {
    const url = new URL(String(value || ""), window.location.origin);
    return ["http:","https:"].includes(url.protocol) ? url.href : "#";
  } catch (_) { return "#"; }
}

