// Tracks the in-form selection of allowed group ids for the user being edited
let userPickedGroups = new Set();

async function showUserForm(u){
  openAdminEditorDrawer("aUserFormView", u ? "Edit user" : "Add user");
  document.getElementById("aFormView").style.display     = "none";
  document.getElementById("aUserFormView").style.display = "flex";
  document.getElementById("uFormHeading").textContent    = u ? "Edit User" : "Add User";
  document.getElementById("uId").value       = u?.id       || "";
  document.getElementById("uName").value     = u?.username || "";
  document.getElementById("uRole").value     = u?.role     || "viewer";
  document.getElementById("uFirstName").value = u?.first_name || "";
  document.getElementById("uLastName").value  = u?.last_name  || "";
  document.getElementById("uEmail").value     = u?.email      || "";
  document.getElementById("uPassword").value = "";
  document.getElementById("uPwdHint").textContent = u ? "(leave blank to keep current)" : "(required)";
  document.getElementById("uErr").textContent = "";
  // Pre-select the user's existing allowed groups
  userPickedGroups = new Set(u?.allowed_group_ids || []);
  // Always fetch fresh groups so the picker reflects newly-created dashboards
  try {
    const r = await fetch("/api/admin/groups");
    if (r.ok) { adminGroups = await r.json(); cacheSet("admin-groups", adminGroups); }
  } catch(e) { /* fall back to cache */ }
  renderUserGroupsPicker();
  onUserRoleChange();
}

// Hide the Allowed Dashboards row when role=admin (admins see everything)
function onUserRoleChange(){
  const role = document.getElementById("uRole").value;
  document.getElementById("uGroupsRow").style.display = role === "admin" ? "none" : "block";
}

function renderUserGroupsPicker(){
  const el = document.getElementById("uGroupsPicker");
  if (!adminGroups.length) {
    el.innerHTML = `<div style="padding:14px;color:var(--text-2);font-size:12px;text-align:center">No dashboards yet. Create one in the Groups tab first.</div>`;
    return;
  }
  el.innerHTML = adminGroups.map(g => `
    <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12px;color:var(--text-hi)">
      <input type="checkbox" value="${g.id}" ${userPickedGroups.has(g.id) ? "checked" : ""} onchange="toggleUserGroup(${g.id}, this.checked)">
      <span style="flex:1">${_escHtml(g.name)} <span style="color:var(--text-2);font-size:11px">/dashboard/${_escHtml(g.slug)}</span></span>
    </label>
  `).join("");
}
function toggleUserGroup(id, on){
  if (on) userPickedGroups.add(id); else userPickedGroups.delete(id);
}

function showUserList(){ showList(); }

async function submitUserForm(){
  const id       = document.getElementById("uId").value;
  const username = document.getElementById("uName").value.trim();
  const role     = document.getElementById("uRole").value;
  const password = document.getElementById("uPassword").value;
  const err      = document.getElementById("uErr");
  if (!username)           { err.textContent = "Username required"; return; }
  if (!id && !password)    { err.textContent = "Password required for new users"; return; }
  const body = {
    username, role,
    first_name: document.getElementById("uFirstName").value.trim(),
    last_name:  document.getElementById("uLastName").value.trim(),
    email:      document.getElementById("uEmail").value.trim()
  };
  if (password) body.password = password;
  // Only attach allowed_group_ids when role=viewer (admins are always unrestricted)
  if (role === "viewer") body.allowed_group_ids = Array.from(userPickedGroups);
  try {
    const r = await fetch(id ? `/api/admin/users/${id}` : "/api/admin/users", {
      method: id ? "PUT" : "POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    const d = await r.json();
    if (!r.ok){ err.textContent = d.error || "Failed"; return; }
    cacheDel("admin-users");
    toast(id ? "User updated" : "User created", "success");
    showList();
  } catch(e){ err.textContent = "Error: " + e.message; }
}

function askDelUser(id){
  pendDelUser = id;
  const u = _userStore[id];
  document.getElementById("confirmMsg").textContent = `"${u?.username}" will be permanently deleted.`;
  openModalLayer("confirmDlg");
  document.querySelector("#confirmDlg .btn-danger").onclick = doDeleteUser;
}
async function doDeleteUser(){
  if (!pendDelUser) return;
  try {
    const r = await fetch(`/api/admin/users/${pendDelUser}`, {method:"DELETE"});
    const d = await r.json();
    if (r.ok) cacheDel("admin-users");
    toast(r.ok ? "User removed" : (d.error||"Failed"), r.ok ? "info" : "error");
  } catch(e){ toast("Error: "+e.message, "error"); }
  closeConfirm();
  loadUserList();
}

