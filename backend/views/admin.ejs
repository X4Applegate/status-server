async function submitWebhookForm(){
  const id   = document.getElementById("wId").value;
  const name = document.getElementById("wName").value.trim();
  const url  = document.getElementById("wUrl").value.trim();
  const err  = document.getElementById("wErr");
  if (!name || !url){ err.textContent = "Name and URL required"; return; }
  const isEmail = document.getElementById("wFormat").value === "email" || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(url);
  if (!isEmail && !/^https?:\/\//i.test(url)){ err.textContent = "URL must start with http:// or https://"; return; }
  if (isEmail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(url)){ err.textContent = "Please enter a valid email address"; return; }
  const groupSel = document.getElementById("wGroup").value;
  const body = {
    name, url,
    format:           document.getElementById("wFormat").value,
    enabled:          document.getElementById("wEnabled").checked,
    fire_on_down:     document.getElementById("wOnDown").checked,
    fire_on_recovery: document.getElementById("wOnRecovery").checked,
    group_id:         groupSel ? parseInt(groupSel) : null
  };
  try {
    const r = await fetch(id ? `/api/admin/webhooks/${id}` : "/api/admin/webhooks", {
      method: id ? "PUT" : "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    const d = await r.json();
    if (!r.ok){ err.textContent = d.error || "Failed"; return; }
    cacheDel("admin-webhooks");
    toast(id ? "Webhook updated" : "Webhook created", "success");
    showList();
  } catch(e){ err.textContent = "Error: " + e.message; }
}

