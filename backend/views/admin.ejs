            <div style="display:flex;flex-direction:column;gap:14px">
              <div>
                <label class="flabel" for="gPrivacyText">Privacy Policy</label>
                <textarea class="finput" id="gPrivacyText" rows="6" placeholder="Paste or write your Privacy Policy here. Plain text or basic markdown (# headings, **bold**, - lists) is supported." style="resize:vertical;font-family:var(--mono);font-size:12px;line-height:1.6"></textarea>
                <div style="font-size:11px;color:var(--text-2);margin-top:4px">Leave blank to use the default Applegate Monitor privacy page</div>
              </div>
              <div>
                <label class="flabel" for="gTermsText">Terms of Service</label>
                <textarea class="finput" id="gTermsText" rows="6" placeholder="Paste or write your Terms of Service here. Plain text or basic markdown (# headings, **bold**, - lists) is supported." style="resize:vertical;font-family:var(--mono);font-size:12px;line-height:1.6"></textarea>
                <div style="font-size:11px;color:var(--text-2);margin-top:4px">Leave blank to use the default Applegate Monitor terms page</div>
              </div>
            </div>
          </div>
        </div>
        <div class="form-footer">
          <span class="form-err" id="gErr"></span>
          <a id="gViewLink" href="#" target="_blank" style="font-size:11px;color:var(--blue);text-decoration:none;display:none;margin-right:auto">View public →</a>
          <button class="btn" onclick="showList()">Cancel</button>
          <button class="btn btn-primary" onclick="submitGroupForm()">Save Group</button>
        </div>
      </div>
    </div>
  </div>
  <div id="aWebhookFormView" class="admin-section" style="display:none">
    <div class="drawer-body">
      <div class="form-wrap">
        <div class="form-heading" id="wFormHeading">Add Webhook</div>
        <input type="hidden" id="wId">
        <div class="form-grid">
          <div class="fg full"><label class="flabel" for="wName">Name *</label><input class="finput" id="wName" placeholder="e.g. Discord Alerts"></div>
          <div class="fg full"><label class="flabel" id="wUrlLabel" for="wUrl">URL *</label><input class="finput" id="wUrl" placeholder="https://discord.com/api/webhooks/..."></div>
          <div class="fg full"><label class="flabel" for="wFormat">Format</label><select class="fselect" id="wFormat" onchange="updateWebhookUrlHint()">
            <option value="auto">Auto-detect (Discord / Slack / Teams / Telegram / Pushover / ntfy / Email)</option>
            <option value="discord">Discord</option>
            <option value="slack">Slack</option>
            <option value="teams">Microsoft Teams</option>
            <option value="telegram">Telegram</option>
            <option value="pushover">Pushover</option>
            <option value="ntfy">ntfy.sh (push notifications)</option>
            <option value="email">Email</option>
            <option value="generic">Generic JSON</option>
          </select></div>
          <div class="fg full"><label class="flabel" for="wGroup">Owner Group <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)" id="wGroupHint">(only fires for servers in this dashboard)</span></label><select class="fselect" id="wGroup"></select></div>
          <div class="fg"><label class="flabel" for="wEnabled"><input type="checkbox" id="wEnabled" checked style="vertical-align:middle;margin-right:6px">Enabled</label></div>
          <div class="fg"><label class="flabel" for="wOnDown"><input type="checkbox" id="wOnDown" checked style="vertical-align:middle;margin-right:6px">Fire on DOWN</label></div>
          <div class="fg full"><label class="flabel" for="wOnRecovery"><input type="checkbox" id="wOnRecovery" checked style="vertical-align:middle;margin-right:6px">Fire on RECOVERY</label></div>
        </div>
        <div class="form-footer">
          <span class="form-err" id="wErr"></span>
          <button class="btn" id="wTestBtn" onclick="testWebhookFromForm()" style="display:none">Send Test</button>
          <button class="btn" onclick="showList()">Cancel</button>
          <button class="btn btn-primary" onclick="submitWebhookForm()">Save Webhook</button>
        </div>
      </div>
    </div>
  </div>
  <div id="aApiKeyFormView" class="admin-section" style="display:none">
    <div class="drawer-body">
      <div class="form-wrap">
        <div class="form-heading" id="akFormHeading">Generate API Key</div>
        <div id="akFormFields">
          <div class="form-grid">
            <div class="fg full">
              <label class="flabel" for="akName">Key Name *</label>
              <input class="finput" id="akName" maxlength="120" placeholder="e.g. GitHub Actions or Monitoring Bot" autocomplete="off">
            </div>
            <div class="fg full">
              <label class="flabel" for="akScope">Access Scope *</label>
              <select class="fselect" id="akScope">
                <option value="read">Read only — view service status</option>
                <option value="write">Write — view and push external status</option>
              </select>
            </div>
          </div>
          <div class="record-context" style="margin-top:16px">Use the smallest scope your integration needs. A generated key is displayed once and cannot be recovered later.</div>
        </div>
        <div id="akResult" hidden aria-live="polite">
          <div class="record-context" style="border-color:var(--orange);color:var(--text-hi)"><strong>Copy this key now.</strong> It will not be shown again after you close this editor.</div>
          <label class="flabel" for="akGeneratedKey">Generated API Key</label>
          <textarea class="finput" id="akGeneratedKey" rows="3" readonly spellcheck="false" style="font-family:var(--mono);word-break:break-all;resize:none" onclick="this.select()"></textarea>
        </div>
        <div class="form-footer">
          <span class="form-err" id="akErr" aria-live="polite"></span>
          <button class="btn" id="akCancelBtn" type="button" onclick="showList()">Cancel</button>
          <button class="btn" id="akCopyBtn" type="button" onclick="copyGeneratedApiKey()" hidden>Copy Key</button>
          <button class="btn btn-primary" id="akCreateBtn" type="button" onclick="submitApiKeyForm()">Generate Key</button>
          <button class="btn btn-primary" id="akDoneBtn" type="button" onclick="showList()" hidden>Done</button>
        </div>
      </div>
    </div>
  </div>
</div>

