async function showUnifiDevices(controllerId, siteId, siteName) {
  const heading = document.getElementById("ufSitesHeading");
  if (heading) {
    heading.textContent = `Devices — ${siteName || "Site"}`;
    heading.focus({ preventScroll:true });
  }
  const r = await fetch(`/api/admin/unifi-controllers/${controllerId}/sites/${encodeURIComponent(siteId)}/devices`);
  if (!r.ok) { alert("Error loading devices"); return; }
  const devices = await r.json();
  function fmtUp(s){if(!s)return"";var d2=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60);return(d2?d2+"d ":"")+(h?h+"h ":"")+(m?m+"m":"").trim();}
  renderUnifiDevicesList(controllerId, siteId, siteName, devices, fmtUp);
}

function appendUnifiAction(actions, label, handler) {
  const btn = document.createElement("button");
  btn.className = "btn btn-sm";
  btn.type = "button";
  btn.textContent = label;
  btn.addEventListener("click", handler);
  actions.appendChild(btn);
}

function renderUnifiSitesList(controllerId, sites) {
  const list = document.getElementById("ufSitesList");
  list.style.color = "";
  list.replaceChildren();
  if (!sites.length) {
    const empty = document.createElement("div");
    empty.className = "admin-empty";
    empty.textContent = "No sites found.";
    list.appendChild(empty);
    return;
  }
  sites.forEach(site => {
    const row = document.createElement("div");
    row.className = "admin-server-row";
    const info = document.createElement("div");
    info.className = "admin-server-info";
    const name = document.createElement("div");
    name.className = "admin-server-name";
    name.textContent = site.name || site.id || "Unnamed site";
    const detail = document.createElement("div");
    detail.className = "admin-checks-label";
    detail.textContent = `id: ${site.id || ""}`;
    info.append(name, detail);
    const actions = document.createElement("div");
    actions.className = "admin-server-actions";
    appendUnifiAction(actions, "Add Gateway", () => addUnifiGatewayServer(controllerId, site.id, site.name));
    appendUnifiAction(actions, "WAN", () => addUnifiWanServer(controllerId, site.id, site.name));
    appendUnifiAction(actions, "Clients", () => addUnifiClientCountServer(controllerId, site.id, site.name));
    appendUnifiAction(actions, "Devices", () => showUnifiDevices(controllerId, site.id, site.name));
    row.append(info, actions);
    list.appendChild(row);
  });
}

function renderUnifiDevicesList(controllerId, siteId, siteName, devices, fmtUp) {
  const list = document.getElementById("ufSitesList");
  list.style.color = "";
  list.replaceChildren();
  const back = document.createElement("button");
  back.className = "btn btn-sm";
  back.type = "button";
  back.style.marginBottom = "10px";
  back.textContent = "\u2190 Back";
  back.addEventListener("click", () => showUnifiSites(controllerId));
  const heading = document.createElement("div");
  heading.className = "form-heading";
  heading.style.marginBottom = "10px";
  heading.textContent = `${siteName || "Site"} Devices`;
  list.append(back, heading);
  if (!devices.length) {
    const empty = document.createElement("div");
    empty.className = "admin-empty";
    empty.textContent = "No devices.";
    list.appendChild(empty);
    return;
  }
  devices.forEach(device => {
    const row = document.createElement("div");
    row.className = "admin-server-row";
    const info = document.createElement("div");
    info.className = "admin-server-info";
    const name = document.createElement("div");
    name.className = "admin-server-name";
    name.textContent = device.name || device.mac || "Unnamed device";
    const meta = document.createElement("div");
    meta.className = "admin-checks-label";
    meta.textContent = [
      device.model || device.type,
      device.ip,
      device.version ? `fw:${device.version}` : null,
      fmtUp(device.uptime),
      device.clients != null ? `${device.clients} clients` : null,
      device.state === 1 ? "online" : "offline"
    ].filter(Boolean).join(" \u00b7 ");
    info.append(name, meta);
    const actions = document.createElement("div");
    actions.className = "admin-server-actions";
    appendUnifiAction(actions, "Add Check", () =>
      addUnifiDeviceServer(controllerId, siteId, siteName, device.mac, device.name)
    );
    row.append(info, actions);
    list.appendChild(row);
  });
}

async function openUnifiServiceEditor(type, controllerId, siteId, siteName, deviceMac = null, deviceName = null) {
  await showServerForm(null);
  serverFormReturn = deviceMac
    ? { type:"unifi-devices", controllerId, siteId, siteName }
    : { type:"unifi-sites", controllerId };
  const labels = {
    unifi_gateway:"Gateway",
    unifi_wan:"WAN",
    unifi_client_count:"Clients",
    unifi_device:"Device",
  };
  document.getElementById("fName").value = deviceName || `${siteName || "UniFi"} ${labels[type] || "Service"}`;
  document.getElementById("fHost").value = "unifi-managed";
  currentChecks = [{
    type,
    controller_id:controllerId,
    site:siteId,
    site_name:siteName,
    ...(deviceMac ? { device_mac:deviceMac, device_name:deviceName } : {}),
    ...(type === "unifi_client_count" ? { min_clients:0 } : {}),
  }];
  renderCrows();
  document.getElementById("fName")?.focus({ preventScroll:true });
}

function addUnifiGatewayServer(controllerId, siteId, siteName) { return openUnifiServiceEditor("unifi_gateway", controllerId, siteId, siteName); }
function addUnifiWanServer(controllerId, siteId, siteName) { return openUnifiServiceEditor("unifi_wan", controllerId, siteId, siteName); }
function addUnifiClientCountServer(controllerId, siteId, siteName) { return openUnifiServiceEditor("unifi_client_count", controllerId, siteId, siteName); }
function addUnifiDeviceServer(controllerId, siteId, siteName, deviceMac, deviceName) { return openUnifiServiceEditor("unifi_device", controllerId, siteId, siteName, deviceMac, deviceName); }

