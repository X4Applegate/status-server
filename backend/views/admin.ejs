async function openManagementTab(tab, button){
  if (!sessionRole) { window.location.href = "/login"; return; }
  const config = MANAGEMENT_TABS[tab];
  if (!config) { showAdminOverview(); return; }
  if (config.adminOnly && !isAdmin()) { toast("Admin role required", "error"); showAdminOverview(); return; }
  const generation = ++managementLoadGeneration;
  if (activeDrawer) closeAll();
  ensureManagementWorkspaceDocked();
  setManagementWorkspaceHeader(tab);
  showAdminWorkspace("management");
  setAdminNavActive(button || document.querySelector(`[data-nav-tab="${tab}"]`));
  await switchTab(tab, generation);
  if (managementLoadIsCurrent(tab, generation)) {
    document.getElementById("adminManagementWorkspaceTitle")?.focus({ preventScroll:true });
  }
}

