function adminFormatDate(value){
  if (!value) return "Not scheduled";
  const date = new Date(value);
  if (!Number.isFinite(date.getTime())) return "Not scheduled";
  return date.toLocaleString(undefined, { month:"short", day:"numeric", hour:"numeric", minute:"2-digit" });
}

function renderAdminOverview(servers = liveServers){
  const list = Array.isArray(servers) ? servers : [];
  const up = list.filter(server => server.overall === "up").length;
  const down = list.filter(server => server.overall === "down").length;
  const degraded = list.filter(server => server.overall === "degraded").length;
  const pending = list.filter(server => !server.overall || server.overall === "pending").length;
  const responseSamples = list.flatMap(server => (server.checks || [])
    .map(check => check.response_ms)
    .filter(value => value !== null && value !== undefined && value !== "" && Number.isFinite(Number(value)) && Number(value) >= 0)
    .map(Number));
  const averageResponse = responseSamples.length
    ? Math.round(responseSamples.reduce((sum, value) => sum + value, 0) / responseSamples.length)
    : null;

  const attention = [];
  list.forEach(server => {
    if (server.maintenance) return;
    const status = server.overall || "pending";
    if (status === "down" || status === "degraded" || status === "pending") {
      attention.push({ server, status, detail: status === "down" ? "One or more configured checks are failing" : status === "degraded" ? "At least one configured check needs attention" : "Waiting for the first successful polling cycle" });
      return;
    }
    const cert = (server.checks || []).map(check => check.cert).find(value => value && Number.isFinite(Number(value.days_left)) && Number(value.days_left) < 30);
    if (cert) attention.push({ server, status:"certificate", detail:`TLS certificate expires in ${Number(cert.days_left)} day${Number(cert.days_left) === 1 ? "" : "s"}` });
  });
  attention.sort((a,b) => ({down:0,degraded:1,certificate:2,pending:3}[a.status] ?? 4) - ({down:0,degraded:1,certificate:2,pending:3}[b.status] ?? 4));
  const issueCount = attention.length;

  const healthCard = document.getElementById("adminHealthCard");
  const headline = document.getElementById("adminHealthHeadline");
  const copy = document.getElementById("adminHealthCopy");
  const state = document.getElementById("adminHealthState");
  if (healthCard) healthCard.className = `admin-health-card${down ? " has-outage" : issueCount ? " has-issues" : ""}`;
  if (headline) headline.textContent = !list.length ? "No monitored services yet" : down ? `${down} service${down === 1 ? "" : "s"} currently offline` : degraded ? `${degraded} service${degraded === 1 ? "" : "s"} running degraded` : pending ? `${pending} service${pending === 1 ? " is" : "s are"} awaiting a check` : issueCount ? `${issueCount} certificate${issueCount === 1 ? " needs" : "s need"} attention` : "All monitored services are operational";
  if (copy) copy.textContent = !list.length ? "Add your first service to begin monitoring availability, latency, and certificates." : issueCount ? `${up} of ${list.length} services are operational. Review the attention queue below for the fastest path to resolution.` : `Every monitored service and certificate is currently healthy. Live checks continue in the background.`;
  if (state) state.textContent = down ? "Active outage" : degraded ? "Degraded performance" : pending ? "Checks in progress" : issueCount ? "Action recommended" : list.length ? "Fully operational" : "Setup required";

  const setText = (id, value) => { const element = document.getElementById(id); if (element) element.textContent = value; };
  setText("adminMetricTotal", list.length);
  setText("adminMetricUp", up);
  setText("adminMetricIssues", issueCount);
  setText("adminMetricResponse", averageResponse === null ? "—" : `${averageResponse}ms`);
  setText("navServiceCount", list.length);
  setText("navIssueCount", issueCount);

  setText("attentionMeta", `${attention.length} item${attention.length === 1 ? "" : "s"}`);
  const attentionHost = document.getElementById("adminAttentionList");
  if (attentionHost) {
    attentionHost.innerHTML = attention.length ? attention.slice(0,8).map(item => {
      const label = item.status === "down" ? "Offline" : item.status === "degraded" ? "Degraded" : item.status === "certificate" ? "Certificate" : "Pending";
      return `<button class="attention-item" type="button" data-service-id="${_escHtml(item.server.id)}" onclick="openServiceEditor(this.dataset.serviceId)"><span class="attention-dot ${item.status}"></span><span><span class="attention-name">${_escHtml(item.server.name)}</span><span class="attention-detail">${_escHtml(item.detail)}</span></span><span class="attention-state">${label}</span></button>`;
    }).join("") : `<div class="ops-empty"><span class="ops-empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span><strong style="color:var(--text-hi)">Nothing needs attention</strong><span>All current checks and certificates are in a healthy state.</span></div>`;
  }

  renderAdminOverviewActivity();
}

function renderAdminOverviewActivity(){
  const incidentHost = document.getElementById("adminIncidentSummary");
  if (!Array.isArray(overviewIncidents)) {
    if (incidentHost) incidentHost.innerHTML = `<div class="ops-empty"><strong style="color:var(--text-hi)">Incident data unavailable</strong><span>The console could not verify incident activity. Try again shortly.</span></div>`;
    setTextIfPresent("navIncidentCount", "!");
  } else {
    const open = overviewIncidents.filter(incident => !incident.ended_at).slice(0,4);
    if (incidentHost) incidentHost.innerHTML = open.length ? open.map(incident => `<button class="ops-list-row" type="button" data-incident-id="${_escHtml(incident.id)}" onclick="showAdminIncidents(this.dataset.incidentId)"><span class="ops-list-icon" style="color:var(--red)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z"/></svg></span><span class="ops-list-copy"><span class="ops-list-title">${_escHtml(incident.title || `${incident.server_name} incident`)}</span><span class="ops-list-meta">${_escHtml(incident.server_name || "Service")} · ${_escHtml(incident.status || "investigating")} · ${adminFormatDate(incident.started_at)}</span></span></button>`).join("") : `<div class="ops-empty"><span class="ops-empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span><strong style="color:var(--text-hi)">No active incidents</strong><span>Customer communications are clear.</span></div>`;
    setTextIfPresent("navIncidentCount", open.length);
  }

  const now = Date.now();
  const maintenanceHost = document.getElementById("adminMaintenanceSummary");
  if (!Array.isArray(overviewMaintenance)) {
    if (maintenanceHost) maintenanceHost.innerHTML = `<div class="ops-empty"><strong style="color:var(--text-hi)">Maintenance data unavailable</strong><span>The console could not verify the schedule. Try again shortly.</span></div>`;
    setTextIfPresent("navMaintenanceCount", "!");
    return;
  }
  const activeSchedule = groupMaintenanceWindows(overviewMaintenance).filter(window => new Date(window.end_time).getTime() > now).sort((a,b) => new Date(a.start_time) - new Date(b.start_time));
  setTextIfPresent("navMaintenanceCount", activeSchedule.length);
  const schedule = activeSchedule.slice(0,4);
  if (maintenanceHost) maintenanceHost.innerHTML = schedule.length ? schedule.map(window => {
    const active = new Date(window.start_time).getTime() <= now;
    const affected = window.serviceNames.length === 1 ? window.serviceNames[0] : `${window.serviceNames.length || 1} affected services`;
    return `<button class="ops-list-row" type="button" data-maintenance-id="${_escHtml(window.id)}" onclick="showAdminMaintenance(this.dataset.maintenanceId)"><span class="ops-list-icon" style="color:var(--orange)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="11" x2="21" y2="11"/></svg></span><span class="ops-list-copy"><span class="ops-list-title">${_escHtml(window.title)}</span><span class="ops-list-meta">${active ? "In progress" : adminFormatDate(window.start_time)} · ${_escHtml(affected)}</span></span></button>`;
  }).join("") : `<div class="ops-empty"><span class="ops-empty-icon" style="color:var(--text-2);background:var(--surface2)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="11" x2="21" y2="11"/></svg></span><strong style="color:var(--text-hi)">No upcoming maintenance</strong><span>The operations calendar is clear.</span></div>`;
}

