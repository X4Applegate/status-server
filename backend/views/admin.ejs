function findAdminServer(id){
  return adminServers.find(server => String(server.id) === String(id));
}
function renderAdminServerList(list){
  // If a search is active, apply it to whatever list we receive
  const q = (document.getElementById("serverSearchInput")?.value || "").trim().toLowerCase();
  if (q) {
    list = list.filter(s =>
      (s.name        || "").toLowerCase().includes(q) ||
      (s.host        || "").toLowerCase().includes(q) ||
      (s.category    || "").toLowerCase().includes(q) ||
      (s.sub_category|| "").toLowerCase().includes(q) ||
      (s.description || "").toLowerCase().includes(q) ||
      (s.tags        || []).some(t => t.toLowerCase().includes(q))
    );
  }
  const el = document.getElementById("adminPanelBody");
  document.getElementById("aCount").textContent = `${list.length} server${list.length===1?"":"s"}`;
  if (!list.length){
    el.innerHTML = `<div class="empty-state">No servers yet.<br>Click <strong>Add Server</strong> to add one.</div>`;
    return;
  }
  el.innerHTML = list.map((s, idx) => {
    const checkSummary = (s.checks||[]).map(c =>
      c.type==="ping"?"Ping":
      c.type==="tcp"?`TCP :${c.port}`:
      c.type==="udp"?`UDP :${c.port}`:
      c.type==="dns"?`DNS ${(c.record_type||"A").toUpperCase()}`:
      c.type==="omada_gateway"?"Omada WAN":
      c.type==="unifi_gateway"?"UniFi WAN":
      c.type==="unifi_wan"?"UniFi WAN Health":
      c.type==="unifi_client_count"?"UniFi Clients":
      c.type==="unifi_device"?(c.device_name||"UniFi Device"):
      c.type==="omada_lte"?"Omada LTE":
      c.type==="omada_device"?(c.device_name||"Omada Device"):
      "HTTP"
    ).join(" - ") || "No checks";
    // Cert badges: pull from any HTTP check on this server that has live cert info
    const certBadges = (s.checks||[])
      .filter(c => c.type === "http" && c.cert && c.cert.expires_at)
      .map(c => {
        const d = c.cert.days_left;
        const ccls = d < 0 ? "cert-expired" : d < 14 ? "cert-warn" : "cert-ok";
        const txt  = d < 0 ? `SSL expired ${-d}d ago` : d < 1 ? "SSL expires today" : `SSL ${d}d`;
        const tt   = `${c.cert.subject || ""} · issued by ${c.cert.issuer || "?"} · expires ${new Date(c.cert.expires_at).toLocaleDateString()}`;
        return `<span class="chip-cert ${ccls}" title="${_escHtml(tt)}">${_escHtml(txt)}</span>`;
      }).join("");
    const serviceId = _escHtml(s.id);
    return `<div class="admin-server-item" role="button" tabindex="0" data-service-id="${serviceId}" onclick="showServerForm(findAdminServer(this.dataset.serviceId))" onkeydown="if(event.target===event.currentTarget&&(event.key==='Enter'||event.key===' ')){event.preventDefault();showServerForm(findAdminServer(this.dataset.serviceId))}">
      <div class="admin-dot ${s.overall||'pending'}"></div>
      <div class="admin-info">
        <div class="admin-name">${_escHtml(s.name)}</div>
        <div class="admin-host">${_escHtml(s.host)}${(s.category||s.sub_category) ? ` <span style="color:var(--text-2);opacity:.7">·</span> <span style="color:var(--blue);opacity:.8">${_escHtml([s.category,s.sub_category].filter(Boolean).join(" › "))}</span>` : ""}${s.description ? ` <span style="color:var(--text-2);opacity:.6;font-style:italic">— ${_escHtml(s.description)}</span>` : ""}</div>
        <div class="admin-checks-label">${_escHtml(checkSummary)}${certBadges ? " " + certBadges : ""}</div>
      </div>
      <div class="admin-row-actions" onclick="event.stopPropagation()">
        ${isAdmin() ? `<button class="btn btn-sm" data-service-id="${serviceId}" onclick="dupServer(findAdminServer(this.dataset.serviceId))">Dup</button>` : ``}
        <button class="btn btn-sm" data-service-id="${serviceId}" onclick="showServerForm(findAdminServer(this.dataset.serviceId))">Edit</button>
        ${isAdmin() ? `<button class="btn btn-sm btn-danger" data-service-id="${serviceId}" onclick="askDel(this.dataset.serviceId, findAdminServer(this.dataset.serviceId)?.name || 'this service')">Remove</button>` : ``}
      </div>
    </div>`;
  }).join("");
}

async function loadServerList(){
  const el = document.getElementById("adminPanelBody");

  // 1) Instant render from cache
  const cached = cacheGet("admin-servers");
  if (cached) {
    adminServers = cached;
    renderAdminServerList(adminServers);
    updateDrawerStats(adminServers);
    if (serverListScrollTop != null) {
      void el.scrollHeight;
      requestAnimationFrame(() => { el.scrollTop = serverListScrollTop; });
    }
  } else {
    el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading servers...</div>`;
  }

  // 2) Fetch fresh
  try {
    const r = await fetch("/api/admin/servers");
    if (r.status === 401) { window.location.href = "/"; return; }
    if (!r.ok) {
      if (!cached) el.innerHTML = `<div class="empty-state">Error ${r.status}</div>`;
      return;
    }
    adminServers = await r.json();
    cacheSet("admin-servers", adminServers);
    renderAdminServerList(adminServers);
    updateDrawerStats(adminServers);
    if (serverListScrollTop != null) {
      const target = serverListScrollTop;
      serverListScrollTop = null;
      // Force layout then restore scroll on next frame so the browser has
      // measured the new list heights before we assign scrollTop.
      void el.scrollHeight;
      requestAnimationFrame(() => { el.scrollTop = target; });
    }
    return;
  } catch(e) {
    if (!cached) el.innerHTML = `<div class="empty-state">Failed to load: ${e.message}</div>`;
  }
}

