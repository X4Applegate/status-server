// NET_CTRL_POSITION_HELPER_START
function getNetCtrlMenuPosition(buttonRect, drawerRect, menuWidth) {
  const edgeGap = 8;
  const idealLeft = buttonRect.left - drawerRect.left;
  const maxLeft = Math.max(edgeGap, drawerRect.width - menuWidth - edgeGap);
  return {
    top: buttonRect.bottom - drawerRect.top + 4,
    left: Math.min(Math.max(edgeGap, idealLeft), maxLeft),
  };
}
// NET_CTRL_POSITION_HELPER_END

function positionNetCtrlMenu() {
  const menu = document.getElementById("tabNetCtrlMenu");
  if (!menu || !menu.classList.contains("open")) return;
  const btn = document.getElementById("tabNetCtrlBtn");
  const drawer = document.getElementById("adminDrawer");
  if (!btn || !drawer) return;
  // A transformed ancestor becomes the containing block for position:fixed.
  // Convert viewport coordinates into drawer-local coordinates so the menu
  // stays under its button on desktop screens wider than the 1080px drawer.
  const pos = getNetCtrlMenuPosition(
    btn.getBoundingClientRect(),
    drawer.getBoundingClientRect(),
    menu.offsetWidth,
  );
  menu.style.top = pos.top + "px";
  menu.style.left = pos.left + "px";
}

function toggleNetCtrl(e) {
  if (e) {
    e.preventDefault();
    e.stopPropagation();
  }
  const menu = document.getElementById("tabNetCtrlMenu");
  const btn = document.getElementById("tabNetCtrlBtn");
  if (!menu || !btn) return;
  if (menu.classList.contains("open")) { closeNetCtrl(); return; }
  menu.classList.add("open");
  btn.setAttribute("aria-expanded", "true");
  positionNetCtrlMenu();
}
function closeNetCtrl() {
  const menu = document.getElementById("tabNetCtrlMenu");
  const btn = document.getElementById("tabNetCtrlBtn");
  if (menu) menu.classList.remove("open");
  if (btn) btn.setAttribute("aria-expanded", "false");
}
document.addEventListener("click", e => {
  const group = document.getElementById("tabNetCtrl");
  if (!group || !group.contains(e.target)) closeNetCtrl();
});
window.addEventListener("resize", positionNetCtrlMenu);
document.querySelector(".admin-tabs").addEventListener("scroll", positionNetCtrlMenu, { passive: true });

