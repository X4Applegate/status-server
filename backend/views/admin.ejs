  document.getElementById("tabUsers").classList.toggle("active",    tab === "users");
  document.getElementById("tabWebhooks").classList.toggle("active", tab === "webhooks");
  document.getElementById("tabSettings").classList.toggle("active", tab === "settings");
  document.getElementById("tabAudit").classList.toggle("active",    tab === "audit");
  const labels = { servers:"Add Service", groups:"Add Status Page", omada:"Add Controller", unifi:"Add Controller", square:"Add Account", maint:"Schedule Window", incidents:"", banners:"Add Announcement", apikeys:"Generate Key", users:"Add User", webhooks:"Add Alert Channel", settings:"", audit:"" };
  document.getElementById("addBtnLabel").textContent = labels[tab] || "";
  // Incidents are created automatically from failed checks or via the Post Update button
  // on each row — there's no "add incident" flow, so hide the Add button for that tab.
  const hideAdd = (!isAdmin() && (tab==="groups"||tab==="users"||tab==="banners")) || tab==="settings" || tab==="audit" || tab==="incidents";
  document.getElementById("addBtn").style.display = hideAdd ? "none" : "";
