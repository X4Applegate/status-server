// ── localStorage cache helpers (stale-while-revalidate) ──────────────────────
const CACHE_PREFIX = "sm-cache-";
function scopedCachePrefix(){
  return cacheScope ? `${CACHE_PREFIX}${encodeURIComponent(cacheScope)}:` : "";
}
function cacheGet(key){
  const prefix = scopedCachePrefix();
  if (!prefix) return null;
  try { const v = sessionStorage.getItem(prefix + key); return v ? JSON.parse(v) : null; }
  catch(e){ return null; }
}
function cacheSet(key, val){
  const prefix = scopedCachePrefix();
  if (!prefix) return;
  try { sessionStorage.setItem(prefix + key, JSON.stringify(val)); } catch(e){}
}
function cacheDel(key){
  const prefix = scopedCachePrefix();
  if (!prefix) return;
  try { sessionStorage.removeItem(prefix + key); } catch(e){}
}
function cacheClearLegacyPersistentCaches(){
  try {
    Object.keys(localStorage)
      .filter(key =>
        key.startsWith(CACHE_PREFIX + "admin-") ||
        key === CACHE_PREFIX + "servers" ||
        key === CACHE_PREFIX + "selected-id" ||
        key.startsWith(CACHE_PREFIX + "detail-")
      )
      .forEach(key => localStorage.removeItem(key));
  } catch(e){}
}
function cacheClearAllAuthenticated(){
  try {
    Object.keys(sessionStorage)
      .filter(key => key.startsWith(CACHE_PREFIX))
      .forEach(key => sessionStorage.removeItem(key));
  } catch(e){}
  cacheClearLegacyPersistentCaches();
}
function cacheClearAdmin(){
  const prefix = scopedCachePrefix();
  if (!prefix) { cacheClearLegacyPersistentCaches(); return; }
  try {
    Object.keys(sessionStorage)
      .filter(key => key.startsWith(prefix + "admin-") || key === prefix + "selected-incident-id" || key === prefix + "selected-maintenance-id")
      .forEach(key => sessionStorage.removeItem(key));
  } catch(e){}
  cacheClearLegacyPersistentCaches();
}
function cacheClearServiceObservability(){
  const prefix = scopedCachePrefix();
  if (!prefix) { cacheClearLegacyPersistentCaches(); return; }
  try {
    Object.keys(sessionStorage)
      .filter(key =>
        key === prefix + "servers" ||
        key === prefix + "selected-id" ||
        key.startsWith(prefix + "detail-")
      )
      .forEach(key => sessionStorage.removeItem(key));
  } catch(e){}
  cacheClearLegacyPersistentCaches();
}

async function doLogout(){
  await fetch("/api/logout", {method:"POST"});
  // Clear authenticated caches so the next browser user cannot see stale data
  // from a more privileged session before their own authorization is known.
  cacheClearAdmin();
  cacheClearServiceObservability();
  cacheScope = "";
  try { sessionStorage.removeItem("sm-session-fingerprint"); } catch (_) {}
  window.location.href = "/";
}

