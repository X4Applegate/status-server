async function showServerForm(s){
  // Capture scroll position so Save/Cancel can restore it.
  const _body = document.getElementById("adminPanelBody");
  serverListScrollTop = _body ? _body.scrollTop : null;
  openAdminEditorDrawer("aFormView", s ? "Edit service" : "Add service");
  document.getElementById("aFormView").style.display       = "flex";
  document.getElementById("aUserFormView").style.display   = "none";
  document.getElementById("aGroupFormView").style.display  = "none";
  document.getElementById("aOmadaFormView").style.display  = "none";
  document.getElementById("aOmadaSitesView").style.display = "none";
  document.getElementById("fHeading").textContent = s ? "Edit Server" : "Add Server";
  document.getElementById("fId").value    = s?.id || "";
  document.getElementById("fName").value  = s?.name || "";
  document.getElementById("fHost").value  = s?.host || "";
  document.getElementById("fDesc").value  = s?.description || "";
  document.getElementById("fCategory").value = s?.category || "";
  document.getElementById("fSubCategory").value = s?.sub_category || "";
  // Populate category autocomplete with existing categories from other servers
  try {
    const cats = Array.from(new Set((adminServers||[]).map(x => x.category).filter(Boolean))).sort();
    document.getElementById("categoryHints").innerHTML = cats.map(c => `<option value="${_escHtml(c)}">`).join("");
    const subCats = Array.from(new Set((adminServers||[]).map(x => x.sub_category).filter(Boolean))).sort();
    document.getElementById("subCategoryHints").innerHTML = subCats.map(c => `<option value="${_escHtml(c)}">`).join("");
  } catch(e) {}
  document.getElementById("fLat").value     = s?.lat != null ? String(s.lat) : "";
  document.getElementById("fLng").value     = s?.lng != null ? String(s.lng) : "";
  document.getElementById("fAddress").value = s?.location_address || "";
  document.getElementById("fGeoResult").textContent = (s?.lat && s?.lng)
    ? (s.location_address ? `📍 ${s.location_address}` : `📍 ${parseFloat(s.lat).toFixed(5)}, ${parseFloat(s.lng).toFixed(5)}`)
    : "";
  document.getElementById("fGeoResult").style.color = "var(--text-2)";
  document.getElementById("fGeoList").style.display = "none";
  document.getElementById("fTags").value  = (s?.tags||[]).join(", ");
  document.getElementById("fRunbook").value = s?.runbook || "";
  document.getElementById("fInterval").value = String(s?.poll_interval_sec || 30);
  document.getElementById("fThreshold").value = String(s?.failure_threshold || 1);
  document.getElementById("fErr").textContent = "";
  currentChecks = (s?.checks||[{type:"ping"}]).map(c => ({...c}));
  // Initialize group selection from the server's existing group_ids
  serverPickedGroups = new Set(s?.group_ids || []);
  // If creating a new server as a viewer, default-check their first allowed group
  if (!s && !isAdmin()) {
    await ensureGroupsLoaded();
    if (adminGroups.length && serverPickedGroups.size === 0) {
      serverPickedGroups.add(adminGroups[0].id);
    }
  }
  // Load groups + omada controllers + unifi controllers in parallel before rendering check rows
  await Promise.all([ensureGroupsLoaded(), ensureOmadaLoaded(), ensureUnifiLoaded(), ensureSquareLoaded()]);
  renderCrows();
  renderServerGroupsPicker();
  renderBadgeSection(s);
}

