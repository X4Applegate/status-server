async function populateUnifiSitePicker(i){
  const ck = currentChecks[i];
  if (!ck || !ck.controller_id) return;
  const select = document.getElementById(`ufSiteSel${i}`);
  if (!select) return;
  let sites = unifiSitesCache[ck.controller_id];
  if (!sites) {
    try {
      const response = await fetch(`/api/admin/unifi-controllers/${encodeURIComponent(ck.controller_id)}/sites`);
      if (response.ok) {
        sites = await response.json();
        unifiSitesCache[ck.controller_id] = sites;
      }
    } catch (_) {}
  }
  if (!sites?.length) {
    select.innerHTML = `<option value="">— No sites returned —</option>`;
    return;
  }
  select.innerHTML = `<option value="">— Pick site —</option>` + sites.map(site => {
    const siteId = site.id || site.siteId || site.name || "";
    return `<option value="${_escHtml(siteId)}" ${String(ck.site || "") === String(siteId) ? "selected" : ""}>${_escHtml(site.name || siteId)}</option>`;
  }).join("");
  select.onchange = function(){
    const picked = sites.find(site => String(site.id || site.siteId || site.name || "") === String(this.value));
    upCk(i, "site", this.value);
    upCk(i, "site_name", picked?.name || this.value || null);
  };
}

async function populateOmadaSitePicker(i){
  const ck = currentChecks[i];
  if (!ck || !ck.controller_id) return;
  const sel = document.getElementById("siteSel" + i);
  if (!sel) return;
  // Use cached site list if we have it
  let sites = omadaSitesCache[ck.controller_id];
  if (!sites) {
    try {
      const r = await fetch(`/api/admin/omada-controllers/${encodeURIComponent(ck.controller_id)}/sites`);
      if (r.ok) { sites = await r.json(); omadaSitesCache[ck.controller_id] = sites; }
    } catch(e) {}
  }
  if (!sites || !sites.length) {
    sel.innerHTML = `<option value="">— No sites returned —</option>`;
    return;
  }
  // Encode "customerId|siteId" for MSP, plain siteId otherwise
  // For MSP sites, group by customer using <optgroup> so the picker shows
  // Customer A
  //   ├─ Site 1
  //   └─ Site 2
  const hasCustomers = sites.some(s => s.customerId);
  if (hasCustomers) {
    // Group by customer
    const byCust = {};
    sites.forEach(s => {
      const key = s.customerId || "_uncategorized";
      if (!byCust[key]) byCust[key] = { name: s.customerName || key, items: [] };
      byCust[key].items.push(s);
    });
    let html = `<option value="">— Pick site —</option>`;
    for (const [cid, group] of Object.entries(byCust)) {
      html += `<optgroup label="${_escHtml(group.name)}">`;
      for (const s of group.items) {
        const sid     = s.siteId || s.id;
        const value   = `${s.customerId}|${sid}`;
        const matches = ck.site_id == sid && ck.customer_id == s.customerId;
        html += `<option value="${_escHtml(value)}" ${matches ? "selected" : ""}>${_escHtml(s.name || sid)}</option>`;
      }
      html += `</optgroup>`;
    }
    sel.innerHTML = html;
  } else {
    sel.innerHTML = `<option value="">— Pick site —</option>` +
      sites.map(s => {
        const sid     = s.siteId || s.id;
        const matches = ck.site_id == sid && !ck.customer_id;
        return `<option value="${_escHtml(sid)}" ${matches ? "selected" : ""}>${_escHtml(s.name || sid)}</option>`;
      }).join("");
  }
  // Wire onchange — parse the encoded value into customer_id (optional) + site_id,
  // then look up the chosen site from the cached site list to also store the
  // friendly site_name and customer_name (required for MSP filtering).
  sel.onchange = function(){
    const parts = this.value.split("|");
    let cid, sid;
    if (parts.length === 2) { cid = parts[0]; sid = parts[1]; }
    else                    { cid = null;     sid = parts[0]; }
    upCk(i, "customer_id", cid);
    upCk(i, "site_id",     sid);
    // Look up the picked site to grab its name + customer name
    const sitesList = omadaSitesCache[ck.controller_id] || [];
    const picked = sitesList.find(s => (s.siteId || s.id) === sid);
    upCk(i, "site_name",     picked?.name || null);
    upCk(i, "customer_name", picked?.customerName || null);
  };
}

function addCrow()    { currentChecks.push({type:"ping"}); renderCrows(); }
function rmCk(i)      { currentChecks.splice(i,1); renderCrows(); }
function changeCT(i,t){
  // When switching to omada_lte, seed controller+site from an existing omada_gateway check
  // on the same server so the user doesn't have to re-pick from scratch.
  if (t === "omada_lte" || t === "omada_gateway") {
    const donor = currentChecks.find((c,j) => j !== i && (c.type === "omada_gateway" || c.type === "omada_lte") && c.controller_id);
    if (donor) {
      currentChecks[i] = { type:t, controller_id:donor.controller_id, site_id:donor.site_id, site_name:donor.site_name, customer_id:donor.customer_id, customer_name:donor.customer_name };
      renderCrows();
      return;
    }
  }
  currentChecks[i] = {type:t}; renderCrows();
}
function upCk(i,k,v)  { currentChecks[i][k] = v; }

let _geoResults = [];
function _pickGeoResult(idx) {
  const d = _geoResults[idx];
  if (!d) return;
  document.getElementById("fLat").value     = parseFloat(d.lat).toFixed(6);
  document.getElementById("fLng").value     = parseFloat(d.lon).toFixed(6);
  document.getElementById("fAddress").value = d.display_name;
  document.getElementById("fGeoResult").textContent = `📍 ${d.display_name}`;
  document.getElementById("fGeoResult").style.color = "var(--green)";
  document.getElementById("fGeoList").style.display = "none";
}

function onManualCoord() {
  const lat = parseFloat(document.getElementById("fLat").value);
  const lng = parseFloat(document.getElementById("fLng").value);
  const res = document.getElementById("fGeoResult");
  if (!isNaN(lat) && !isNaN(lng)) {
    res.textContent = `📍 ${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    res.style.color = "var(--text-2)";
  } else {
    res.textContent = "";
  }
  document.getElementById("fGeoList").style.display = "none";
}

function clearCoords() {
  document.getElementById("fLat").value = "";
  document.getElementById("fLng").value = "";
  document.getElementById("fGeoResult").textContent = "";
  document.getElementById("fGeoList").style.display = "none";
  document.getElementById("fAddress").value = "";
}

async function geocodeAddress() {
  const query = document.getElementById("fAddress").value.trim();
  if (!query) return;
  const btn    = document.getElementById("fGeoBtn");
  const result = document.getElementById("fGeoResult");
  const list   = document.getElementById("fGeoList");
  btn.disabled = true; btn.textContent = "Looking up…";
  result.textContent = ""; result.style.color = "var(--text-2)";
  list.style.display = "none"; list.innerHTML = "";
  try {
    const r    = await fetch(`/api/admin/geocode?q=${encodeURIComponent(query)}`);
    const data = await r.json();
    if (!data.length) {
      result.textContent = "Address not found — try a more specific query, or enter coordinates manually below.";
      result.style.color = "var(--red)";
    } else if (data.length === 1) {
      // Single result — auto-select it
      _geoResults = data;
      _pickGeoResult(0);
    } else {
      // Multiple results — let user pick the right one
      _geoResults = data;
      result.textContent = `${data.length} results found — pick the correct one:`;
      result.style.color = "var(--text-2)";
      list.style.display = "block";
      list.innerHTML = data.map((d, i) =>
        `<div class="geo-pick-row" onclick="_pickGeoResult(${i})">
          <span style="font-family:var(--mono);font-size:11px;color:var(--blue);flex-shrink:0">${parseFloat(d.lat).toFixed(5)}, ${parseFloat(d.lon).toFixed(5)}</span>
          <span style="color:var(--text-hi);font-size:12px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${d.display_name}</span>
        </div>`
      ).join("");
    }
  } catch(e) {
    result.textContent = "Geocoding failed — check your connection.";
    result.style.color = "var(--red)";
  } finally {
    btn.disabled = false; btn.textContent = "Look up";
  }
}

async function submitForm(){
  const name = document.getElementById("fName").value.trim();
  const host = document.getElementById("fHost").value.trim();
  if (!name || !host){ document.getElementById("fErr").textContent = "Name and host required."; return; }
  const id   = document.getElementById("fId").value;
  const body = {
    name, host,
    description:       document.getElementById("fDesc").value.trim(),
    category:          document.getElementById("fCategory").value.trim(),
    sub_category:      document.getElementById("fSubCategory").value.trim(),
    tags:              document.getElementById("fTags").value.split(",").map(t=>t.trim()).filter(Boolean),
    checks:            currentChecks.map(c => ({...c})),
    group_ids:         Array.from(serverPickedGroups),
    poll_interval_sec: parseInt(document.getElementById("fInterval").value) || 30,
    failure_threshold: parseInt(document.getElementById("fThreshold").value) || 1,
    lat: parseFloat(document.getElementById("fLat").value) || null,
    lng: parseFloat(document.getElementById("fLng").value) || null,
    location_address: document.getElementById("fAddress").value.trim() || null,
    runbook:          document.getElementById("fRunbook").value,
  };
  try {
    const r = await fetch(id ? `/api/admin/servers/${id}` : "/api/admin/servers", {
      method: id ? "PUT" : "POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    const d = await r.json();
    if (!r.ok){ document.getElementById("fErr").textContent = d.error||"Failed"; return; }
    // Patch the local cache so the list re-renders instantly with fresh values —
    // this lets the cached-render branch restore scroll immediately, and the
    // background fetch in loadServerList will replace it with authoritative data.
    try {
      const saveId = id || d.id;
      if (saveId && Array.isArray(adminServers)) {
        const existingIdx = adminServers.findIndex(x => x.id === saveId);
        const patched = { ...(existingIdx >= 0 ? adminServers[existingIdx] : { id: saveId }), ...body, id: saveId };
        if (existingIdx >= 0) adminServers[existingIdx] = patched;
        else adminServers.push(patched);
        cacheSet("admin-servers", adminServers);
      } else {
        cacheDel("admin-servers");
      }
    } catch(e) { cacheDel("admin-servers"); }
    cacheDel("admin-groups");
    // Patch liveServers so the sidebar reflects the new name/host immediately
    // without waiting for the next SSE tick
    try {
      const saveId = id || d.id;
      if (saveId != null && Array.isArray(liveServers)) {
        const lIdx = liveServers.findIndex(x => x.id == saveId);
        if (lIdx >= 0) {
          liveServers[lIdx] = { ...liveServers[lIdx], name: body.name, host: body.host, description: body.description || "", location_address: body.location_address || null };
          renderSidebarList(liveServers);
        }
      }
    } catch(e) {}
    toast(id ? "Server updated" : "Server added", "success");
    await showList();
  } catch(e){ document.getElementById("fErr").textContent = "Error: "+e.message; }
}

function askDel(id, name){
  pendDel = id;
  document.getElementById("confirmMsg").textContent = `"${name}" will be removed.`;
  openModalLayer("confirmDlg");
  document.querySelector("#confirmDlg .btn-danger").onclick = doDelete;
}
function closeConfirm(){
  closeModalLayer("confirmDlg");
  pendDel = null; pendDelUser = null; pendDelGroup = null; pendDelOmada = null;
}
async function doDelete(){
  if (!pendDel) return;
  try {
    const r = await fetch(`/api/admin/servers/${pendDel}`, {method:"DELETE"});
    const d = await r.json();
    if (r.ok) { cacheDel("admin-servers"); cacheDel("admin-groups"); }
    toast(r.ok ? "Server removed" : (d.error||"Failed"), r.ok ? "info" : "error");
  } catch(e){ toast("Error: "+e.message, "error"); }
  closeConfirm();
  loadServerList();
}

// ── User list ─────────────────────────────────────────────────────────────────
function renderAdminUserList(users){
  const el = document.getElementById("adminPanelBody");
  _userStore = {};
  users.forEach(u => _userStore[u.id] = u);
  const filtered = users.filter(user => managementMatches(user, ["username","first_name","last_name","email","role"]));
  document.getElementById("aCount").textContent = `${filtered.length} user${filtered.length===1?"":"s"}`;
  document.getElementById("managementDirectorySubtitle").textContent = `${filtered.length} of ${users.length} accounts`;
  if (!filtered.length){ el.innerHTML = `<div class="empty-state">No users match this search.</div>`; syncManagementSelection("users", filtered); return; }
  syncManagementSelection("users", filtered);
  el.innerHTML = filtered.map(user => {
    const fullName = [user.first_name,user.last_name].filter(Boolean).join(" ") || user.username;
    const pages = user.role === "admin" ? "All status pages" : `${(user.allowed_group_ids || []).length} assigned`;
    return managementRowMarkup({ tab:"users", id:user.id, title:fullName, meta:`@${user.username}${user.email ? ` · ${user.email}` : ""}`, detail:pages, badge:user.role, dot:user.role === "admin" ? "up" : "pending" });
  }).join("");
}

async function loadUserList(generation = managementLoadGeneration){
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("users", generation)) return;

  // Make sure groups are loaded so user rows can render dashboard pills with real names
  await ensureGroupsLoaded();
  if (!managementLoadIsCurrent("users", generation)) return;

  // 1) Instant render from cache
  const cached = cacheGet("admin-users");
  if (cached) renderAdminUserList(cached);
  else        el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading users...</div>`;

  // 2) Fetch fresh
  try {
    const r = await fetch("/api/admin/users");
    if (!managementLoadIsCurrent("users", generation)) return;
    if (r.status === 401){ window.location.href = "/"; return; }
    if (r.status === 403){
      if (!cached) el.innerHTML = `<div class="empty-state">Admin role required. Log out and back in.</div>`;
      return;
    }
    if (!r.ok){
      if (!cached) el.innerHTML = `<div class="empty-state">Error ${r.status}</div>`;
      return;
    }
    const users = await r.json();
    if (!managementLoadIsCurrent("users", generation)) return;
    cacheSet("admin-users", users);
    renderAdminUserList(users);
  } catch(e){
    if (managementLoadIsCurrent("users", generation) && !cached) el.innerHTML = `<div class="empty-state">Failed: ${e.message}</div>`;
  }
}

