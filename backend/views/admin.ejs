// ── Session / Auth ────────────────────────────────────────────────────────────
let sessionRole = "";
let sessionAllowedGroupIds = null;   // null = unrestricted (admin), array = viewer's allowed groups
let cacheScope = "";                // populated only after /api/me authorizes this tab
function isAdmin(){ return sessionRole === "admin"; }
function isViewer(){ return sessionRole === "viewer"; }
function sessionCacheFingerprint(session){
  const groups = Array.isArray(session.allowed_group_ids)
    ? session.allowed_group_ids.map(String).sort().join(",")
    : "all";
  return `${session.username || ""}|${session.role || "viewer"}|${groups}`;
}

(async function initSession(){
  try {
    const r = await fetch("/api/me");
    // Guard: if response is not JSON, treat as logged out (not an error)
    const ct = r.headers.get("content-type") || "";
    if (!ct.includes("application/json")) {
      cacheClearAllAuthenticated();
      cacheScope = "";
      try { sessionStorage.removeItem("sm-session-fingerprint"); } catch (_) {}
      document.getElementById("loginBtn").style.display = "";
      return;
    }
    const d = await r.json();
    if (d.loggedIn) {
      const fingerprint = sessionCacheFingerprint(d);
      let previousFingerprint = null;
      try { previousFingerprint = sessionStorage.getItem("sm-session-fingerprint"); } catch (_) {}
      if (previousFingerprint !== fingerprint) {
        cacheClearAllAuthenticated();
        try { sessionStorage.setItem("sm-session-fingerprint", fingerprint); } catch (_) {}
      }
      cacheClearLegacyPersistentCaches();
      cacheScope = fingerprint;
      sessionRole = d.role || "viewer";
      sessionAllowedGroupIds = d.allowed_group_ids || null;
      const show = ids => ids.forEach(id => { const el=document.getElementById(id); if(el) el.style.display=""; });
      // Both roles get badge, logout, change-password, refresh, AND the Admin button
      // (viewers need it to manage servers in their assigned groups)
      show(["userBadge","logoutBtn","profileBtn","pwdBtn","rfBtn","adminMenuBtn"]);
      // Logs are system-info — admin only
      if (isAdmin()) show(["logMenuBtn"]);
      const badge = document.getElementById("userBadge");
      if (badge) {
        const displayName = (d.first_name || d.last_name)
          ? [d.first_name, d.last_name].filter(Boolean).join(" ")
          : d.username;
        badge.textContent = displayName;
      }
      applyRoleVisibility();
      if (isAdmin()) connectLogs();
      // Populate the topbar dashboard quick-nav with the user's accessible dashboards
      renderTopbarDashboards();
      hydrateAdminOverview();
      // If the page was opened with ?edit=<server_id>, auto-open the admin drawer + server form.
      // This powers the inline Edit buttons on the status page sidebar.
      const editId   = new URLSearchParams(window.location.search).get("edit");
      const newGroup = new URLSearchParams(window.location.search).get("newGroup");
      const welcome  = new URLSearchParams(window.location.search).get("welcome");
      if (welcome) {
        setTimeout(() => { showAdminWelcome(); openAdmin(); }, 0);
        history.replaceState(null, "", "/admin");
      } else if (editId) {
        setTimeout(() => autoOpenServerEdit(editId), 0);
      } else if (newGroup) {
        setTimeout(() => autoOpenNewGroup(), 0);
      }
      // Version update check (admin only — non-blocking)
      if (isAdmin()) {
        fetch("/api/version").then(r => r.json()).then(v => {
          const vBadge = document.getElementById("appVersion");
          if (vBadge && v.current) vBadge.textContent = "v" + v.current;
          if (v.update_available) {
            const banner = document.getElementById("updateBanner");
            const text   = document.getElementById("updateBannerText");
            const link   = document.getElementById("updateBannerLink");
            if (banner) {
              text.textContent = `Applegate Monitor v${v.latest} is available — you're running v${v.current}.`;
              link.href = v.release_url;
              banner.style.display = "flex";
            }
          }
        }).catch(() => {});
      }
    } else {
      cacheClearAllAuthenticated();
      cacheScope = "";
      try { sessionStorage.removeItem("sm-session-fingerprint"); } catch (_) {}
      document.getElementById("loginBtn").style.display = "";
    }
  } catch(e) {
    console.warn("Session check failed:", e.message);
    cacheClearAllAuthenticated();
    cacheScope = "";
    const loginBtn = document.getElementById("loginBtn");
    if (loginBtn) loginBtn.style.display = "";
  }
})();

// Hide admin-only tabs from viewers. Called once when session is established.
// Viewers can use Servers, Omada, Webhooks, and Groups (scoped to their own dashboards).
// Users tab stays admin-only.
function applyRoleVisibility(){
  document.body.classList.toggle("admin-role", isAdmin());
  if (isAdmin()) return;  // admins see everything; nothing to hide
  ["tabUsers", "tabSettings", "tabAudit", "tabApiKeys"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = "none";
  });
  document.querySelectorAll(".admin-only-nav,.admin-only-action").forEach(el => { el.style.display = "none"; });
}

// Fetch the user's accessible dashboards and render them as clickable buttons in the topbar.
// /api/admin/groups is already filtered by role — admin sees all, viewer sees only their own.
// Admins also get a trailing "Admin" pill that links to the master view at `/`; viewers
// see the same pill but clicking it pops a permission-denied toast (matches public page behavior).
async function renderTopbarDashboards(){
  const el     = document.getElementById("topbarDashboards");
  const popup  = document.getElementById("topbarDashPopup");
  if (!el) return;
  try {
    const r = await fetch("/api/admin/groups");
    if (!r.ok) return;
    const groups = await r.json();
    const makePill = (dot, href, label, extra="") =>
      `<a class="dash-nav ${extra}" href="${href}">
        <span class="dash-nav-dot" style="background:${dot}"></span>${label}</a>`;
    const pills = groups.map(g => {
      const dot  = g.accent_color || "var(--blue)";
      const href = g.custom_domain ? `https://${g.custom_domain}` : `/dashboard/${g.slug}`;
      return makePill(dot, href, g.name);
    });
    if (isAdmin()) {
      pills.push(`<a class="dash-nav dash-nav-admin" href="/" title="Master view">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4 2 7-6.5-4.5L5.5 20l2-7L2 9h7z"/></svg>All Servers</a>`);
    }
    el.innerHTML = pills.join("");
    if (popup) popup.innerHTML = pills.join("");
  } catch(e) { /* silent */ }
}

function toggleDashMenu(e){
  e.stopPropagation();
  const btn    = document.getElementById("topbarDashBtn");
  const popup  = document.getElementById("topbarDashPopup");
  const isOpen = popup.classList.contains("open");
  popup.classList.toggle("open", !isOpen);
