    searchBar.classList.toggle("visible", tab !== "settings");
    statBar.classList.remove("visible");
  }
  if (["omada","unifi","square","users","webhooks"].includes(tab)) {
    await ensureGroupsLoaded();
    if (MANAGEMENT_TABS[tab] && !managementLoadIsCurrent(tab, managementGeneration)) return;
  }
  if      (tab === "servers")   await loadServerList();
  else if (tab === "groups")    await loadGroupList(managementGeneration);
