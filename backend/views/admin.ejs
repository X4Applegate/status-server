// ── Danger Zone: clear all history ────────────────────────────────────────
// Two-gate confirmation:
//   1) Native confirm() dialog (browser warning)
//   2) Typed phrase via prompt() — must match "DELETE ALL HISTORY" exactly
// The server also validates the phrase, so copying the fetch from devtools
// still won't bypass the safeguard.
async function clearAllHistory(){
  const msg = document.getElementById("dangerMsg");
  msg.textContent = "";
  if (!confirm("⚠️ Clear ALL history?\n\nThis will permanently delete:\n • All uptime check history (status dots)\n • All incidents and their update timelines\n • The entire audit log\n\nServers, users, groups, webhooks, and settings will be kept.\n\nThis cannot be undone.")) return;
  const phrase = prompt("To confirm, type exactly:\n\n   DELETE ALL HISTORY\n\nThen press OK.");
  if (phrase !== "DELETE ALL HISTORY") {
    msg.textContent = "Cancelled — confirmation phrase did not match.";
    msg.style.color = "var(--orange)";
    return;
  }
  msg.textContent = "Deleting all history…"; msg.style.color = "var(--text-2)";
  try {
    const r = await fetch("/api/admin/clear-history", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ confirm: "DELETE ALL HISTORY" })
    });
    const d = await r.json();
    if (!r.ok) { msg.textContent = "Error: " + (d.error || "Failed"); msg.style.color = "var(--red)"; return; }
    const summary = `Deleted ${d.deleted.history} history, ${d.deleted.incidents} incidents, ${d.deleted.audit} audit entries.`;
    msg.textContent = "✓ " + summary; msg.style.color = "var(--green)";
    toast("All history cleared", "success");
    // Caches referencing wiped data are stale — drop them so the next tab
    // switch fetches fresh (empty) lists.
    if (typeof cacheDel === "function") {
      try { cacheDel("admin-incidents"); } catch(_) {}
    }
  } catch(e) {
    msg.textContent = "Error: " + e.message; msg.style.color = "var(--red)";
  }
}

