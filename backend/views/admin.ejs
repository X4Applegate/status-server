async function submitGroupForm(){
  const name = document.getElementById("gName").value.trim();
  const slug = document.getElementById("gSlug").value.trim();
  if (!name) { document.getElementById("gErr").textContent = "Name is required."; return; }
  if (!slug) { document.getElementById("gErr").textContent = "Slug is required."; return; }
  const id   = document.getElementById("gId").value;
  // bg_color is sent as the picked color when enabled, or empty string to clear it
  const bgEnabled = document.getElementById("gBgColorEnabled").checked;
  const body = {
    name, slug,
    description:    document.getElementById("gDesc").value.trim(),
    logo_text:      document.getElementById("gLogo").value.trim(),
    logo_image:     document.getElementById("gLogoImageData").value || "",
    logo_size:      parseInt(document.getElementById("gLogoSize").value) || 42,
    accent_color:   document.getElementById("gColor").value,
    bg_color:       bgEnabled ? document.getElementById("gBgColor").value : "",
    default_theme:  "dark",
    custom_domain:  document.getElementById("gCustomDomain").value.trim(),
    privacy_text:   document.getElementById("gPrivacyText").value.trim() || null,
    terms_text:     document.getElementById("gTermsText").value.trim()   || null,
    public_enabled: document.getElementById("gPublicEnabled").checked ? 1 : 0,
    server_ids:     Array.from(pickedServers)
  };
  try {
    const r = await fetch(id ? `/api/admin/groups/${id}` : "/api/admin/groups", {
      method: id ? "PUT" : "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    const d = await r.json();
    if (!r.ok) { document.getElementById("gErr").textContent = d.error || "Failed"; return; }
    cacheDel("admin-groups");
    cacheDel("admin-servers");
