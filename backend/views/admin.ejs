<script>

// ── Server detail view state ─────────────────────────────────────────────────
let selectedServerId = null;
let liveServers      = []; // latest snapshot from SSE / cache
let overviewIncidents = null;
let overviewMaintenance = null;
let selectedIncidentId = null;
let selectedMaintenanceId = null;
let incidentWorkspaceRequest = 0;
let maintenanceWorkspaceRequest = 0;

function toggleAdminTheme(){
  if (window.EnterpriseTheme && typeof window.EnterpriseTheme.toggle === "function") {
    window.EnterpriseTheme.toggle();
  } else {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("status-page-theme", next); } catch (_) {}
  }
  const nextLabel = document.documentElement.dataset.theme === "light" ? "dark" : "light";
  const control = document.getElementById("adminThemeToggle");
  if (control) {
    control.title = `Switch to ${nextLabel} mode`;
    control.setAttribute("aria-label", `Switch to ${nextLabel} mode`);
  }
}

function setAdminNavActive(button){
  document.querySelectorAll("#adminPrimaryNav .admin-nav-item").forEach(item => {
    item.classList.remove("active");
    item.removeAttribute("aria-current");
  });
  if (button) {
    button.classList.add("active");
    button.setAttribute("aria-current", "page");
  }
}

const adminWorkspaceIds = {
  overview:"adminOverview",
  services:"adminServiceWorkspace",
  incidents:"adminIncidentWorkspace",
  maintenance:"adminMaintenanceWorkspace",
  management:"adminManagementWorkspace",
};
const adminWorkspaceFocusIds = {
  overview:"adminOverviewTitle",
  services:"adminServiceWorkspaceTitle",
  incidents:"adminIncidentWorkspaceTitle",
  maintenance:"adminMaintenanceWorkspaceTitle",
  management:"adminManagementWorkspaceTitle",
};
let currentAdminWorkspace = "overview";
let managementLoadGeneration = 0;

const MANAGEMENT_TABS = {
  groups:   { title:"Status pages", subtitle:"Branding, domains, public access, and the services visible on each page.", directory:"Status pages", search:"Search status pages…", adminOnly:false },
  banners:  { title:"Announcements", subtitle:"Customer-facing notices, targeting, schedules, and visibility.", directory:"Announcements", search:"Search announcements…", adminOnly:true },
  webhooks: { title:"Alert channels", subtitle:"Destinations, event triggers, delivery formats, and status-page scope.", directory:"Alert channels", search:"Search alert channels…", adminOnly:false },
  omada:    { title:"Omada controllers", subtitle:"Controller access, health, sites, devices, and service onboarding.", directory:"Omada controllers", search:"Search Omada controllers…", adminOnly:false },
  unifi:    { title:"UniFi controllers", subtitle:"Controller access, health, sites, devices, and service onboarding.", directory:"UniFi controllers", search:"Search UniFi controllers…", adminOnly:false },
  square:   { title:"Square accounts", subtitle:"Monitored Square environments and their status-page access scope.", directory:"Square accounts", search:"Search Square accounts…", adminOnly:false },
  users:    { title:"Users & access", subtitle:"Roles, operator identity, and allowed status pages.", directory:"Users", search:"Search users…", adminOnly:true },
  apikeys:  { title:"API keys", subtitle:"Machine access, scopes, usage, and integration guidance.", directory:"API keys", search:"Search API keys…", adminOnly:true },
  audit:    { title:"Activity & audit", subtitle:"Authentication and configuration events across the platform.", directory:"Activity", search:"Search activity…", adminOnly:true },
  settings: { title:"Platform settings", subtitle:"Email, authentication, maps, reports, and data controls.", directory:"Settings", search:"Search settings…", adminOnly:true },
};

function ensureManagementWorkspaceDocked(){
  const host = document.getElementById("adminManagementPanelHost");
  const list = document.getElementById("aListView");
  const auxHost = document.getElementById("adminManagementAuxHost");
  if (host && list && list.parentElement !== host) host.appendChild(list);
  ["aOmadaSitesView","aUnifiSitesView"].forEach(id => {
    const view = document.getElementById(id);
    if (auxHost && view && view.parentElement !== auxHost) auxHost.appendChild(view);
  });
}

let managementAuxReturnFocus = null;

function hideManagementAux(clearReturnFocus = true){
  ["aOmadaSitesView","aUnifiSitesView"].forEach(id => {
    const view = document.getElementById(id);
    if (view) view.style.display = "none";
  });
  const content = document.getElementById("adminManagementDetailContent");
  if (content) content.style.display = "";
  if (clearReturnFocus) managementAuxReturnFocus = null;
}

function showManagementAux(id){
  ensureManagementWorkspaceDocked();
  const content = document.getElementById("adminManagementDetailContent");
  if (content?.style.display !== "none") managementAuxReturnFocus = document.activeElement;
  hideManagementAux(false);
  const view = document.getElementById(id);
  if (content) content.style.display = "none";
  if (view) {
    view.style.display = "flex";
    requestAnimationFrame(() => view.querySelector("[data-management-aux-focus]")?.focus({ preventScroll:true }));
  }
}

function closeManagementAux(){
  const returnTarget = managementAuxReturnFocus;
  hideManagementAux();
  requestAnimationFrame(() => {
    const fallback = document.querySelector("#adminPanelBody .management-record-row.active");
    const target = returnTarget && document.contains(returnTarget) && returnTarget.getClientRects().length
      ? returnTarget
      : fallback;
    target?.focus({ preventScroll:true });
  });
}

function resetManagementDetail(message = "Select a record to view its details."){
  hideManagementAux();
  const detail = document.getElementById("adminManagementDetailContent");
  if (detail) detail.innerHTML = `<div class="record-empty">${_escHtml(message)}</div>`;
}

function setManagementWorkspaceHeader(tab){
  const config = MANAGEMENT_TABS[tab];
  if (!config) return;
  document.getElementById("adminManagementWorkspaceTitle").textContent = config.title;
  document.getElementById("adminManagementWorkspaceSubtitle").textContent = config.subtitle;
  document.getElementById("managementDirectoryTitle").textContent = config.directory;
  document.getElementById("managementDirectorySubtitle").textContent = "Select a record to inspect and manage it.";
  const search = document.getElementById("serverSearchInput");
  if (search) search.placeholder = config.search;
  document.getElementById("adminManagementWorkspace")?.classList.toggle("management-wide", tab === "settings");
}

function managementLoadIsCurrent(tab, generation = managementLoadGeneration){
  return generation === managementLoadGeneration &&
    currentAdminWorkspace === "management" &&
    currentTab === tab;
}

function showAdminWorkspace(name){
  const nextWorkspace = adminWorkspaceIds[name] ? name : "overview";
  const workspaceChanged = nextWorkspace !== currentAdminWorkspace;
  if (currentAdminWorkspace === "management" && nextWorkspace !== "management") {
    managementLoadGeneration += 1;
  }
  currentAdminWorkspace = nextWorkspace;
  Object.entries(adminWorkspaceIds).forEach(([view, id]) => {
    const element = document.getElementById(id);
    if (element) element.hidden = view !== currentAdminWorkspace;
  });
  const navTarget = currentAdminWorkspace === "management"
    ? document.querySelector(`[data-nav-tab="${currentTab}"]`)
    : document.querySelector(`[data-nav-view="${currentAdminWorkspace}"]`);
  setAdminNavActive(navTarget);
  window.scrollTo({ top:0, behavior:"auto" });
  if (workspaceChanged && !activeDrawer) {
    document.getElementById(adminWorkspaceFocusIds[nextWorkspace])?.focus({ preventScroll:true });
  }
}

function showAdminOverview(){
  if (activeDrawer) closeAll();
  showAdminWorkspace("overview");
}

