  document.getElementById("aUserFormView").style.display    = "none";
  document.getElementById("aWebhookFormView").style.display = "none";
  document.getElementById("aGroupFormView").style.display   = "none";
  document.getElementById("aOmadaFormView").style.display   = "none";
  document.getElementById("aOmadaSitesView").style.display  = "flex";
  document.getElementById("oSitesHeading").textContent = `Sites — ${c.name}${c.mode === "msp" ? " · MSP" : ""}`;
  document.getElementById("oSitesSubhead").textContent = c.base_url;
  const list = document.getElementById("oSitesList");
  list.replaceChildren();
  const loading = document.createElement("div");
  loading.className = "record-empty";
  loading.textContent = "Fetching sites from controller…";
  list.appendChild(loading);
  try {
    const r = await fetch(`/api/admin/omada-controllers/${c.id}/sites`);
    if (!r.ok) {
      const d = await r.json().catch(()=>({error:"unknown"}));
      list.replaceChildren();
      const error = document.createElement("div");
      error.className = "record-empty";
      error.style.color = "var(--red)";
      error.textContent = d.error || `HTTP ${r.status}`;
      list.appendChild(error);
      return;
    }
    const sites = await r.json();
    omadaSitesCache[c.id] = sites;
    if (!sites.length) {
      list.replaceChildren();
      const empty = document.createElement("div");
      empty.className = "record-empty";
      empty.textContent = "No sites returned by this controller.";
      list.appendChild(empty);
      return;
    }
    currentOmadaCtrl = c;
    const renderSiteRow = (s, container) => {
      const sid    = s.siteId || s.id;
      const sname  = s.name || sid;
      const cid    = s.customerId || "";
      const cname  = s.customerName || "";
      const row = document.createElement("div");
      row.className = "integration-browser-row";
      const copy = document.createElement("div");
      copy.className = "integration-browser-copy";
      const name = document.createElement("div");
      name.className = "integration-browser-name";
      name.textContent = sname;
      const meta = document.createElement("div");
      meta.className = "integration-browser-meta";
      meta.textContent = sid;
      copy.append(name, meta);
      const devices = document.createElement("button");
      devices.className = "btn btn-sm";
      devices.type = "button";
      devices.textContent = "Devices";
      devices.addEventListener("click", () => showOmadaDevices(c.id, sid, sname, cid, cname));
      const gateway = document.createElement("button");
      gateway.className = "btn btn-sm btn-primary";
      gateway.type = "button";
      gateway.textContent = "+ Gateway";
      gateway.addEventListener("click", () => createServerFromSite(c.id, sid, sname, cid, cname));
      row.append(copy, devices, gateway);
      container.appendChild(row);
    };
    list.replaceChildren();
    if (c.mode === "msp") {
      const byCust = {};
      sites.forEach(s => {
        const key = s.customerId || "unknown";
        if (!byCust[key]) byCust[key] = { name: s.customerName || key, items: [] };
        byCust[key].items.push(s);
      });
      Object.values(byCust).forEach(group => {
        const section = document.createElement("section");
        section.className = "integration-browser-section";
        const title = document.createElement("h3");
        title.className = "record-section-title";
        title.textContent = group.name;
        const rows = document.createElement("div");
        rows.className = "integration-browser-list";
        group.items.forEach(site => renderSiteRow(site, rows));
        section.append(title, rows);
        list.appendChild(section);
      });
    } else {
      sites.forEach(site => renderSiteRow(site, list));
    }
  } catch(e) {
    list.replaceChildren();
    const error = document.createElement("div");
    error.className = "record-empty";
    error.style.color = "var(--red)";
    error.textContent = e.message;
    list.appendChild(error);
  }
}

// Where to bounce back to after the server form closes — used by createServerFromSite
// to return the admin to the Omada sites browser instead of the Servers tab.
let serverFormReturn = null;
// Scroll position of the server list, captured when opening the edit form
// so the admin returns to the same spot on Save / Cancel.
let serverListScrollTop = null;

// One-click: jump to the server form pre-filled with an omada_gateway check
async function createServerFromSite(controllerId, siteId, siteName, customerId, customerName){
  await showServerForm(null);
  // Set the return target AFTER showServerForm so it doesn't get cleared by edit/add flows
  serverFormReturn = { type: "omada-sites", controller: adminOmada.find(c => c.id === controllerId) };
  document.getElementById("fName").value = siteName;
  document.getElementById("fHost").value = "omada-managed";  // host is unused for omada checks but required by validation
  // Replace the default ping check with an omada_gateway check.
  // We store BOTH the IDs and the friendly names — the names are required to filter
  // /devices/known-devices (which doesn't return siteId per device).
  const check = { type: "omada_gateway", controller_id: controllerId, site_id: siteId, site_name: siteName };
  if (customerId)   check.customer_id   = customerId;
  if (customerName) check.customer_name = customerName;
  currentChecks = [check];
  renderCrows();
}

// Show APs and switches for a site in the Omada sites panel
async function showOmadaDevices(controllerId, siteId, siteName, customerId, customerName){
  const heading = document.getElementById("oSitesHeading");
  const subhead = document.getElementById("oSitesSubhead");
  const list    = document.getElementById("oSitesList");
  heading.textContent = `Devices — ${siteName}`;
  heading.focus({ preventScroll:true });
  subhead.textContent = siteId;
  list.replaceChildren();
  const loading = document.createElement("div");
  loading.className = "record-empty";
  loading.textContent = "Fetching devices…";
  list.appendChild(loading);
  const params = new URLSearchParams({ siteName: siteName||"", customerId: customerId||"", customerName: customerName||"" });
  try {
    const r = await fetch(`/api/admin/omada-controllers/${controllerId}/sites/${encodeURIComponent(siteId)}/devices?${params}`);
    const devices = r.ok ? await r.json() : [];
    if (!devices.length) {
      list.replaceChildren();
      const empty = document.createElement("div");
      empty.className = "record-empty";
      empty.textContent = "No APs or switches found in this site.";
      list.appendChild(empty);
      if (!r.ok) {
        const d = await r.json().catch(()=>({error:"unknown"}));
        empty.style.color = "var(--red)";
        empty.textContent = d.error || "Failed";
      }
      return;
    }

    // Classify devices
    const isAP     = (d) => { const t=(d.deviceType||"").toLowerCase(); const m=(d.model||"").toUpperCase(); return d.type===1||t.includes("ap")||t.includes("access")||m.startsWith("EAP"); };
    const isSwitch = (d) => { const t=(d.deviceType||"").toLowerCase(); const m=(d.model||"").toUpperCase(); return d.type===2||t.includes("switch")||m.startsWith("TL-SG")||m.startsWith("TL-SH")||m.startsWith("OC"); };
    const aps      = devices.filter(isAP);
    const switches = devices.filter(isSwitch);
    const others   = devices.filter(d => !isAP(d) && !isSwitch(d));

    const renderDevice = (d, container) => {
      const dname  = d.name || d.mac;
      const model  = d.model || "";
      const clients = d.clientNum != null ? ` · ${d.clientNum} clients` : "";
      const row = document.createElement("div");
      row.className = "integration-browser-row";
      const copy = document.createElement("div");
      copy.className = "integration-browser-copy";
      const name = document.createElement("div");
      name.className = "integration-browser-name";
      const dot = document.createElement("span");
      dot.className = `admin-dot ${d.status === 1 || d.status === 11 ? "up" : "down"}`;
      name.append(dot, document.createTextNode(` ${dname}`));
      const meta = document.createElement("div");
      meta.className = "integration-browser-meta";
      meta.textContent = `${model}${clients} · ${d.mac || "Unknown MAC"}`;
      copy.append(name, meta);
      const add = document.createElement("button");
      add.className = "btn btn-sm btn-primary";
      add.type = "button";
      add.textContent = "+ Add";
      add.addEventListener("click", () => createServerFromDevice(controllerId, siteId, siteName, customerId, customerName, d.mac, dname));
      row.append(copy, add);
      container.appendChild(row);
    };
    list.replaceChildren();
    const back = document.createElement("button");
    back.className = "btn btn-sm";
    back.type = "button";
    back.textContent = "← Back to sites";
    back.addEventListener("click", () => showOmadaSites(currentOmadaCtrl));
    list.appendChild(back);
    [["Access Points",aps],["Switches",switches],["Other Devices",others]].forEach(([title,items]) => {
      if (!items.length) return;
      const section = document.createElement("section");
      section.className = "integration-browser-section";
      const headingEl = document.createElement("h3");
      headingEl.className = "record-section-title";
      headingEl.textContent = title;
      const rows = document.createElement("div");
      rows.className = "integration-browser-list";
      items.forEach(device => renderDevice(device, rows));
      section.append(headingEl, rows);
      list.appendChild(section);
    });
  } catch(e) {
    list.replaceChildren();
    const error = document.createElement("div");
    error.className = "record-empty";
    error.style.color = "var(--red)";
    error.textContent = e.message;
    list.appendChild(error);
  }
}

// One-click: create a server entry pre-filled with an omada_device check
async function createServerFromDevice(controllerId, siteId, siteName, customerId, customerName, deviceMac, deviceName){
  await showServerForm(null);
