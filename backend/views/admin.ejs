      const rtype = (ck.record_type || "A").toUpperCase();
      const rtOpt = (t) => `<option value="${t}" ${rtype === t ? "selected" : ""}>${t}</option>`;
      detail =
        `<input class="finput" placeholder="Hostname e.g. example.com" value="${_escHtml(ck.hostname || "")}" oninput="upCk(${i},'hostname',this.value)" style="max-width:200px">` +
        `<select class="fselect" onchange="upCk(${i},'record_type',this.value)" style="max-width:90px">` +
          ["A","AAAA","CNAME","MX","TXT","NS"].map(rtOpt).join("") +
        `</select>` +
        `<input class="finput" placeholder="Expected value (optional)" value="${_escHtml(ck.expected || "")}" oninput="upCk(${i},'expected',this.value)">`;
    } else if (ck.type === "unifi_gateway" || ck.type === "unifi_wan" || ck.type === "unifi_client_count") {
