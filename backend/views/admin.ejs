    adminIncidents = await r.json();
    renderAdminIncidentList(adminIncidents);
  } catch(e) {
    el.innerHTML = `<div class="empty-state">Failed to load: ${_escHtml(e.message)}</div>`;
  }
}

function showIncidentPanel(id){
  const el = document.getElementById("incidentDetail");
  if (!el) return;
  const inc = adminIncidents.find(incident => String(incident.id) === String(id));
  if (!inc) { el.innerHTML = `<div class="record-empty">Select an incident to view its details.</div>`; return; }
  const title  = inc.title || "";
  const defaultTitle = `${inc.server_name || "Service"}${inc.cause ? " — " + String(inc.cause).split(",")[0].trim() : " incident"}`;
  const updates = Array.isArray(inc.updates) ? inc.updates.slice().reverse() : [];
  const status = inc.status || (inc.ended_at ? "resolved" : "investigating");
  const impact = inc.impact || "minor";
  const isPublic = !!inc.public;
  const isOpen = !inc.ended_at;
  const canMutate = isAdmin();
  const readOnlyAttr = canMutate ? "" : " disabled";

  const updatesHtml = updates.length ? updates.map(u => `
    <div style="padding:12px 14px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;background:var(--surface)">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
        <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--surface2);color:${_incStatusColor(u.status)};letter-spacing:.04em">${_escHtml(String(u.status || "update").toUpperCase())}</span>
