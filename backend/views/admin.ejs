function syncManagementSelection(tab, filtered){
  if (!filtered.length) {
    managementSelectedIds[tab] = null;
    resetManagementDetail(`No ${MANAGEMENT_TABS[tab]?.directory?.toLowerCase() || "records"} match this search.`);
    return null;
  }
  let selected = filtered.find(item => String(item.id) === String(managementSelectedIds[tab]));
  if (!selected) selected = filtered[0];
  managementSelectedIds[tab] = selected.id;
  renderManagementRecordDetail(tab, selected);
  return selected;
}

function selectManagementRecord(tab, id){
  const record = findManagementRecord(tab, id);
  if (!record) { resetManagementDetail("That record is no longer available."); return; }
  managementSelectedIds[tab] = record.id;
  document.querySelectorAll("#adminPanelBody [data-management-id]").forEach(row => {
    const active = row.dataset.managementTab === tab && String(row.dataset.managementId) === String(id);
    row.classList.toggle("active", active);
    if (active) row.setAttribute("aria-current", "true"); else row.removeAttribute("aria-current");
  });
  renderManagementRecordDetail(tab, record);
}

