    tab:"audit", id:entry.id, title:entry.action || "Activity", meta:entry.username || "System",
    detail:[entry.resource_type,entry.resource_name].filter(Boolean).join(" · ") || (entry.detail || "No details"),
    badge:entry.ts ? new Date(entry.ts).toLocaleDateString() : "Event", dot:String(entry.action || "").includes("delete") || String(entry.action || "").includes("failed") ? "down" : "pending"
  })).join("");
  const more = managementAuditEntries.length < managementAuditTotal
    ? `<button class="btn management-load-more" type="button" onclick="loadAuditLog(true)">Load more events</button>` : "";
  el.innerHTML = rows + more;
}

async function loadAuditLog(append = false, generation = managementLoadGeneration){
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("audit", generation)) return;
  if (!append) {
    auditOffset = 0;
    managementAuditEntries = [];
    el.innerHTML = `<div style="padding:20px;color:var(--text-2);font-size:12px">Loading…</div>`;
  }
  try {
    const res  = await fetch(`/api/audit-log?limit=${AUDIT_PAGE}&offset=${auditOffset}${auditFilterValue ? "&action="+encodeURIComponent(auditFilterValue) : ""}`);
    if (!managementLoadIsCurrent("audit", generation)) return;
    if (!res.ok) throw new Error(`Audit request failed (${res.status})`);
    const data = await res.json();
    if (!managementLoadIsCurrent("audit", generation)) return;
    const entries = Array.isArray(data.entries) ? data.entries : [];
    managementAuditEntries = append ? managementAuditEntries.concat(entries) : entries;
    managementAuditTotal = Number(data.total) || managementAuditEntries.length;
    auditOffset = managementAuditEntries.length;
    renderAuditDirectory();
  } catch(err) {
    if (!managementLoadIsCurrent("audit", generation)) return;
    if (!append) {
      el.innerHTML = `<div class="empty-state">Failed to load audit log: ${_escHtml(err.message)}</div>`;
      resetManagementDetail("Audit activity could not be loaded.");
    } else toast(err.message, "error");
  }
}

// ── Panel scroll buttons ──────────────────────────────────────────────────────
function updatePanelScrollBtns(){
  const el = document.getElementById("adminPanelBody");
  const up = document.getElementById("panelScrollUp");
  const dn = document.getElementById("panelScrollDn");
  if (!el || !up || !dn) return;
  const empty = el.childElementCount === 0;
  // Buttons are visible by default (opacity:.65); add at-limit to hide them at edges
  up.classList.toggle("at-limit", empty || el.scrollTop <= 4);
  // Hide ▼ only when we can confirm we're at the real bottom (clientHeight must be non-zero)
  const atBottom = el.clientHeight > 0 && el.scrollTop + el.clientHeight >= el.scrollHeight - 4;
  dn.classList.toggle("at-limit", empty || atBottom);
}
function panelScrollStep(dir){
  const el = document.getElementById("adminPanelBody");
  if (el) el.scrollBy({ top: dir * 220, behavior: "smooth" });
  setTimeout(updatePanelScrollBtns, 260);
}
(function(){
  const el = document.getElementById("adminPanelBody");
  if (!el) return;
  el.addEventListener("scroll", updatePanelScrollBtns, { passive: true });
  // MutationObserver fires on innerHTML changes; RAF defers until after browser layout
  new MutationObserver(() => requestAnimationFrame(updatePanelScrollBtns)).observe(el, { childList: true });
  // ResizeObserver catches any height change (content added, window resize, etc.)
  if (window.ResizeObserver) new ResizeObserver(() => requestAnimationFrame(updatePanelScrollBtns)).observe(el);
})();

// ── Toast ─────────────────────────────────────────────────────────────────────
function toast(msg, type="info"){
  const s  = document.getElementById("toasts");
  const el = document.createElement("div");
  el.className   = `toast ${type}`;
  el.textContent = msg;
  s.appendChild(el);
  setTimeout(() => el.remove(), 3000);
}

// ── Admin Map View ────────────────────────────────────────────────────────────

function _loadAdminMapLibre(cb) {
  if (window.maplibregl) { cb(); return; }
  const s = document.createElement("script");
  s.src = "https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js";
  s.onload = cb;
  document.head.appendChild(s);
}

function _getAdminMapStyle() {
  // MapLibre GL JS does not support mapbox:// URL schemes, so we always use
  // a native MapLibre-compatible style. Carto dark-matter is free and requires no API key.
  return "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json";
}

async function toggleAdminMap() {
  _adminMapActive = !_adminMapActive;
  const btn     = document.getElementById("adminMapBtn");
  const mapView = document.getElementById("adminMapView");
  if (_adminMapActive) {
    if (mapView) mapView.classList.add("active");
    if (btn)     { btn.textContent = "📋 List"; btn.classList.add("active"); }
    _loadAdminMapLibre(async () => {
      const style = _getAdminMapStyle();
      if (!_adminMap) {
        _adminMap = new maplibregl.Map({ container: "adminMapContainer", style, center: [0, 20], zoom: 2, validateStyle: false });
        _adminMap.addControl(new maplibregl.NavigationControl(), "top-right");
        _adminMap.on("load", () => { _adminMap.resize(); _renderAdminMapMarkers(); });
      } else {
        // Container is now visible — force MapLibre to recalculate dimensions
        requestAnimationFrame(() => { _adminMap.resize(); _renderAdminMapMarkers(); });
      }
    });
  } else {
    if (mapView) mapView.classList.remove("active");
    if (btn)     { btn.textContent = "🗺 Map"; btn.classList.remove("active"); }
  }
}

function _renderAdminMapMarkers() {
  if (!_adminMap || !_adminMap.isStyleLoaded()) return;
  _adminMarkers.forEach(m => m.remove());
  _adminMarkers = [];
  const colorMap = { up:"#10e88a", down:"#ff3d5a", degraded:"#ff8c2a", pending:"#5e8aad" };
  const colorPri = { up:0, degraded:1, pending:2, down:3 };
  const mapped   = liveServers.filter(s => s.lat != null && s.lng != null);
  const unmapped = liveServers.filter(s => s.lat == null || s.lng == null);

  const locMap = new Map();
  mapped.forEach(s => {
    const key = `${s.lat},${s.lng}`;
    if (!locMap.has(key)) locMap.set(key, []);
    locMap.get(key).push(s);
  });

  locMap.forEach((group, key) => {
    const worst = group.reduce((w, s) => (colorPri[s.overall]||0) > (colorPri[w.overall]||0) ? s : w, group[0]);
    const color = colorMap[worst.overall] || colorMap.pending;
    const el = document.createElement("div");
    el.style.cssText = `width:${group.length>1?22:16}px;height:${group.length>1?22:16}px;border-radius:50%;background:${color};border:2px solid #0d1829;box-shadow:0 0 6px ${color}88;cursor:pointer;display:flex;align-items:center;justify-content:center`;
    if (group.length > 1) el.innerHTML = `<span style="font-size:10px;font-weight:700;color:#0d1829;line-height:1">${group.length}</span>`;

    const rows = group.map((s, idx) => {
      const c = colorMap[s.overall] || colorMap.pending;
      const lastMs = (s.checks||[]).reduce((b,ck) => (ck.response_ms&&(b===null||ck.response_ms<b))?ck.response_ms:b, null);
      return `<div style="padding:${idx===0?"2px 0 6px":"6px 0"};${idx>0?"border-top:1px solid #1e2d45":""}">
        <div style="font-weight:600;font-size:13px;color:#fff;margin-bottom:3px;line-height:1.3">${_escHtml(s.name)}</div>
        <div style="display:flex;align-items:center;gap:10px">
          <span style="color:${c};font-weight:700;font-size:11px">${(s.overall||"pending").toUpperCase()}</span>
          ${s.host?`<span style="font-size:11px;color:#7a9abf">${_escHtml(s.host)}</span>`:""}
          ${lastMs!=null?`<span style="font-size:11px;color:#7a9abf">${lastMs}ms</span>`:""}
        </div>
      </div>`;
    }).join("");

    const popup = new maplibregl.Popup({ offset:14, maxWidth:"260px" }).setHTML(
      `<div style="font-family:sans-serif;padding:4px 2px">${rows}</div>`
    );
    const [lat, lng] = key.split(",").map(Number);
    const marker = new maplibregl.Marker({ element: el }).setLngLat([lng, lat]).setPopup(popup).addTo(_adminMap);
    _adminMarkers.push(marker);
  });

  if (mapped.length > 0) {
    try {
      const bounds = new maplibregl.LngLatBounds();
      mapped.forEach(s => bounds.extend([s.lng, s.lat]));
      _adminMap.fitBounds(bounds, { padding:60, maxZoom:14, duration:500 });
    } catch(e) {}
  }
  const unmappedEl = document.getElementById("adminMapUnmapped");
  if (unmappedEl) {
    unmappedEl.style.display = unmapped.length ? "" : "none";
    if (unmapped.length) unmappedEl.textContent = `${unmapped.length} server${unmapped.length>1?"s":""} without a location are not shown. Add one in Edit Server.`;
  }
}

function updateAdminMapBtn() {
  const btn = document.getElementById("adminMapBtn");
  if (btn) btn.style.display = liveServers.some(s => s.lat!=null&&s.lng!=null) ? "" : "none";
}

</script>
