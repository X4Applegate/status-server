async function saveWeeklyReportSettings(){
  const msg = document.getElementById("setWrMsg");
  msg.textContent = "Saving…"; msg.style.color = "var(--text-2)";
  const body = {
    enabled:    document.getElementById("setWrEnabled").checked,
    recipients: document.getElementById("setWrRecipients").value
  };
  try {
    const r = await fetch("/api/admin/settings/weekly-report", {
      method: "POST", headers: {"Content-Type":"application/json"}, body: JSON.stringify(body)
    });
    const d = await r.json();
    if (!r.ok) { msg.textContent = "Error: " + (d.error || "Failed"); msg.style.color = "var(--red)"; return; }
    msg.textContent = d.enabled ? `Saved — report will send to ${d.recipients} recipient(s) every Monday at 09:00 UTC` : "Saved — weekly report disabled";
    msg.style.color = "var(--green)";
    toast("Weekly report settings saved", "success");
  } catch(e) {
    msg.textContent = "Error: " + e.message; msg.style.color = "var(--red)";
