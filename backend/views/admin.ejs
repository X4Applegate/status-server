    body: JSON.stringify({ name, base_url, username: username||null, password: password||null, api_key: api_key||null, verify_tls, group_ids })
  });
  const data = await r.json();
  if (!r.ok) { document.getElementById("ufErr").textContent = data.error || "Error"; return; }
