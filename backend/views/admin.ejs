    if (!managementLoadIsCurrent("webhooks", generation)) return;
    cacheSet("admin-webhooks", hooks);
    renderAdminWebhookList(hooks);
  } catch(e){
    if (managementLoadIsCurrent("webhooks", generation) && !cached) el.innerHTML = `<div class="empty-state">Failed: ${e.message}</div>`;
  }
}

function updateWebhookUrlHint(){
  const fmt = document.getElementById("wFormat").value;
  const label = document.getElementById("wUrlLabel");
  const input = document.getElementById("wUrl");
  const placeholders = {
    discord:  "https://discord.com/api/webhooks/...",
    slack:    "https://hooks.slack.com/services/...",
    teams:    "https://xxxx.webhook.office.com/webhookb2/...",
    telegram: "https://api.telegram.org/bot{TOKEN}/sendMessage?chat_id={CHAT_ID}",
    pushover: "https://api.pushover.net/1/messages.json?token=***&user={USER_KEY}",
    ntfy:     "https://ntfy.sh/your-topic-name",
    email:    "alerts@example.com",
    generic:  "https://your-endpoint.example.com/webhook",
    auto:     "https://discord.com/api/webhooks/..."
  };
  if (fmt === "email") {
    label.textContent = "Email Address *";
    input.type = "email";
  } else {
    label.textContent = "URL *";
    input.type = "text";
  }
  input.placeholder = placeholders[fmt] || placeholders.auto;
}
