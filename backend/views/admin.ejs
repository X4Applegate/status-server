    await showOmadaSites(integrationReturn.controller);
  } else if (integrationReturn?.type === "omada-devices" && integrationReturn.controller) {
    await showOmadaSites(integrationReturn.controller);
    await showOmadaDevices(
      integrationReturn.controller.id,
      integrationReturn.siteId,
      integrationReturn.siteName,
      integrationReturn.customerId,
      integrationReturn.customerName,
    );
  } else if (integrationReturn?.type === "unifi-sites" && integrationReturn.controllerId) {
    await showUnifiSites(integrationReturn.controllerId);
  } else if (integrationReturn?.type === "unifi-devices" && integrationReturn.controllerId) {
    await showUnifiSites(integrationReturn.controllerId);
    await showUnifiDevices(integrationReturn.controllerId, integrationReturn.siteId, integrationReturn.siteName);
  } else if (returnState.workspace === "services") {
    await showAdminService(selectedServerId || liveServers[0]?.id);
  } else if (returnState.workspace === "maintenance") {
    await showAdminMaintenance(selectedMaintenanceId);
  } else if (returnState.workspace === "management" && MANAGEMENT_TABS[returnState.tab]) {
    await openManagementTab(returnState.tab);
  } else {
    showAdminOverview();
  }
}

function renderCrows(){
  const c = document.getElementById("crowContainer");
  if (!currentChecks.length){ c.innerHTML = "<div class=\"no-checks\">No checks yet</div>"; return; }
  c.innerHTML = currentChecks.map((ck, i) => {
    const sel = (t) => ck.type===t ? "selected" : "";
    let detail = "";
    if (ck.type === "ping") {
      detail = "<span class=\"crow-hint\">No extra config needed</span>";
    } else if (ck.type === "tcp") {
      detail = "<input class=\"finput\" placeholder=\"Port e.g. 3306\" value=\"" + _escHtml(ck.port||"") + "\" oninput=\"upCk(" + i + ",'port',parseInt(this.value)||0)\" style=\"max-width:160px\">";
    } else if (ck.type === "udp") {
      detail = "<input class=\"finput\" placeholder=\"Port e.g. 51820\" value=\"" + _escHtml(ck.port||"") + "\" oninput=\"upCk(" + i + ",'port',parseInt(this.value)||0)\" style=\"max-width:160px\"><span class=\"crow-hint\">WireGuard: 51820</span>";
    } else if (ck.type === "http") {
      // Existing checks default to showing cert info (show_cert undefined or true).
      // Only when explicitly false do we hide the cert chip.
      const showCert = ck.show_cert !== false;
      detail =
        `<input class="finput" placeholder="URL" value="${_escHtml(ck.url||"")}" oninput="upCk(${i},'url',this.value)">` +
        `<input class="finput" placeholder="Status" value="${_escHtml(ck.expectedStatus||200)}" oninput="upCk(${i},'expectedStatus',parseInt(this.value))" style="max-width:90px">` +
        `<label class="crow-hint" style="display:flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap" title="Show SSL certificate expiry on the detail view (HTTPS only)">` +
          `<input type="checkbox" ${showCert ? "checked" : ""} onchange="upCk(${i},'show_cert',this.checked)" style="margin:0">` +
          `SSL info` +
        `</label>` +
        `<input class="finput" placeholder='Body must contain (optional)' title="Treat as DOWN if the response body does NOT contain this text. Case-sensitive substring match." value="${_escHtml(ck.contains)}" oninput="upCk(${i},'contains',this.value)" style="flex:1 1 180px;min-width:140px">` +
        `<input class="finput" placeholder='Body must NOT contain (optional)' title="Treat as DOWN if the response body contains this text. Useful for catching error pages that still return 200." value="${_escHtml(ck.not_contains)}" oninput="upCk(${i},'not_contains',this.value)" style="flex:1 1 180px;min-width:140px">`;
    } else if (ck.type === "dns") {
