}

// ── Square Accounts ───────────────────────────────────────────────────────────
let adminSquare    = [];
let pendDelSquare  = null;

async function ensureSquareLoaded(){
  if (adminSquare.length) return;
  const cached = cacheGet("admin-square");
  if (cached) { adminSquare = cached; return; }
  try {
    const r = await fetch("/api/admin/square-accounts");
    if (r.ok) { adminSquare = await r.json(); cacheSet("admin-square", adminSquare); }
  } catch(e) {}
}

function renderAdminSquareList(list){
  const el = document.getElementById("adminPanelBody");
  const filtered = list.filter(account => managementMatches(account, ["name","environment","application_id"]));
  document.getElementById("aCount").textContent = `${filtered.length} account${filtered.length===1?"":"s"}`;
  document.getElementById("managementDirectorySubtitle").textContent = `${filtered.length} of ${list.length} accessible`;
  if (!filtered.length){
    el.innerHTML = `<div class="empty-state">No Square accounts yet.<br>Click <strong>Add Account</strong> to add one.</div>`;
    syncManagementSelection("square", filtered);
    return;
  }
  syncManagementSelection("square", filtered);
  el.innerHTML = filtered.map(account => managementRowMarkup({ tab:"square", id:account.id, title:account.name, meta:account.environment === "sandbox" ? "connect.squareupsandbox.com" : "connect.squareup.com", detail:account.application_id ? `App ID: ${account.application_id}` : "Application ID not set", badge:account.environment || "production", dot:"up" })).join("");
}

async function loadSquareList(generation = managementLoadGeneration){
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("square", generation)) return;
  const cached = cacheGet("admin-square");
  if (cached) { adminSquare = cached; renderAdminSquareList(adminSquare); }
  else el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading accounts...</div>`;
  try {
    const r = await fetch("/api/admin/square-accounts");
    if (!managementLoadIsCurrent("square", generation)) return;
    if (r.status === 401) { window.location.href = "/"; return; }
    if (!r.ok) { if (!cached) el.innerHTML = `<div class="empty-state">Error ${r.status}</div>`; return; }
    adminSquare = await r.json();
    if (!managementLoadIsCurrent("square", generation)) return;
    cacheSet("admin-square", adminSquare);
    renderAdminSquareList(adminSquare);
  } catch(e) {
    if (managementLoadIsCurrent("square", generation) && !cached) el.innerHTML = `<div class="empty-state">Failed to load: ${e.message}</div>`;
  }
}

async function showSquareForm(a){
  if (!isAdmin() && a?.shared_outside_scope) {
    toast("Only an admin can edit an account shared with other status pages", "error");
    return;
  }
  const editing = !!a?.id;
  openAdminEditorDrawer("aSquareFormView", editing ? "Edit Square account" : "Add Square account");
  document.getElementById("aFormView").style.display        = "none";
  document.getElementById("aUserFormView").style.display    = "none";
  document.getElementById("aWebhookFormView").style.display = "none";
  document.getElementById("aGroupFormView").style.display   = "none";
  document.getElementById("aOmadaFormView").style.display   = "none";
  document.getElementById("aOmadaSitesView").style.display  = "none";
  document.getElementById("aSquareFormView").style.display  = "flex";
  document.getElementById("sqFormHeading").textContent = editing ? "Edit Square Account" : "Add Square Account";
  document.getElementById("sqId").value     = editing ? a.id : "";
  document.getElementById("sqName").value   = a?.name           || "";
  document.getElementById("sqAppId").value  = a?.application_id || "";
  document.getElementById("sqToken").value  = "";
  document.getElementById("sqTokenHint").textContent = editing ? "(leave blank to keep existing)" : "*";
  document.getElementById("sqEnv").value    = a?.environment    || "production";
  document.getElementById("sqErr").textContent = "";
  // Populate the group picker — viewers only see groups they have access to
  await ensureGroupsLoaded();
  const pickedIds = new Set((a?.group_ids || []).map(Number));
  const picker = document.getElementById("sqGroupPicker");
  const visibleGroups = isAdmin() ? adminGroups : adminGroups.filter(g => (sessionAllowedGroupIds||[]).includes(g.id));
  if (!visibleGroups.length) {
    picker.innerHTML = `<div style="font-size:12px;color:var(--text-2);padding:4px">No groups available</div>`;
  } else {
    picker.innerHTML = visibleGroups.map(g => `
      <label style="display:flex;align-items:center;gap:8px;padding:5px 4px;cursor:pointer;border-radius:4px;font-size:13px;color:var(--text-hi)">
        <input type="checkbox" value="${g.id}" ${pickedIds.has(g.id) ? "checked" : ""} style="accent-color:var(--accent)">
        ${_escHtml(g.name)}
      </label>`).join("");
  }
}

async function submitSquareForm(){
  const id    = document.getElementById("sqId").value;
  const name  = document.getElementById("sqName").value.trim();
  const appId = document.getElementById("sqAppId").value.trim();
  const token = document.getElementById("sqToken").value.trim();
  const env   = document.getElementById("sqEnv").value;
  const err   = document.getElementById("sqErr");
  err.textContent = "";
  if (!name)          { err.textContent = "Name is required"; return; }
  if (!id && !token)  { err.textContent = "Production Access Token is required"; return; }
  const group_ids = Array.from(document.querySelectorAll("#sqGroupPicker input[type=checkbox]:checked")).map(el => parseInt(el.value));
  const body = { name, application_id: appId, environment: env, group_ids };
  if (token) body.access_token = token;
  try {
    const r = await fetch(id ? `/api/admin/square-accounts/${id}` : "/api/admin/square-accounts", {
      method: id ? "PUT" : "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    const data = await r.json();
    if (!r.ok) { err.textContent = data.error || "Save failed"; return; }
    cacheDel("admin-square");
    adminSquare = [];
    await showList();
  } catch(e) { err.textContent = e.message; }
}

function dupSquare(a){
  showSquareForm({
    name: "Copy of " + (a?.name || "Square account"),
    application_id: a?.application_id || "",
    environment: a?.environment || "production",
    group_ids: Array.isArray(a?.group_ids) ? [...a.group_ids] : []
  });
}

async function askDelSquare(id, name){
  if (!confirm(`Remove Square account "${name}"?\n\nAny server checks using this account will stop working.`)) return;
  try {
    const r = await fetch(`/api/admin/square-accounts/${id}`, { method: "DELETE" });
    const data = await r.json();
    if (!r.ok) { toast(data.error || "Delete failed", "error"); return; }
    cacheDel("admin-square");
    adminSquare = [];
    await loadSquareList();
  } catch(e) { toast(e.message, "error"); }
}

// ── Maintenance Windows ───────────────────────────────────────────────────────
let adminMaint = [];

// Convert a server-returned UTC-ish DATETIME string into a value compatible with
// <input type="datetime-local"> (which wants "YYYY-MM-DDTHH:MM" in local time).
function _toLocalInput(v){
  if (!v) return "";
  const d = new Date(v);
  if (isNaN(d)) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function _fmtWindow(start, end){
  const s = new Date(start), e = new Date(end);
  const sameDay = s.toDateString() === e.toDateString();
  const opts = { month:"short", day:"numeric", hour:"numeric", minute:"2-digit" };
  return sameDay
    ? `${s.toLocaleString(undefined, opts)} → ${e.toLocaleTimeString(undefined, {hour:"numeric",minute:"2-digit"})}`
    : `${s.toLocaleString(undefined, opts)} → ${e.toLocaleString(undefined, opts)}`;
}
function _classifyWindow(w){
  const now = Date.now();
  const s = new Date(w.start_time).getTime();
  const e = new Date(w.end_time).getTime();
  if (now < s) return { label:"Upcoming", cls:"up" };
  if (now > e) return { label:"Past",     cls:"warn" };
  return { label:"Active", cls:"down" };  // use red-ish dot so it stands out
}

function _sortMaintenance(list){
  const order = { Active:0, Upcoming:1, Past:2 };
  return list.slice().sort((a, b) => {
    const aState = _classifyWindow(a).label;
    const bState = _classifyWindow(b).label;
    if (order[aState] !== order[bState]) return order[aState] - order[bState];
    return aState === "Upcoming"
      ? new Date(a.start_time) - new Date(b.start_time)
      : new Date(b.start_time) - new Date(a.start_time);
  });
}

function maintenanceEventKey(window){
  return [window.title || "Maintenance", window.notes || "", window.start_time || "", window.end_time || ""].join("\u001f");
}

function groupMaintenanceWindows(list){
  const groupedWindows = new Map();
  list.forEach(window => {
    const key = maintenanceEventKey(window);
    const existing = groupedWindows.get(key) || { ...window, serviceNames:[], windowIds:[] };
    const serviceName = window.server_name || `Service ${window.server_id}`;
    if (!existing.serviceNames.includes(serviceName)) existing.serviceNames.push(serviceName);
    existing.windowIds.push(window.id);
    groupedWindows.set(key, existing);
  });
  return [...groupedWindows.values()];
}

function reconcileLiveMaintenanceFlags(servers, windows = overviewMaintenance){
  if (!Array.isArray(windows)) return servers;
  const activeServiceIds = new Set(windows
    .filter(window => _classifyWindow(window).label === "Active")
    .map(window => String(window.server_id)));
  return servers.map(server => ({ ...server, maintenance:activeServiceIds.has(String(server.id)) }));
}

function syncLiveMaintenanceFlags(){
  liveServers = reconcileLiveMaintenanceFlags(liveServers, adminMaint);
  renderSidebarList(liveServers);
  renderAdminOverview(liveServers);
}

function renderAdminMaintList(list){
  const el = document.getElementById("adminPanelBody");
  document.getElementById("aCount").textContent = `${list.length} window${list.length===1?"":"s"}`;
  if (!list.length){
    el.innerHTML = `<div class="empty-state">No maintenance windows scheduled.<br>Click <strong>Schedule Window</strong> to add one.</div>`;
    return;
  }
  // Sort: active first, then upcoming, then past (newest past first — list comes pre-sorted DESC on start)
  const ranked = _sortMaintenance(list);
  el.innerHTML = ranked.map(w => {
    const cls = _classifyWindow(w);
    const srvLabel = w.server_name || `(server ${w.server_id})`;
    return `<div class="admin-server-item">
      <div class="admin-dot ${cls.cls}"></div>
      <div class="admin-info">
        <div class="admin-name">${_escHtml(w.title)} <span style="font-size:10px;font-weight:600;padding:1px 6px;border-radius:8px;background:var(--surface2);color:var(--text-2);letter-spacing:.04em;vertical-align:middle;margin-left:4px">${cls.label.toUpperCase()}</span></div>
        <div class="admin-host">${_escHtml(srvLabel)}</div>
        <div class="admin-checks-label">${_escHtml(_fmtWindow(w.start_time, w.end_time))}</div>
      </div>
      <div class="admin-row-actions" onclick="event.stopPropagation()">
        <button class="btn btn-sm" data-maintenance-id="${_escHtml(w.id)}" onclick="showMaintForm(adminMaint.find(x => String(x.id) === String(this.dataset.maintenanceId)))">Edit</button>
        <button class="btn btn-sm btn-danger" data-maintenance-id="${_escHtml(w.id)}" onclick="askDelMaint(this.dataset.maintenanceId)">Cancel</button>
      </div>
    </div>`;
  }).join("");
}

function renderMaintenanceWorkspaceDirectory(){
  const host = document.getElementById("maintenanceDirectoryList");
  if (!host) return;
  const focusedId = document.activeElement?.matches?.("#maintenanceDirectoryList .record-row") ? document.activeElement.dataset.maintenanceId : null;
  const query = (document.getElementById("maintenanceWorkspaceSearch")?.value || "").trim().toLowerCase();
  const filter = document.getElementById("maintenanceWorkspaceFilter")?.value || "all";
  const serverById = new Map(liveServers.map(server => [String(server.id), server]));
  const ranked = _sortMaintenance(adminMaint);
  const filtered = ranked.filter(window => {
    const state = _classifyWindow(window).label.toLowerCase();
    if (filter !== "all" && state !== filter) return false;
    if (!query) return true;
    const server = serverById.get(String(window.server_id));
    return [window.title, window.notes, window.server_name, server?.host].some(value => String(value || "").toLowerCase().includes(query));
  });
  if (filtered.length && !filtered.some(window => String(window.id) === String(selectedMaintenanceId))) {
    selectedMaintenanceId = filtered[0].id;
    cacheSet("selected-maintenance-id", selectedMaintenanceId);
    renderMaintenanceWorkspaceDetail(filtered[0]);
  } else if (filtered.length) {
    renderMaintenanceWorkspaceDetail(filtered.find(window => String(window.id) === String(selectedMaintenanceId)));
  }
  const states = adminMaint.map(window => _classifyWindow(window).label);
  setTextIfPresent("maintenanceCountTotal", adminMaint.length);
  setTextIfPresent("maintenanceCountActive", states.filter(state => state === "Active").length);
  setTextIfPresent("maintenanceCountUpcoming", states.filter(state => state === "Upcoming").length);
  setTextIfPresent("maintenanceCountPast", states.filter(state => state === "Past").length);
  setTextIfPresent("navMaintenanceCount", groupMaintenanceWindows(adminMaint).filter(window => new Date(window.end_time).getTime() > Date.now()).length);
  setTextIfPresent("maintenanceDirectoryCount", query || filter !== "all" ? `${filtered.length} of ${adminMaint.length} windows shown` : `${adminMaint.length} maintenance window${adminMaint.length === 1 ? "" : "s"}`);
  if (!filtered.length) {
    host.innerHTML = `<div class="record-empty">${adminMaint.length ? "No maintenance windows match this filter." : "No maintenance windows scheduled yet."}</div>`;
    renderMaintenanceWorkspaceDetail(null);
    return;
  }
  host.innerHTML = filtered.map(window => {
    const state = _classifyWindow(window);
    const active = String(window.id) === String(selectedMaintenanceId);
    const dot = state.label === "Active" ? "var(--red)" : state.label === "Upcoming" ? "var(--orange)" : "var(--green)";
    return `<button class="record-row${active ? " active" : ""}" type="button" data-maintenance-id="${_escHtml(window.id)}" onclick="selectMaintenanceWindow(this.dataset.maintenanceId)"${active ? ` aria-current="true"` : ""}>
      <span class="record-row-dot" style="background:${dot}"></span><span class="record-row-copy"><span class="record-row-title">${_escHtml(window.title || "Maintenance")}</span><span class="record-row-meta">${_escHtml(window.server_name || `Service ${window.server_id}`)}</span><span class="record-row-time">${_escHtml(_fmtWindow(window.start_time, window.end_time))}</span></span><span class="record-row-badge">${state.label}</span>
    </button>`;
  }).join("");
  if (focusedId !== null) [...host.querySelectorAll(".record-row")].find(row => String(row.dataset.maintenanceId) === String(focusedId))?.focus({ preventScroll:true });
}

function renderMaintenanceWorkspaceDetail(window){
  const host = document.getElementById("maintenanceDetail");
  if (!host) return;
  if (!window) { host.innerHTML = `<div class="record-empty">Select a maintenance window to view its details.</div>`; return; }
  const state = _classifyWindow(window);
  const server = liveServers.find(item => String(item.id) === String(window.server_id));
  const serviceLabel = window.server_name || server?.name || `Service ${window.server_id}`;
  const relatedWindows = adminMaint.filter(item => maintenanceEventKey(item) === maintenanceEventKey(window));
  const relatedNotice = relatedWindows.length > 1
    ? `<div class="record-context"><strong>Multi-service schedule.</strong> This event has ${relatedWindows.length} separate service windows. Editing or cancelling here affects only ${_escHtml(serviceLabel)}.</div>`
    : "";
  host.innerHTML = `<article class="record-detail-card" aria-labelledby="selectedMaintenanceTitle">
    <header class="record-detail-head"><div><div class="record-detail-kicker">${state.label} maintenance</div><h2 class="record-detail-title" id="selectedMaintenanceTitle">${_escHtml(window.title || "Maintenance")}</h2><div class="record-detail-meta">${_escHtml(_fmtWindow(window.start_time, window.end_time))}</div></div><div class="record-detail-actions"><button class="btn" type="button" data-maintenance-id="${_escHtml(window.id)}" onclick="openMaintenanceEditor(this.dataset.maintenanceId)">Edit window</button><button class="btn btn-danger" type="button" data-maintenance-id="${_escHtml(window.id)}" onclick="askDelMaint(this.dataset.maintenanceId)">Cancel window</button></div></header>
    <div class="record-detail-body">${relatedNotice}<section class="record-section" aria-labelledby="maintenanceFactsTitle"><h3 class="record-section-title" id="maintenanceFactsTitle">Window details</h3><div class="record-facts"><div class="record-fact"><div class="record-fact-label">Service</div><div class="record-fact-value">${_escHtml(serviceLabel)}</div></div><div class="record-fact"><div class="record-fact-label">Host</div><div class="record-fact-value">${_escHtml(server?.host || "Not available")}</div></div><div class="record-fact"><div class="record-fact-label">Duration</div><div class="record-fact-value">${_escHtml(_incFmtDuration((new Date(window.end_time) - new Date(window.start_time)) / 1000))}</div></div><div class="record-fact"><div class="record-fact-label">Created</div><div class="record-fact-value">${_escHtml(_incFmtDate(window.created_at) || "Not available")}</div></div><div class="record-fact"><div class="record-fact-label">Status-change alerts</div><div class="record-fact-value">${state.label === "Active" ? "Suppressed during this window" : state.label === "Upcoming" ? "Will be suppressed during window" : "Normal alerting resumed"}</div></div></div></section>
    <section class="record-section" aria-labelledby="maintenanceNotesTitle"><h3 class="record-section-title" id="maintenanceNotesTitle">Customer-facing notes</h3><div class="record-notes">${_escHtml(window.notes || "No customer-facing notes were provided.")}</div></section></div>
  </article>`;
}

function selectMaintenanceWindow(id){
  const match = adminMaint.find(window => String(window.id) === String(id));
  if (!match) { selectedMaintenanceId = null; cacheDel("selected-maintenance-id"); renderMaintenanceWorkspaceDirectory(); renderMaintenanceWorkspaceDetail(null); return; }
  selectedMaintenanceId = match.id;
  cacheSet("selected-maintenance-id", match.id);
  renderMaintenanceWorkspaceDirectory();
  renderMaintenanceWorkspaceDetail(match);
}

async function loadMaintenanceWorkspace(preferredId = selectedMaintenanceId){
  const requestId = ++maintenanceWorkspaceRequest;
  const listHost = document.getElementById("maintenanceDirectoryList");
  const detailHost = document.getElementById("maintenanceDetail");
  if (listHost) listHost.innerHTML = `<div class="record-empty">Loading maintenance…</div>`;
  if (detailHost) detailHost.innerHTML = `<div class="record-empty">Loading selected window…</div>`;
  try {
    const response = await fetch("/api/admin/maintenance");
    if (response.status === 401) { window.location.href = "/login"; return; }
    if (!response.ok) throw new Error(`Maintenance request failed (${response.status})`);
    const data = await response.json();
    if (requestId !== maintenanceWorkspaceRequest) return;
    adminMaint = Array.isArray(data) ? data : [];
    overviewMaintenance = adminMaint;
    syncLiveMaintenanceFlags();
    const cachedId = cacheGet("selected-maintenance-id");
    const candidate = [preferredId, cachedId].find(id => id !== null && id !== undefined && adminMaint.some(window => String(window.id) === String(id)));
    const first = _sortMaintenance(adminMaint)[0];
    selectedMaintenanceId = candidate ?? first?.id ?? null;
    if (selectedMaintenanceId === null) cacheDel("selected-maintenance-id"); else cacheSet("selected-maintenance-id", selectedMaintenanceId);
    renderMaintenanceWorkspaceDirectory();
    renderAdminOverviewActivity();
  } catch (error) {
    if (requestId !== maintenanceWorkspaceRequest) return;
    if (listHost) listHost.innerHTML = `<div class="record-empty">Maintenance could not be loaded. Try again.</div>`;
    if (detailHost) detailHost.innerHTML = `<div class="record-empty">${_escHtml(error.message)}</div>`;
  }
}

async function loadMaintList(){
  const el = document.getElementById("adminPanelBody");
  el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading maintenance windows…</div>`;
  try {
    const r = await fetch("/api/admin/maintenance");
    if (r.status === 401) { window.location.href = "/"; return; }
    if (!r.ok) { el.innerHTML = `<div class="empty-state">Error ${r.status}</div>`; return; }
    adminMaint = await r.json();
    renderAdminMaintList(adminMaint);
  } catch(e) {
    el.innerHTML = `<div class="empty-state">Failed to load: ${_escHtml(e.message)}</div>`;
  }
}

async function showMaintForm(w){
  openAdminEditorDrawer("aMaintFormView", w ? "Edit maintenance window" : "Schedule maintenance");
  document.getElementById("aFormView").style.display        = "none";
  document.getElementById("aUserFormView").style.display    = "none";
  document.getElementById("aWebhookFormView").style.display = "none";
  document.getElementById("aGroupFormView").style.display   = "none";
  document.getElementById("aOmadaFormView").style.display   = "none";
  document.getElementById("aOmadaSitesView").style.display  = "none";
  document.getElementById("aSquareFormView").style.display  = "none";
  document.getElementById("aMaintFormView").style.display   = "flex";
  document.getElementById("mwFormHeading").textContent = w ? "Edit Maintenance Window" : "Schedule Maintenance Window";
  document.getElementById("mwId").value    = w?.id    || "";
  document.getElementById("mwTitle").value = w?.title || "";
  document.getElementById("mwNotes").value = w?.notes || "";
  // Default: start = now + 5 min, end = now + 1 hour (only when creating)
  if (w) {
    document.getElementById("mwStart").value = _toLocalInput(w.start_time);
    document.getElementById("mwEnd").value   = _toLocalInput(w.end_time);
  } else {
    const start = new Date(Date.now() + 5 * 60 * 1000);
    const end   = new Date(Date.now() + 60 * 60 * 1000);
    document.getElementById("mwStart").value = _toLocalInput(start);
    document.getElementById("mwEnd").value   = _toLocalInput(end);
  }
  document.getElementById("mwErr").textContent = "";

  // Populate server picker — edit mode is locked to the window's single server,
  // create mode lets you multi-select (one row per server is inserted server-side).
  await ensureAdminServersLoaded();
  const picker = document.getElementById("mwServerPicker");
  if (w) {
    // Edit: pin to the one server this window belongs to (server_id field is not editable)
    picker.innerHTML = `<div style="font-size:12px;color:var(--text-2);padding:4px 2px">Server: <strong style="color:var(--text-hi)">${_escHtml(w.server_name || w.server_id)}</strong><br><span style="font-size:11px">(server locked when editing — delete and re-create to move this window)</span></div>`;
    picker.dataset.lockedServerId = w.server_id;
  } else {
    delete picker.dataset.lockedServerId;
    if (!adminServers.length) {
      picker.innerHTML = `<div style="font-size:12px;color:var(--text-2);padding:4px">No servers available</div>`;
    } else {
      picker.innerHTML = adminServers.map(s => `
        <label style="display:flex;align-items:center;gap:8px;padding:5px 4px;cursor:pointer;border-radius:4px;font-size:13px;color:var(--text-hi)">
          <input type="checkbox" value="${_escHtml(s.id)}" style="accent-color:var(--accent)">
          <span style="flex:1">${_escHtml(s.name)}</span>
          <span style="font-size:11px;color:var(--text-2)">${_escHtml(s.host || "")}</span>
        </label>`).join("");
    }
  }
}

async function ensureAdminServersLoaded(){
  if (adminServers && adminServers.length) return;
  const cached = cacheGet("admin-servers");
  if (cached) { adminServers = cached; return; }
  try {
    const r = await fetch("/api/admin/servers");
    if (r.ok) { adminServers = await r.json(); cacheSet("admin-servers", adminServers); }
  } catch(e) {}
}

async function submitMaintForm(){
  const id    = document.getElementById("mwId").value;
  const title = document.getElementById("mwTitle").value.trim();
  const notes = document.getElementById("mwNotes").value.trim();
  const start = document.getElementById("mwStart").value;
  const end   = document.getElementById("mwEnd").value;
  const err   = document.getElementById("mwErr");
  err.textContent = "";
  if (!title)         { err.textContent = "Title is required"; return; }
  if (!start || !end) { err.textContent = "Start and end times are required"; return; }
  const startDate = new Date(start);
  const endDate = new Date(end);
  if (!Number.isFinite(startDate.getTime()) || !Number.isFinite(endDate.getTime())) { err.textContent = "Start and end times must be valid"; return; }
  if (endDate <= startDate) { err.textContent = "End time must be after start time"; return; }

  let server_ids;
  const picker = document.getElementById("mwServerPicker");
  if (id) {
    // Edit mode — server is locked
    server_ids = [picker.dataset.lockedServerId];
  } else {
    server_ids = Array.from(picker.querySelectorAll("input[type=checkbox]:checked")).map(el => el.value);
    if (!server_ids.length) { err.textContent = "Pick at least one server"; return; }
  }

  const body = { title, notes, start_time: startDate.toISOString(), end_time: endDate.toISOString() };
  if (!id) body.server_ids = server_ids;

  try {
    const r = await fetch(id ? `/api/admin/maintenance/${encodeURIComponent(id)}` : "/api/admin/maintenance", {
      method: id ? "PUT" : "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    const data = await r.json();
    if (!r.ok) { err.textContent = data.error || "Save failed"; return; }
    closeAdmin();
    if (!id) { selectedMaintenanceId = null; cacheDel("selected-maintenance-id"); }
    await loadMaintenanceWorkspace(id || null);
    focusSelectedMaintenanceRow();
  } catch(e) { err.textContent = e.message; }
}

async function askDelMaint(id){
  const current = adminMaint.find(window => String(window.id) === String(id));
  if (!current) { toast("Maintenance window is no longer available", "error"); return; }
  const title = current.title || "Maintenance";
  if (!confirm(`Cancel maintenance window "${title}"?\n\nFuture status-change alerts will no longer be suppressed for this service.`)) return;
  try {
    const r = await fetch(`/api/admin/maintenance/${encodeURIComponent(id)}`, { method: "DELETE" });
    const data = await r.json();
    if (!r.ok) { toast(data.error || "Delete failed", "error"); return; }
    if (activeDrawer === "adminDrawer") closeAdmin();
    await loadMaintenanceWorkspace();
    focusSelectedMaintenanceRow();
  } catch(e) { toast(e.message, "error"); }
}

function focusSelectedMaintenanceRow(){
  requestAnimationFrame(() => {
    [...document.querySelectorAll("#maintenanceDirectoryList .record-row")]
      .find(row => String(row.dataset.maintenanceId) === String(selectedMaintenanceId))
      ?.focus({ preventScroll:true });
  });
}

// ── Incidents ─────────────────────────────────────────────────────────────────
// The incident feature has three pieces:
//   1. Automated detection (server.js) opens/closes incidents from failed checks
//   2. This admin UI lets operators edit title/impact/public flag and post
//      customer-facing updates that appear on the public /dashboard/:slug/incidents page
//   3. The public page polls /api/public/group/:slug/incidents for rendering
let adminIncidents = [];

function _incStatusColor(status){
  return status === "investigating" ? "var(--red)"
       : status === "identified"    ? "var(--orange)"
       : status === "monitoring"    ? "#a78bfa"
       : /* resolved */               "var(--green)";
}
function _incImpactColor(impact){
  return impact === "critical" ? "var(--red)"
       : impact === "major"    ? "var(--orange)"
       :                         "var(--text-2)";
}
function _incFmtDate(iso){
  if (!iso) return "";
  try { return new Date(iso).toLocaleString(undefined, {month:"short", day:"numeric", hour:"numeric", minute:"2-digit"}); }
  catch(e) { return iso; }
}
function _incFmtDuration(seconds){
  const s = Math.max(0, Math.round(Number(seconds)||0));
  if (s < 60) return s+"s";
  if (s < 3600) return Math.floor(s/60)+"m "+(s%60)+"s";
  if (s < 86400) { const h=Math.floor(s/3600), m=Math.floor((s%3600)/60); return h+"h "+String(m).padStart(2,"0")+"m"; }
  const d=Math.floor(s/86400), h=Math.floor((s%86400)/3600); return d+"d "+h+"h";
}

function renderAdminIncidentList(list){
  const el = document.getElementById("adminPanelBody");
  document.getElementById("aCount").textContent = `${list.length} incident${list.length===1?"":"s"}`;
  if (!list.length){
    el.innerHTML = `<div class="empty-state">No incidents yet.<br>Incidents open automatically when a server's checks fail. You can also post manual updates from here.</div>`;
    return;
  }
  // Open incidents first, then recent resolved (list arrives DESC by started_at)
  const open   = list.filter(x => !x.ended_at);
  const closed = list.filter(x =>  x.ended_at);
  const ordered = [...open, ...closed];

  el.innerHTML = ordered.map(inc => {
    const status = inc.status || (inc.ended_at ? "resolved" : "investigating");
    const impact = inc.impact || "minor";
    const title  = inc.title || (inc.server_name + (inc.cause ? " — " + (inc.cause.split(",")[0].trim()) : ""));
    const isOpen = !inc.ended_at;
    const meta = isOpen
      ? `<span style="color:var(--red);font-weight:600">OPEN</span> · started ${_incFmtDate(inc.started_at)}`
      : `Resolved · ${_incFmtDuration(inc.duration_s)} · ended ${_incFmtDate(inc.ended_at)}`;
    const publicFlag = inc.public
      ? `<span title="Visible on public incident page" style="color:var(--text-2);font-size:11px">🌐 public</span>`
      : `<span title="Hidden from public incident page" style="color:var(--orange);font-size:11px">🔒 private</span>`;
    return `<div class="admin-server-item" style="align-items:flex-start">
      <div class="admin-dot" style="background:${_incStatusColor(status)};margin-top:6px"></div>
      <div class="admin-info" style="min-width:0;flex:1">
        <div class="admin-name" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <span style="overflow:hidden;text-overflow:ellipsis">${_escHtml(title)}</span>
          <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--surface2);color:${_incStatusColor(status)};letter-spacing:.04em">${status.toUpperCase()}</span>
          <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--surface2);color:${_incImpactColor(impact)};letter-spacing:.04em">${impact.toUpperCase()}</span>
          ${publicFlag}
        </div>
        <div class="admin-host">${_escHtml(inc.server_name)}</div>
        <div class="admin-checks-label">${meta}</div>
      </div>
      <div class="admin-row-actions" onclick="event.stopPropagation()">
        <button class="btn btn-sm" type="button" data-incident-id="${_escHtml(inc.id)}" onclick="closeAdmin();showAdminIncidents(this.dataset.incidentId)">${isAdmin() ? "Manage" : "View"}</button>
      </div>
    </div>`;
  }).join("");
}

function _escHtml(s){ return String(s ?? "").replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

function _incidentTitle(incident){
  return incident.title || `${incident.server_name || "Service"}${incident.cause ? ` — ${String(incident.cause).split(",")[0].trim()}` : " incident"}`;
}

function renderIncidentWorkspaceDirectory(){
  const host = document.getElementById("incidentDirectoryList");
  if (!host) return;
  const focusedId = document.activeElement?.matches?.("#incidentDirectoryList .record-row") ? document.activeElement.dataset.incidentId : null;
  const query = (document.getElementById("incidentWorkspaceSearch")?.value || "").trim().toLowerCase();
  const filterSelect = document.getElementById("incidentWorkspaceFilter");
  const privateOption = filterSelect?.querySelector('option[value="private"]');
  if (privateOption) privateOption.hidden = !isAdmin();
  if (!isAdmin() && filterSelect?.value === "private") filterSelect.value = "all";
  const filter = filterSelect?.value || "all";
  const ordered = [...adminIncidents.filter(incident => !incident.ended_at), ...adminIncidents.filter(incident => incident.ended_at)];
  const filtered = ordered.filter(incident => {
    const isOpen = !incident.ended_at;
    if (filter === "open" && !isOpen) return false;
    if (filter === "resolved" && isOpen) return false;
    if (filter === "public" && !incident.public) return false;
    if (filter === "private" && incident.public) return false;
    if (!query) return true;
    return [_incidentTitle(incident), incident.server_name, incident.cause, incident.status, incident.impact].some(value => String(value || "").toLowerCase().includes(query));
  });
  if (filtered.length && !filtered.some(incident => String(incident.id) === String(selectedIncidentId))) {
    selectedIncidentId = filtered[0].id;
    cacheSet("selected-incident-id", selectedIncidentId);
    showIncidentPanel(filtered[0].id);
  } else if (filtered.length) {
    showIncidentPanel(selectedIncidentId);
  }
  const openCount = adminIncidents.filter(incident => !incident.ended_at).length;
  setTextIfPresent("incidentCountTotal", adminIncidents.length);
  setTextIfPresent("incidentCountOpen", openCount);
  setTextIfPresent("incidentCountResolved", adminIncidents.length - openCount);
  setTextIfPresent("navIncidentCount", openCount);
  setTextIfPresent("incidentDirectoryCount", query || filter !== "all" ? `${filtered.length} of ${adminIncidents.length} incidents shown` : `${adminIncidents.length} incident${adminIncidents.length === 1 ? "" : "s"}`);
  if (!filtered.length) {
    host.innerHTML = `<div class="record-empty">${adminIncidents.length ? "No incidents match this filter." : "No incidents have been recorded yet."}</div>`;
    showIncidentPanel(null);
    return;
  }
  host.innerHTML = filtered.map(incident => {
    const status = incident.status || (incident.ended_at ? "resolved" : "investigating");
    const active = String(incident.id) === String(selectedIncidentId);
    return `<button class="record-row${active ? " active" : ""}" type="button" data-incident-id="${_escHtml(incident.id)}" onclick="selectIncident(this.dataset.incidentId)"${active ? ` aria-current="true"` : ""}>
      <span class="record-row-dot" style="background:${_incStatusColor(status)}"></span><span class="record-row-copy"><span class="record-row-title">${_escHtml(_incidentTitle(incident))}</span><span class="record-row-meta">${_escHtml(incident.server_name || "Service")} · ${_escHtml(incident.impact || "minor")} impact · ${incident.public ? "Public" : "Private"}</span><span class="record-row-time">Started ${_escHtml(_incFmtDate(incident.started_at))}</span></span><span class="record-row-badge" style="color:${_incStatusColor(status)}">${_escHtml(status)}</span>
    </button>`;
  }).join("");
  if (focusedId !== null) [...host.querySelectorAll(".record-row")].find(row => String(row.dataset.incidentId) === String(focusedId))?.focus({ preventScroll:true });
}

function selectIncident(id){
  const match = adminIncidents.find(incident => String(incident.id) === String(id));
  if (!match) { selectedIncidentId = null; cacheDel("selected-incident-id"); renderIncidentWorkspaceDirectory(); showIncidentPanel(null); return; }
  selectedIncidentId = match.id;
  cacheSet("selected-incident-id", match.id);
  renderIncidentWorkspaceDirectory();
  showIncidentPanel(match.id);
}

function invalidateIncidentServiceCache(id){
  const incident = adminIncidents.find(item => String(item.id) === String(id));
  if (incident?.server_id !== null && incident?.server_id !== undefined) cacheDel(`detail-${incident.server_id}`);
}

async function loadIncidentWorkspace(preferredId = selectedIncidentId){
  const requestId = ++incidentWorkspaceRequest;
  const listHost = document.getElementById("incidentDirectoryList");
  const detailHost = document.getElementById("incidentDetail");
  if (listHost) listHost.innerHTML = `<div class="record-empty">Loading incidents…</div>`;
  if (detailHost) detailHost.innerHTML = `<div class="record-empty">Loading selected incident…</div>`;
  try {
    const response = await fetch("/api/admin/incidents");
    if (response.status === 401) { window.location.href = "/login"; return; }
    if (!response.ok) throw new Error(`Incident request failed (${response.status})`);
    const data = await response.json();
    if (requestId !== incidentWorkspaceRequest) return;
    adminIncidents = Array.isArray(data) ? data : [];
    overviewIncidents = adminIncidents;
    const cachedId = cacheGet("selected-incident-id");
    const candidate = [preferredId, cachedId].find(id => id !== null && id !== undefined && adminIncidents.some(incident => String(incident.id) === String(id)));
    selectedIncidentId = candidate ?? adminIncidents[0]?.id ?? null;
    if (selectedIncidentId === null) cacheDel("selected-incident-id"); else cacheSet("selected-incident-id", selectedIncidentId);
    renderIncidentWorkspaceDirectory();
    renderAdminOverviewActivity();
  } catch (error) {
    if (requestId !== incidentWorkspaceRequest) return;
    if (listHost) listHost.innerHTML = `<div class="record-empty">Incidents could not be loaded. Try again.</div>`;
    if (detailHost) detailHost.innerHTML = `<div class="record-empty">${_escHtml(error.message)}</div>`;
  }
}

async function loadIncidentList(){
  const el = document.getElementById("adminPanelBody");
  el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading incidents…</div>`;
  try {
    const r = await fetch("/api/admin/incidents");
    if (r.status === 401) { window.location.href = "/"; return; }
