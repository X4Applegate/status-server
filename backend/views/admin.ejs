  el.innerHTML = `
    <article class="record-detail-card" aria-labelledby="selectedIncidentTitle">
      <header class="record-detail-head"><div><div class="record-detail-kicker">${_escHtml(inc.server_name || "Service")} · ${isPublic ? "Public" : "Private"}</div><h2 class="record-detail-title" id="selectedIncidentTitle">${_escHtml(inc.title || defaultTitle)}</h2><div class="record-detail-meta">Started ${_escHtml(_incFmtDate(inc.started_at))} · ${isOpen ? '<span style="color:var(--red);font-weight:600">Ongoing</span>' : `Resolved after ${_escHtml(_incFmtDuration(inc.duration_s))}`}</div></div><div class="record-detail-actions"><span class="record-row-badge" style="color:${_incStatusColor(status)}">${_escHtml(status)}</span><span class="record-row-badge" style="color:${_incImpactColor(impact)}">${_escHtml(impact)} impact</span>${canMutate ? `<button class="btn btn-danger" type="button" data-incident-id="${_escHtml(inc.id)}" onclick="askDelIncident(this.dataset.incidentId)">Delete incident</button>` : ""}</div></header>
      <div class="record-detail-body">

      ${canMutate ? "" : `<div class="record-readonly">Read-only access: incident details and updates are visible, but only administrators can publish changes.</div>`}

      <section class="record-section" aria-labelledby="incidentDetailsTitle">
        <h3 class="record-section-title" id="incidentDetailsTitle">Incident details</h3>
        <div class="form-grid">
          <div class="fg full">
            <label class="flabel" for="incTitle">Custom Title <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-2)">(leave blank to use "${_escHtml(defaultTitle)}")</span></label>
            <input class="finput" id="incTitle" maxlength="200" value="${_escHtml(title)}" placeholder="${_escHtml(defaultTitle)}"${readOnlyAttr}>
          </div>
          <div class="fg">
            <label class="flabel" for="incImpact">Impact</label>
            <select class="fselect" id="incImpact"${readOnlyAttr}>
              <option value="minor"    ${impact==="minor"?"selected":""}>Minor</option>
              <option value="major"    ${impact==="major"?"selected":""}>Major</option>
              <option value="critical" ${impact==="critical"?"selected":""}>Critical</option>
            </select>
          </div>
          <div class="fg">
            <label class="flabel" for="incPublic">Visibility</label>
            <select class="fselect" id="incPublic"${readOnlyAttr}>
              <option value="1" ${isPublic?"selected":""}>🌐 Public — shown on incident page</option>
              <option value="0" ${!isPublic?"selected":""}>🔒 Private — admin only</option>
            </select>
          </div>
        </div>
        ${canMutate ? `<div style="display:flex;justify-content:flex-end;margin-top:14px"><button class="btn btn-primary" type="button" data-incident-id="${_escHtml(inc.id)}" onclick="submitIncidentMeta(this.dataset.incidentId)">Save details</button></div>` : ""}
      </section>

      ${updateComposer}

      <section class="record-section" aria-labelledby="incidentTimelineTitle">
        <h3 class="record-section-title" id="incidentTimelineTitle">Timeline</h3>
        ${updatesHtml}
      </section>
      </div>
    </article>
  `;
}

async function submitIncidentMeta(id){
  const title  = document.getElementById("incTitle").value.trim();
  const impact = document.getElementById("incImpact").value;
  const isPublic = document.getElementById("incPublic").value === "1";
  try {
    const r = await fetch(`/api/admin/incidents/${encodeURIComponent(id)}`, {
      method: "PUT",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ title: title || null, impact, public: isPublic })
    });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Update failed", "error"); return; }
    toast("Incident details saved", "success");
    invalidateIncidentServiceCache(id);
    await loadIncidentWorkspace(id);
  } catch(e) { toast(e.message, "error"); }
}

async function submitIncidentUpdate(id){
  const status = document.getElementById("incNewStatus").value;
  const message = document.getElementById("incNewMsg").value.trim();
  if (!message) { toast("Update message is required", "error"); return; }
  try {
    const r = await fetch(`/api/admin/incidents/${encodeURIComponent(id)}/updates`, {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ status, message })
    });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Post failed", "error"); return; }
    toast(status === "resolved" ? "Incident resolved" : "Update posted", "success");
    invalidateIncidentServiceCache(id);
    await loadIncidentWorkspace(id);
  } catch(e) { toast(e.message, "error"); }
}

async function askDelIncidentUpdate(updateId, incidentId){
  if (!confirm("Delete this update? This cannot be undone.")) return;
  try {
    const r = await fetch(`/api/admin/incident-updates/${encodeURIComponent(updateId)}`, { method: "DELETE" });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Delete failed", "error"); return; }
    invalidateIncidentServiceCache(incidentId);
    await loadIncidentWorkspace(incidentId);
  } catch(e) { toast(e.message, "error"); }
}

async function askDelIncident(id){
  if (!confirm("Delete this entire incident and all its updates?\n\nThis cannot be undone and will remove the incident from the public page.")) return;
  try {
    const r = await fetch(`/api/admin/incidents/${encodeURIComponent(id)}`, { method: "DELETE" });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Delete failed", "error"); return; }
    toast("Incident deleted", "success");
    invalidateIncidentServiceCache(id);
    selectedIncidentId = null;
    cacheDel("selected-incident-id");
    await loadIncidentWorkspace();
  } catch(e) { toast(e.message, "error"); }
}

// ── Banners ────────────────────────────────────────────────────────────────
// Admin-authored announcements that render on the public dashboard above the
// auto-status bar. Can be global (group_id NULL → all dashboards) or scoped
// to a single group. Supports time windows, severity colors, and optional CTA.
let adminBanners = [];

function _bnSeverityLabel(sev){
  return sev === "critical" ? "🚨 Critical"
       : sev === "warning"  ? "⚠️ Warning"
       : sev === "success"  ? "✅ Success"
       :                      "ℹ️ Info";
}
function _bnIsActiveNow(b){
  if (!b.active) return false;
  const now = Date.now();
  if (b.starts_at && new Date(b.starts_at).getTime() > now) return false;
  if (b.ends_at   && new Date(b.ends_at).getTime()   < now) return false;
  return true;
}
function _bnWindowLabel(b){
  if (!b.starts_at && !b.ends_at) return "Always on";
  const s = b.starts_at ? new Date(b.starts_at).toLocaleString(undefined, {month:"short",day:"numeric",hour:"numeric",minute:"2-digit"}) : "now";
  const e = b.ends_at   ? new Date(b.ends_at).toLocaleString(undefined, {month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})   : "no end";
  return `${s} → ${e}`;
}
function _bnToLocalInput(iso){
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2,"0");
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function renderAdminBannerList(list){
  const el = document.getElementById("adminPanelBody");
  const filtered = list.filter(banner => managementMatches(banner, ["title","message","severity","group_name",banner => _bnWindowLabel(banner)]));
  document.getElementById("aCount").textContent = `${filtered.length} announcement${filtered.length===1?"":"s"}`;
  document.getElementById("managementDirectorySubtitle").textContent = `${filtered.length} of ${list.length} announcements`;
  if (!filtered.length){
    el.innerHTML = `<div class="empty-state">No banners yet.<br>Click <strong>Add Banner</strong> to announce scheduled maintenance, incidents, or release notes.</div>`;
    syncManagementSelection("banners", filtered);
    return;
  }
  syncManagementSelection("banners", filtered);
  el.innerHTML = filtered.map(b => {
    const isLive = _bnIsActiveNow(b);
    const statusLabel = !b.active ? "DISABLED" : (isLive ? "LIVE" : "SCHEDULED");
    const target = b.group_name ? b.group_name : "🌐 All dashboards";
    const preview = (b.title ? b.title + " — " : "") + (b.message || "").slice(0, 120);
    return managementRowMarkup({ tab:"banners", id:b.id, title:_bnSeverityLabel(b.severity), meta:preview, detail:`${target} · ${_bnWindowLabel(b)}`, badge:statusLabel, dot:!b.active ? "pending" : isLive ? "up" : "degraded" });
  }).join("");
}

async function loadBannerList(generation = managementLoadGeneration){
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("banners", generation)) return;
  el.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text-2)">Loading banners…</div>`;
  try {
    const r = await fetch("/api/admin/banners");
    if (!managementLoadIsCurrent("banners", generation)) return;
    if (r.status === 401) { window.location.href = "/"; return; }
    if (r.status === 403) { el.innerHTML = `<div class="empty-state">Admin role required.</div>`; return; }
    if (!r.ok) { el.innerHTML = `<div class="empty-state">Error ${r.status}</div>`; return; }
    adminBanners = await r.json();
    if (!managementLoadIsCurrent("banners", generation)) return;
    renderAdminBannerList(adminBanners);
  } catch(e) {
    if (managementLoadIsCurrent("banners", generation)) el.innerHTML = `<div class="empty-state">Failed to load: ${e.message}</div>`;
  }
}

async function _bnEnsureGroupsLoaded(){
  // Reuse the admin group list so the target dropdown stays in sync
  if (typeof adminGroups !== "undefined" && adminGroups && adminGroups.length) return adminGroups;
  try {
    const r = await fetch("/api/admin/groups");
    if (r.ok) return await r.json();
  } catch(e) {}
  return [];
}

async function showBannerForm(banner){
  openAdminEditorDrawer("aBannerFormView", banner ? "Edit announcement" : "Add announcement");
  document.getElementById("aBannerFormView").style.display = "flex";
  document.getElementById("bnFormHeading").textContent = banner ? "Edit Banner" : "Add Banner";
  document.getElementById("bnId").value         = banner ? banner.id : "";
  document.getElementById("bnMessage").value    = banner ? (banner.message || "") : "";
  document.getElementById("bnTitle").value      = banner ? (banner.title || "") : "";
  document.getElementById("bnSeverity").value   = banner ? (banner.severity || "info") : "info";
  document.getElementById("bnLinkUrl").value    = banner ? (banner.link_url || "") : "";
  document.getElementById("bnLinkText").value   = banner ? (banner.link_text || "") : "";
  document.getElementById("bnStartsAt").value   = banner ? _bnToLocalInput(banner.starts_at) : "";
  document.getElementById("bnEndsAt").value     = banner ? _bnToLocalInput(banner.ends_at)   : "";
  document.getElementById("bnActive").checked      = banner ? !!banner.active      : true;
  document.getElementById("bnDismissible").checked = banner ? !!banner.dismissible : true;
  document.getElementById("bnErr").textContent = "";

  // Populate group dropdown
  const sel = document.getElementById("bnGroupId");
  const groups = await _bnEnsureGroupsLoaded();
  const currentGid = banner ? (banner.group_id ?? "") : "";
  sel.innerHTML = `<option value="">🌐 All dashboards (global)</option>` +
    groups.map(g => `<option value="${g.id}" ${String(currentGid) === String(g.id) ? "selected" : ""}>${_escHtml(g.name)}</option>`).join("");
}

async function submitBannerForm(){
  const err = document.getElementById("bnErr");
  err.textContent = "";
  const id      = document.getElementById("bnId").value;
  const message = document.getElementById("bnMessage").value.trim();
  if (!message) { err.textContent = "Message is required"; return; }
  const payload = {
    message,
    title:       document.getElementById("bnTitle").value.trim() || null,
    severity:    document.getElementById("bnSeverity").value,
    group_id:    document.getElementById("bnGroupId").value || null,
    link_url:    document.getElementById("bnLinkUrl").value.trim() || null,
    link_text:   document.getElementById("bnLinkText").value.trim() || null,
    starts_at:   document.getElementById("bnStartsAt").value || null,
    ends_at:     document.getElementById("bnEndsAt").value   || null,
    active:      document.getElementById("bnActive").checked,
    dismissible: document.getElementById("bnDismissible").checked
  };
  try {
    const r = await fetch(id ? `/api/admin/banners/${id}` : "/api/admin/banners", {
      method: id ? "PUT" : "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    });
    const d = await r.json();
    if (!r.ok) { err.textContent = d.error || "Save failed"; return; }
    toast(id ? "Banner updated" : "Banner created", "success");
    await showList();
  } catch(e) { err.textContent = e.message; }
}

async function toggleBannerActive(id){
  const b = adminBanners.find(x => x.id === id);
  if (!b) return;
  try {
    const r = await fetch(`/api/admin/banners/${id}`, {
      method: "PUT",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ active: !b.active })
    });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Failed", "error"); return; }
    toast(b.active ? "Banner disabled" : "Banner enabled", "success");
    await loadBannerList();
  } catch(e) { toast(e.message, "error"); }
}

async function askDelBanner(id){
  const b = adminBanners.find(x => x.id === id);
  const preview = b ? (b.title || b.message || "").slice(0, 60) : "";
  if (!confirm(`Delete banner?\n\n"${preview}"\n\nThis cannot be undone.`)) return;
  try {
    const r = await fetch(`/api/admin/banners/${id}`, { method: "DELETE" });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Delete failed", "error"); return; }
    toast("Banner deleted", "success");
    await loadBannerList();
  } catch(e) { toast(e.message, "error"); }
}

// ── Import / Export ───────────────────────────────────────────────────────────
function exportServers() {
  const a = document.createElement("a");
  a.href = "/api/admin/export";
  a.download = "";
  a.click();
}
function triggerImport() { document.getElementById("importFileInput").click(); }
async function handleImportFile(input) {
  const file = input.files[0];
  if (!file) return;
  input.value = "";
  let data;
  try { data = JSON.parse(await file.text()); } catch(e) { toast("Invalid JSON file", "error"); return; }
  const servers = data.servers || (Array.isArray(data) ? data : null);
  if (!servers) { toast("No servers array found in file", "error"); return; }
  const mode = confirm(`Import ${servers.length} server(s)?\n\nOK = skip existing names\nCancel = overwrite existing`) ? "skip" : "overwrite";
  try {
    const r = await fetch("/api/admin/import", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ servers, mode }) });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Import failed", "error"); return; }
    const msg = `Imported ${d.added} server${d.added!==1?"s":""}, skipped ${d.skipped}${d.errors.length?" ("+d.errors.length+" errors)":""}`;
    toast(msg, d.errors.length ? "warn" : "success");
    cacheDel("admin-servers"); adminServers = [];
    await loadServerList();
  } catch(e) { toast(e.message, "error"); }
}

// ── API Keys ──────────────────────────────────────────────────────────────────
function renderApiKeyList(keys){
  const el = document.getElementById("adminPanelBody");
  _apiKeyStore = {};
  keys.forEach(key => { _apiKeyStore[key.id] = key; });
  const filtered = keys.filter(key => managementMatches(key, ["name","key_prefix","scope"]));
  document.getElementById("aCount").textContent = `${filtered.length} key${filtered.length===1?"":"s"}`;
  document.getElementById("managementDirectorySubtitle").textContent = `${filtered.length} of ${keys.length} credentials`;
  if (!filtered.length) {
    el.innerHTML = `<div class="empty-state">No API keys match this search.</div>`;
    syncManagementSelection("apikeys", filtered);
    return;
  }
  syncManagementSelection("apikeys", filtered);
  el.innerHTML = filtered.map(key => managementRowMarkup({ tab:"apikeys", id:key.id, title:key.name, meta:`${key.key_prefix || ""}…`, detail:key.last_used_at ? `Last used ${new Date(key.last_used_at).toLocaleString()}` : "Never used", badge:key.scope || "read", dot:key.scope === "write" ? "degraded" : "up" })).join("");
}

async function loadApiKeyList(generation = managementLoadGeneration) {
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("apikeys", generation)) return;
  el.innerHTML = `<div class="empty-state">Loading…</div>`;
  try {
    const r = await fetch("/api/admin/api-keys");
    if (!managementLoadIsCurrent("apikeys", generation)) return;
    if (!r.ok) {
      const d = await r.json().catch(()=>({}));
      if (managementLoadIsCurrent("apikeys", generation)) el.innerHTML = `<div class="empty-state">Failed to load: ${d.error || r.statusText}</div>`;
      return;
    }
    const keys = await r.json();
    if (!managementLoadIsCurrent("apikeys", generation)) return;
    renderApiKeyList(keys);
  } catch(e) {
    if (managementLoadIsCurrent("apikeys", generation)) el.innerHTML = `<div class="empty-state">Error: ${e.message}</div>`;
  }
}

function showApiKeyForm() {
  openAdminEditorDrawer("aApiKeyFormView", "Generate API key");
  document.getElementById("akName").value = "";
  document.getElementById("akScope").value = "read";
  document.getElementById("akErr").textContent = "";
  document.getElementById("akGeneratedKey").value = "";
  document.getElementById("akFormFields").hidden = false;
  document.getElementById("akResult").hidden = true;
  document.getElementById("akCancelBtn").hidden = false;
  document.getElementById("akCopyBtn").hidden = true;
  document.getElementById("akCreateBtn").hidden = false;
  document.getElementById("akDoneBtn").hidden = true;
  setTimeout(() => document.getElementById("akName")?.focus(), 40);
}

async function submitApiKeyForm() {
  const name = document.getElementById("akName").value.trim();
  const scope = document.getElementById("akScope").value;
  const error = document.getElementById("akErr");
  error.textContent = "";
  if (!name) { error.textContent = "Key name is required"; document.getElementById("akName").focus(); return; }
  const createButton = document.getElementById("akCreateBtn");
  createButton.disabled = true;
  createButton.textContent = "Generating…";
  try {
    const r = await fetch("/api/admin/api-keys", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({ name, scope }) });
    const d = await r.json();
    if (!r.ok) { error.textContent = d.error || "Failed to create key"; return; }
    document.getElementById("akGeneratedKey").value = d.key;
    document.getElementById("akFormFields").hidden = true;
    document.getElementById("akResult").hidden = false;
    document.getElementById("akCancelBtn").hidden = true;
    document.getElementById("akCopyBtn").hidden = false;
    document.getElementById("akCreateBtn").hidden = true;
    document.getElementById("akDoneBtn").hidden = false;
    document.getElementById("akGeneratedKey").focus();
    toast("API key generated", "success");
  } catch(e) {
    error.textContent = e.message;
  } finally {
    createButton.disabled = false;
    createButton.textContent = "Generate Key";
  }
}

async function copyGeneratedApiKey() {
  const field = document.getElementById("akGeneratedKey");
  if (!field.value) return;
  try {
    await navigator.clipboard.writeText(field.value);
    toast("API key copied", "success");
  } catch (_) {
    field.select();
    toast("Select and copy the key", "info");
  }
}

async function askDelApiKey(id) {
  const name = (_apiKeyStore && _apiKeyStore[id] && _apiKeyStore[id].name) || "this key";
  if (!confirm(`Revoke API key "${name}"?\n\nAny integrations using this key will immediately lose access.`)) return;
  try {
    const r = await fetch(`/api/admin/api-keys/${id}`, { method:"DELETE" });
    const d = await r.json();
    if (!r.ok) { toast(d.error || "Delete failed", "error"); return; }
    toast(`Key "${name}" revoked`, "success");
    await loadApiKeyList();
  } catch(e) { toast(e.message, "error"); }
}

