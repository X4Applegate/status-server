async function showUnifiSites(controllerId) {
  if (activeDrawer === "adminDrawer") closeAdmin();
  currentUnifiCtrl = adminUnifi.find(c => c.id === controllerId);
  if (!currentUnifiCtrl) { resetManagementDetail("Controller is no longer available."); return; }
  showManagementAux("aUnifiSitesView");
  document.getElementById("aFormView").style.display        = "none";
  document.getElementById("aUserFormView").style.display    = "none";
  document.getElementById("aWebhookFormView").style.display = "none";
  document.getElementById("aGroupFormView").style.display   = "none";
  document.getElementById("aOmadaSitesView").style.display  = "none";
  document.getElementById("aUnifiFormView").style.display   = "none";
  document.getElementById("aUnifiSitesView").style.display  = "flex";
  document.getElementById("ufSitesHeading").textContent = (currentUnifiCtrl ? currentUnifiCtrl.name + " - " : "") + "Sites";
  document.getElementById("ufSitesList").innerHTML = "<div>Loading...</div>";
  try {
    const r = await fetch(`/api/admin/unifi-controllers/${controllerId}/sites`);
