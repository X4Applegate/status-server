    } else if (ck.type === "tls_cert") {
      detail = `<input class="finput" type="number" placeholder="Port (default 443)" value="${_escHtml(ck.port||443)}" oninput="upCk(${i},'port',parseInt(this.value)||443)" style="max-width:140px">`
             + `<input class="finput" type="number" placeholder="Warn days threshold (default 14)" value="${_escHtml(ck.warn_days||14)}" oninput="upCk(${i},'warn_days',parseInt(this.value)||14)" style="max-width:280px">`
             + `<span class="crow-hint">🔒 Fails when cert expires in fewer than warn_days days.</span>`;
    } else if (ck.type === "script") {
      detail = `<div style="width:100%"><div style="display:flex;align-items:center;gap:6px;background:var(--orange-soft);border:1px solid rgba(255,140,42,.3);border-radius:6px;padding:5px 9px;margin-bottom:6px;font-size:11px;color:var(--orange)">⚠️ Script checks run commands on the monitor host. Admin only.</div>`
             + `<input class="finput" placeholder="Command  e.g. /opt/checks/my-check.sh" value="${_escHtml(ck.command||"")}" oninput="upCk(${i},'command',this.value)" style="font-family:var(--mono);font-size:11px">`
             + `<input class="finput" type="number" placeholder="Timeout ms (default 5000)" value="${_escHtml(ck.timeout||"")}" oninput="upCk(${i},'timeout',parseInt(this.value)||5000)" style="max-width:200px"></div>`;
    }
    return "<div class=\"crow\">"
      + "<select class=\"fselect\" onchange=\"changeCT(" + i + ",this.value)\">"
      + "<option value=\"ping\" " + sel("ping") + ">Ping (ICMP)</option>"
      + "<option value=\"tcp\" "  + sel("tcp")  + ">TCP Port</option>"
      + "<option value=\"udp\" "  + sel("udp")  + ">UDP Port</option>"
      + "<option value=\"http\" " + sel("http") + ">HTTP</option>"
      + "<option value=\"dns\" "  + sel("dns")  + ">DNS Record</option>"
      + "<option value=\"omada_gateway\" " + sel("omada_gateway") + ">Omada Gateway</option>"
      + "<option value=\"omada_lte\" "     + sel("omada_lte")     + ">Omada LTE / Cellular</option>"
      + "<option value=\"omada_device\" "  + sel("omada_device")  + ">Omada AP / Switch</option>"
      + "<option value=\"unifi_gateway\" " + sel("unifi_gateway") + ">UniFi Gateway</option>"
