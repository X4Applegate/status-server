function onPublicToggle(){
  const enabled = document.getElementById("gPublicEnabled").checked;
  const urlEl   = document.getElementById("gPublicUrl");
  const slug    = document.getElementById("gSlug").value.trim();
  if (enabled && slug) {
    urlEl.textContent = `Public URL: ${location.origin}/status/${slug}`;
    urlEl.style.display = "";
  } else {
    urlEl.style.display = "none";
  }
}

function askDelGroup(id, name){
  pendDelGroup = id;
  document.getElementById("confirmMsg").textContent = `Group "${name}" will be removed. Servers in it will become ungrouped.`;
  openModalLayer("confirmDlg");
  document.querySelector("#confirmDlg .btn-danger").onclick = doDeleteGroup;
}

async function doDeleteGroup(){
  if (!pendDelGroup) return;
  try {
    const r = await fetch(`/api/admin/groups/${pendDelGroup}`, {method:"DELETE"});
    const d = await r.json();
    if (r.ok) { cacheDel("admin-groups"); cacheDel("admin-servers"); }
    toast(r.ok ? "Group removed" : (d.error||"Failed"), r.ok ? "info" : "error");
  } catch(e) { toast("Error: " + e.message, "error"); }
  pendDelGroup = null;
  closeConfirm();
  loadGroupList();
}


// -- UniFi Controllers -------------------------------------------------------
let adminUnifi = [];
let unifiSitesCache = {};
let currentUnifiCtrl = null;

async function ensureUnifiLoaded() {
  if (adminUnifi.length) return;
  const cached = cacheGet("admin-unifi");
  if (cached) { adminUnifi = cached; return; }
  try {
    const response = await fetch("/api/admin/unifi-controllers");
    if (response.ok) {
      adminUnifi = await response.json();
      cacheSet("admin-unifi", adminUnifi);
    }
  } catch (_) {}
}

async function loadUnifiList(generation = managementLoadGeneration) {
  const el = document.getElementById("adminPanelBody");
  if (!managementLoadIsCurrent("unifi", generation)) return;
  const cached = cacheGet("admin-unifi");
  if (cached) { adminUnifi = cached; renderUnifiList(adminUnifi); }
  else el.innerHTML = '<div style="padding:24px;text-align:center;color:var(--text-2)">Loading controllers...</div>';
  try {
    const r = await fetch("/api/admin/unifi-controllers");
    if (!managementLoadIsCurrent("unifi", generation)) return;
    if (r.status === 401) { window.location.href = "/"; return; }
    if (!r.ok) { if (!cached) el.innerHTML = '<div class="empty-state">Error ' + r.status + '</div>'; return; }
    adminUnifi = await r.json();
    if (!managementLoadIsCurrent("unifi", generation)) return;
    cacheSet("admin-unifi", adminUnifi);
    renderUnifiList(adminUnifi);
  } catch(e) {
    if (managementLoadIsCurrent("unifi", generation) && !cached) el.innerHTML = '<div class="empty-state">Failed to load: ' + e.message + '</div>';
  }
}

function renderUnifiList(list) {
  const el = document.getElementById("adminPanelBody");
  const filtered = list.filter(controller => managementMatches(controller, ["name","base_url","username","last_error"]));
  document.getElementById("aCount").textContent = filtered.length + ' controller' + (filtered.length===1?'':'s');
  document.getElementById("managementDirectorySubtitle").textContent = `${filtered.length} of ${list.length} accessible`;
  if (!filtered.length) {
    el.innerHTML = '<div class="empty-state">No UniFi controllers yet.<br>Click <strong>Add Controller</strong> to register one.</div>';
    syncManagementSelection("unifi", filtered);
    return;
  }
  syncManagementSelection("unifi", filtered);
  el.innerHTML = filtered.map(controller => managementRowMarkup({ tab:"unifi", id:controller.id, title:controller.name, meta:controller.base_url, detail:controller.last_error || `${(controller.group_ids || []).length || "Global"} access scope`, badge:controller.last_error ? "Attention" : "Connected", dot:controller.last_error ? "down" : "up" })).join("");
}

async function showUnifiForm(c) {
  if (!isAdmin() && c?.shared_outside_scope) {
    toast("Only an admin can edit a controller shared with other status pages", "error");
    return;
  }
  openAdminEditorDrawer("aUnifiFormView", c ? "Edit UniFi controller" : "Add UniFi controller");
  document.getElementById("aFormView").style.display        = "none";
