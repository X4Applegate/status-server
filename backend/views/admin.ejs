// ── Server detail (cached, stale-while-revalidate) ───────────────────────────
let serviceDetailRequest = 0;
async function selectServer(id){
  const server = liveServers.find(s => String(s.id) === String(id));
  if (!server) return;
  const requestId = ++serviceDetailRequest;
  selectedServerId = server.id;
  cacheSet("selected-id", server.id);

  // Mark active row in sidebar
  document.querySelectorAll("#sidebarList .srv-row").forEach(row => {
    const active = String(row.dataset.serviceId) === String(server.id);
    row.classList.toggle("active", active);
    if (active) row.setAttribute("aria-current", "true");
    else row.removeAttribute("aria-current");
  });

  // 1) Render from cache instantly
  const cached = cacheGet("detail-" + server.id);
  if (cached) renderDetail(server, cached.uptime, cached.heartbeat, cached.incidents, cached.responseSeries);
  else        renderDetailSkeleton(server);

  // 2) Fetch fresh in parallel
  const encodedId = encodeURIComponent(server.id);
  const fetchDetail = async (path, fallback) => {
    try {
      const response = await fetch(`/api/public/${path}/${encodedId}`);
      if (!response.ok) throw new Error(`${path} request failed (${response.status})`);
      return await response.json();
    } catch (_) {
      return fallback;
    }
  };
  const stale = cached || { uptime:{}, heartbeat:[], incidents:[], responseSeries:[] };
  const [uptime, heartbeat, incidents, responseSeries] = await Promise.all([
    fetchDetail("uptime", stale.uptime || {}),
    fetchDetail("heartbeat", Array.isArray(stale.heartbeat) ? stale.heartbeat : []),
    fetchDetail("incidents", Array.isArray(stale.incidents) ? stale.incidents : []),
    fetchDetail("response", Array.isArray(stale.responseSeries) ? stale.responseSeries : []),
  ]);
  if (requestId !== serviceDetailRequest || String(selectedServerId) !== String(server.id)) return;
  const currentServer = liveServers.find(item => String(item.id) === String(server.id));
  if (!currentServer) return;
  renderDetail(currentServer, uptime, heartbeat, incidents, responseSeries);
  cacheSet("detail-" + currentServer.id, { uptime, heartbeat, incidents, responseSeries });
}

function renderDetailSkeleton(s){
  document.getElementById("mainArea").innerHTML = `
    <div class="detail-header">
      <div>
        <div class="detail-name">${_escHtml(s.name)}</div>
        <div class="detail-host">${_escHtml(s.host)}</div>
      </div>
    </div>
    <div class="uptime-row">
      ${["24h","7d","30d"].map(l=>`<div class="uptime-card"><div class="uptime-label">${l}</div><div class="dv-skeleton" style="height:32px;width:80px;margin:0 auto"></div></div>`).join("")}
    </div>
    <div class="dv-section"><div class="dv-section-head"><div class="dv-section-title">Heartbeat</div></div><div class="dv-section-body"><div class="dv-skeleton" style="height:28px"></div></div></div>
    <div class="dv-section"><div class="dv-section-head"><div class="dv-section-title">Response Time</div></div><div class="dv-section-body"><div class="dv-skeleton" style="height:120px"></div></div></div>
  `;
}

function renderDetail(s, uptime, heartbeat, incidents, responseSeries){
  uptime    = uptime    || {};
  heartbeat = Array.isArray(heartbeat) ? heartbeat : [];
  incidents = Array.isArray(incidents) ? incidents : [];
  responseSeries = Array.isArray(responseSeries) ? responseSeries : [];
  const statusLabel = s.overall==="up"?"Online":s.overall==="down"?"Offline":s.overall==="degraded"?"Degraded":"Pending";
  const tags = (s.tags||[]).map(t=>`<span class="detail-tag">${_escHtml(t)}</span>`).join("");

  const uptimeCards = [
    {label:"Last 24h", val:uptime.h24},
    {label:"Last 7 days", val:uptime.d7},
    {label:"Last 30 days", val:uptime.d30}
  ].map(u => `
    <div class="uptime-card">
      <div class="uptime-label">${u.label}</div>
      <div class="uptime-pct">${u.val !== null && u.val !== undefined ? u.val+"%" : "—"}</div>
      <div class="uptime-sub">${u.val !== null && u.val !== undefined ? "Observed availability" : "No data yet"}</div>
    </div>`).join("");

  const hbPad  = Math.max(0, 180 - heartbeat.length);
  const hbDots = [
    ...Array(hbPad).fill(null).map(() => `<div class="hb-dot pending"></div>`),
    ...heartbeat.map(h => {
      const status = h.ok ? "Up" : "Down";
      const ms = h.response_ms ? ` · ${h.response_ms}ms` : "";
      return `<div class="hb-dot ${h.ok?"up":"down"}" data-time="${_escHtml(fmtTimeFull(h.checked_at))}" data-status="${_escHtml(status+ms)}" onmouseenter="showHbTip(this)" onmouseleave="hideHbTip(this)"></div>`;
    })
  ].join("");

  const checkChips = (s.checks||[]).map(c => {
    const lbl     = c.type==="ping"?"Ping":c.type==="tcp"?`TCP :${c.port}`:c.type==="udp"?`UDP :${c.port}`:"HTTP";
    const chipCls = c.ok ? "ok" : "fail";
    return `<div class="dv-chip ${chipCls}">
      <div class="dv-chip-dot"></div>
      <span class="dv-chip-label">${_escHtml(lbl)}</span>
      <span class="dv-chip-detail">${_escHtml(c.detail||"")}</span>
    </div>`;
  }).join("");

  const incidentRows = incidents.length === 0
    ? `<div class="no-incidents">No incidents recorded</div>`
    : incidents.map(i => `
      <div class="incident-row">
        <div class="incident-dot ${i.ended_at?"resolved":""}"></div>
        <div>
          <div class="incident-cause">${_escHtml(i.cause||"Service unavailable")}</div>
          <div class="incident-time">${_escHtml(fmtTime(i.started_at))}${i.ended_at?" → "+_escHtml(fmtTime(i.ended_at)):""}</div>
        </div>
